{{ 'section-category-subnav.css' | asset_url | stylesheet_tag }}

{%- assign subnav_menu = section.settings.category_menu -%}

{%- if subnav_menu != blank and subnav_menu.links.size > 0 -%}

  <style>
    {%- if section.settings.hide_on_mobile -%}
      @media screen and (max-width: 989px) {
        #shopify-section-{{ section.id }},
        .category-subnav {
          display: none !important;
        }
      }
    {%- else -%}
      /* Estilos adaptativos móviles si se decide mostrar */
      @media screen and (max-width: 989px) {
        .category-subnav__bar {
          overflow-x: auto;
          white-space: nowrap;
          -webkit-overflow-scrolling: touch;
          padding-bottom: 5px;
        }
        .category-megamenu {
          position: fixed !important;
          top: 0 !important;
          left: 0 !important;
          width: 100vw !important;
          height: 100vh !important;
          background: #fff;
          z-index: 9999;
          overflow-y: auto;
          padding: 2rem 1rem;
        }
      }
    {%- endif -%}
  </style>

  <nav class="category-subnav" aria-label="{{ 'general.category_navigation' | t }}" data-open-delay="{{ section.settings.hover_open_delay | default: 800 }}" data-close-delay="{{ section.settings.hover_close_delay | default: 250 }}">
    <div class="page-width">
      <ul class="category-subnav__bar">
        {%- for link in subnav_menu.links -%}
          {%- assign nav_parent_handle = link.title | handleize -%}
          {%- assign link_coll_handle = link.object.handle -%}
          
          {%- comment -%} VERIFICACIÓN REAL DE CONTENIDO (BLOQUES O SUBCATEGORÍAS) {%- endcomment -%}
          {%- assign has_valid_content = false -%}

          {%- if link.links.size > 0 -%}
            {%- assign has_valid_content = true -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- assign block_parent_handle = block.settings.parent_category | handleize -%}
              {%- assign block_coll_handle = block.settings.collection.handle -%}
              {%- if block_parent_handle == nav_parent_handle or block_coll_handle == nav_parent_handle or block_coll_handle == link_coll_handle -%}
                {%- assign has_valid_content = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- assign has_dropdown = false -%}
          {%- if has_valid_content -%}
            {%- assign has_dropdown = true -%}
          {%- endif -%}

          {%- assign is_active = false -%}
          {%- if link.active or collection.url == link.url -%}
            {%- assign is_active = true -%}
          {%- endif -%}

          <li class="category-subnav__bar-item{% if has_dropdown %} has-megamenu{% endif %}">
            <a href="{{ link.url }}" class="category-subnav__bar-link{% if is_active %} is-active{% endif %}" {% if has_dropdown %}aria-expanded="false" aria-controls="MegaMenu-{{ section.id }}-{{ forloop.index }}"{% endif %}>
              <span>{% if link.title == 'Toutes les collections' %}{{ 'products.all_collections' | t }}{% else %}{{ link.title | escape }}{% endif %}</span>
              {%- if has_dropdown -%}
                <svg class="category-subnav__bar-chevron" width="8" height="5" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
            </a>

            {%- if has_dropdown -%}
              <div class="category-megamenu" id="MegaMenu-{{ section.id }}-{{ forloop.index }}">
                <div class="category-megamenu__container page-width">
                  
                  {%- if link.links.size > 0 -%}
                    {%- comment -%} CASO 1: TIENE SUBCATEGORÍAS EN SIDEBAR {%- endcomment -%}
                    <div class="category-megamenu__sidebar">
                      <ul class="category-megamenu__sidebar-list">
                        {%- for childlink in link.links -%}
                          <li 
                            class="category-megamenu__sidebar-item{% if forloop.first %} is-selected{% endif %}" 
                            data-target-tab="tab-{{ forloop.index }}-{{ nav_parent_handle }}"
                          >
                            <a href="{{ childlink.url }}" class="category-megamenu__sidebar-link">
                              <span>{{ childlink.title }}</span>
                              <svg class="category-megamenu__sidebar-arrow" width="6" height="10" viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M1 1L5 5L1 9" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>

                    <div class="category-megamenu__content">
                      {%- for childlink in link.links -%}
                        {%- assign child_handle = childlink.title | handleize -%}
                        {%- assign child_coll_handle = childlink.object.handle -%}

                        <div 
                          class="category-megamenu__tab-panel{% if forloop.first %} is-active{% endif %}" 
                          id="tab-{{ forloop.index }}-{{ nav_parent_handle }}"
                        >
                          <div class="category-megamenu__grid">
                            {%- for block in section.blocks -%}
                              {%- assign block_parent_handle = block.settings.parent_category | handleize -%}
                              {%- assign block_sub_handle = block.settings.sub_category | handleize -%}
                              {%- assign block_coll_handle = block.settings.collection.handle -%}

                              {%- assign is_parent_match = false -%}
                              {%- if block_parent_handle == nav_parent_handle or block.settings.parent_category == blank -%}
                                {%- assign is_parent_match = true -%}
                              {%- endif -%}

                              {%- assign is_sub_match = false -%}
                              {%- if block_sub_handle == child_handle 
                                  or block_coll_handle == child_handle 
                                  or block_coll_handle == child_coll_handle 
                                  or block.settings.sub_category == blank -%}
                                {%- assign is_sub_match = true -%}
                              {%- endif -%}

                              {%- if is_parent_match and is_sub_match -%}
                                {%- case block.type -%}
                                  {%- when 'auto_collection' -%}
                                    {%- assign target_coll = block.settings.collection | default: childlink.object -%}
                                    {%- assign limit_count = block.settings.products_to_show -%}
                                    {%- if target_coll != blank and target_coll.products.size > 0 -%}
                                      {%- for prod in target_coll.products limit: limit_count -%}
                                        <a href="{{ prod.url }}" class="category-megamenu__card" {{ block.shopify_attributes }}>
                                          <div class="category-megamenu__card-image">
                                            {%- if prod.featured_image != blank -%}
                                              <img src="{{ prod.featured_image | image_url: width: 400 }}" alt="{{ prod.title | escape }}" loading="lazy" width="200" height="200">
                                            {%- else -%}
                                              <div class="category-megamenu__card-placeholder"></div>
                                            {%- endif -%}
                                          </div>
                                          <span class="category-megamenu__card-title">{{ prod.title }}</span>
                                        </a>
                                      {%- endfor -%}
                                    {%- endif -%}

                                  {%- when 'custom_card' -%}
                                    {%- assign selected_product = block.settings.product -%}
                                    {%- assign selected_collection = block.settings.collection -%}

                                    {%- assign final_url = selected_product.url | default: selected_collection.url | default: block.settings.custom_url -%}
                                    {%- assign final_title = block.settings.custom_title | default: selected_product.title | default: selected_collection.title -%}
                                    {%- assign final_image = block.settings.custom_image | default: selected_product.featured_image | default: selected_collection.featured_image -%}

                                    {%- if final_title != blank -%}
                                      <a href="{{ final_url | default: '#' }}" class="category-megamenu__card custom-promo-card" {{ block.shopify_attributes }}>
                                        <div class="category-megamenu__card-image">
                                          {%- if final_image != blank -%}
                                            <img src="{{ final_image | image_url: width: 400 }}" alt="{{ final_title | escape }}" loading="lazy" width="200" height="200">
                                          {%- else -%}
                                            <div class="category-megamenu__card-placeholder"></div>
                                          {%- endif -%}
                                          {%- if block.settings.badge_text != blank -%}
                                            <span class="custom-promo-badge">{{ block.settings.badge_text }}</span>
                                          {%- endif -%}
                                        </div>
                                        <span class="category-megamenu__card-title">{{ final_title }}</span>
                                      </a>
                                    {%- endif -%}
                                {%- endcase -%}
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>

                  {%- else -%}
                    {%- comment -%} CASO 2: NO TIENE SUBCATEGORÍAS {%- endcomment -%}
                    <div class="category-megamenu__content full-width-content">
                      <div class="category-megamenu__tab-panel is-active">
                        <div class="category-megamenu__grid">
                          {%- for block in section.blocks -%}
                            {%- assign block_parent_handle = block.settings.parent_category | handleize -%}
                            {%- assign block_coll_handle = block.settings.collection.handle -%}

                            {%- assign is_match = false -%}
                            {%- if block_parent_handle == nav_parent_handle 
                                or block_coll_handle == nav_parent_handle 
                                or block_coll_handle == link_coll_handle -%}
                              {%- assign is_match = true -%}
                            {%- endif -%}

                            {%- if is_match -%}
                              {%- case block.type -%}
                                {%- when 'auto_collection' -%}
                                  {%- assign target_coll = block.settings.collection | default: link.object -%}
                                  {%- assign limit_count = block.settings.products_to_show -%}
                                  {%- if target_coll != blank and target_coll.products.size > 0 -%}
                                    {%- for prod in target_coll.products limit: limit_count -%}
                                      <a href="{{ prod.url }}" class="category-megamenu__card" {{ block.shopify_attributes }}>
                                        <div class="category-megamenu__card-image">
                                          {%- if prod.featured_image != blank -%}
                                            <img src="{{ prod.featured_image | image_url: width: 400 }}" alt="{{ prod.title | escape }}" loading="lazy" width="200" height="200">
                                          {%- else -%}
                                            <div class="category-megamenu__card-placeholder"></div>
                                          {%- endif -%}
                                        </div>
                                        <span class="category-megamenu__card-title">{{ prod.title }}</span>
                                      </a>
                                    {%- endfor -%}
                                  {%- endif -%}

                                {%- when 'custom_card' -%}
                                  {%- assign selected_product = block.settings.product -%}
                                  {%- assign selected_collection = block.settings.collection -%}

                                  {%- assign final_url = selected_product.url | default: selected_collection.url | default: block.settings.custom_url -%}
                                  {%- assign final_title = block.settings.custom_title | default: selected_product.title | default: selected_collection.title -%}
                                  {%- assign final_image = block.settings.custom_image | default: selected_product.featured_image | default: selected_collection.featured_image -%}

                                  {%- if final_title != blank -%}
                                    <a href="{{ final_url | default: '#' }}" class="category-megamenu__card custom-promo-card" {{ block.shopify_attributes }}>
                                      <div class="category-megamenu__card-image">
                                        {%- if final_image != blank -%}
                                          <img src="{{ final_image | image_url: width: 400 }}" alt="{{ final_title | escape }}" loading="lazy" width="200" height="200">
                                        {%- else -%}
                                          <div class="category-megamenu__card-placeholder"></div>
                                        {%- endif -%}
                                        {%- if block.settings.badge_text != blank -%}
                                          <span class="custom-promo-badge">{{ block.settings.badge_text }}</span>
                                        {%- endif -%}
                                      </div>
                                      <span class="category-megamenu__card-title">{{ final_title }}</span>
                                    </a>
                                  {%- endif -%}
                              {%- endcase -%}
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}

                </div>
              </div>
            {%- endif -%}

          </li>
        {%- endfor -%}
      </ul>
    </div>
  </nav>
{%- endif -%}

<script>
  (() => {
    function initializeMenus() {
      document.querySelectorAll('.category-subnav').forEach(nav => {
        if (nav.dataset.hoverIntentReady) return;
        const desktop = window.matchMedia('(min-width: 990px)');
        const items = [...nav.querySelectorAll('.category-subnav__bar-item.has-megamenu')];
        const delay = (value, fallback) => value !== undefined && Number.isFinite(Number(value)) ? Math.max(0, Number(value)) : fallback;
        const openDelay = delay(nav.dataset.openDelay, 800);
        const closeDelay = delay(nav.dataset.closeDelay, 250);
        let openTimer, closeTimer, hoveredItem;
        const cancelOpen = () => { clearTimeout(openTimer); openTimer = null; };
        const cancelClose = () => { clearTimeout(closeTimer); closeTimer = null; };
        const triggerFor = item => item.querySelector('.category-subnav__bar-link');
        const close = item => {
          item.classList.remove('is-desktop-open');
          triggerFor(item).setAttribute('aria-expanded', 'false');
        };
        const closeAll = () => { cancelOpen(); cancelClose(); items.forEach(close); };
        const open = item => {
          if (!desktop.matches) return;
          cancelOpen(); cancelClose();
          items.forEach(other => { if (other !== item) close(other); });
          item.classList.add('is-desktop-open');
          triggerFor(item).setAttribute('aria-expanded', 'true');
        };
        items.forEach(item => {
          const trigger = triggerFor(item);
          item.addEventListener('mouseenter', () => {
            if (!desktop.matches) return;
            hoveredItem = item;
            cancelOpen(); cancelClose();
            if (!item.classList.contains('is-desktop-open')) {
              openTimer = setTimeout(() => { if (hoveredItem === item) open(item); }, openDelay);
            }
          });
          item.addEventListener('mouseleave', () => {
            if (!desktop.matches) return;
            hoveredItem = null;
            cancelOpen(); cancelClose();
            closeTimer = setTimeout(() => {
              items.forEach(other => { if (!other.contains(document.activeElement)) close(other); });
            }, closeDelay);
          });
          item.addEventListener('focusin', () => open(item));
          item.addEventListener('focusout', event => {
            if (desktop.matches && !item.contains(event.relatedTarget)) { cancelOpen(); cancelClose(); close(item); }
          });
          trigger.addEventListener('keydown', event => {
            if (!desktop.matches || event.key !== 'ArrowDown') return;
            event.preventDefault();
            open(item);
            item.querySelector('.category-megamenu a[href]')?.focus();
          });
          // Keep the optional mobile subnav's existing first-tap behavior.
          trigger.addEventListener('click', event => {
            if (!desktop.matches && !item.classList.contains('is-mobile-open')) {
              event.preventDefault();
              items.forEach(other => other.classList.remove('is-mobile-open'));
              item.classList.add('is-mobile-open');
            }
          });
        });
        nav.querySelectorAll('.category-megamenu__sidebar-item').forEach(item => {
          const selectPreview = () => {
            const sidebar = item.closest('.category-megamenu__sidebar');
            const content = item.closest('.category-megamenu').querySelector('.category-megamenu__content');
            const target = content?.querySelector('#' + item.dataset.targetTab);
            if (!sidebar || !content || !target || !content.contains(target)) return;
            sidebar.querySelectorAll('.category-megamenu__sidebar-item').forEach(other => other.classList.toggle('is-selected', other === item));
            content.querySelectorAll('.category-megamenu__tab-panel').forEach(panel => panel.classList.toggle('is-active', panel === target));
          };
          item.addEventListener('mouseenter', selectPreview);
          item.addEventListener('focusin', () => { if (desktop.matches) selectPreview(); });
          item.addEventListener('click', event => {
            // Desktop anchors retain native navigation, including modified clicks.
            if (!desktop.matches) event.preventDefault();
            selectPreview();
          });
        });
        nav.addEventListener('keydown', event => {
          if (!desktop.matches || event.key !== 'Escape') return;
          const item = event.target.closest('.has-megamenu');
          if (!item || (!item.classList.contains('is-desktop-open') && !openTimer)) return;
          event.preventDefault(); event.stopPropagation();
          triggerFor(item).focus({ preventScroll: true });
          hoveredItem = null;
          closeAll();
        });
        desktop.addEventListener('change', () => { hoveredItem = null; closeAll(); });
        nav.dataset.hoverIntentReady = 'true';
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeMenus);
    else initializeMenus();
    document.addEventListener('shopify:section:load', initializeMenus);
  })();
</script>

{% schema %}
{
  "name": "Category Subnav Bar",
  "tag": "section",
  "class": "section-category-subnav",
  "settings": [
    {
      "type": "range",
      "id": "hover_open_delay",
      "label": "Desktop hover opening delay",
      "min": 0, "max": 1500, "step": 50, "unit": "ms", "default": 800
    },
    {
      "type": "range",
      "id": "hover_close_delay",
      "label": "Desktop hover closing delay",
      "min": 0, "max": 1000, "step": 50, "unit": "ms", "default": 250
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Select Navigation Menu"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on Mobile & Tablet",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "auto_collection",
      "name": "⚡ Auto-Show Collection",
      "settings": [
        {
          "type": "text",
          "id": "parent_category",
          "label": "1. Parent Category Title",
          "info": "Match main menu item (e.g., Stools, Trolleys, Skincare Equipment)"
        },
        {
          "type": "text",
          "id": "sub_category",
          "label": "2. Subcategory Title",
          "info": "Match sidebar item (e.g., Facial Units). Leave empty for single categories like Stools"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection to Display"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 2,
          "max": 16,
          "step": 1,
          "label": "Number of Products to Show",
          "default": 6
        }
      ]
    },
    {
      "type": "custom_card",
      "name": "📌 Specific Product / Card",
      "settings": [
        {
          "type": "text",
          "id": "parent_category",
          "label": "1. Parent Category Title",
          "info": "Match main menu item (e.g., Stools, Trolleys)"
        },
        {
          "type": "text",
          "id": "sub_category",
          "label": "2. Subcategory Title",
          "info": "Match sidebar item if applicable"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Pick Product"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Or Pick Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title Override"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image Override"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge (e.g. Best Seller, New)"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Subnav Bar"
    }
  ]
}
{% endschema %}