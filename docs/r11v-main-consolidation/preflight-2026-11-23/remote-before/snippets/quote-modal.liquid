{% comment %}
  Snippet: snippets/quote-modal.liquid
  Dynamic B2B Quote Request Modal for Equipro Beauty
{% endcomment %}

{{ 'quote-modal.css' | asset_url | stylesheet_tag }}

<div id="QuoteModal" class="quote-modal" aria-hidden="true" role="dialog" aria-labelledby="QuoteModalTitle">
  <div class="quote-modal__overlay" data-close-quote-modal></div>
  <div class="quote-modal__content">
    <button type="button" class="quote-modal__close" data-close-quote-modal aria-label="{{ 'quote.close' | t }}">&times;</button>
    
    <div class="quote-modal__header">
      <h3 id="QuoteModalTitle" class="quote-modal__title">{{ 'quote.title' | t }}</h3>
      <p class="quote-modal__subtitle">{{ 'quote.intro' | t }}</p>
    </div>

    {% form 'contact', id: 'QuoteForm', class: 'quote-modal__form' %}
      {% if form.posted_successfully? %}
        <div class="quote-modal__success">
          {{ 'quote.success' | t }}
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="quote-modal__error">
          {{ 'quote.error' | t }}
        </div>
      {% endif %}

      <!-- Hidden inputs populated dynamically via JS -->
      <input type="hidden" id="QuoteProductTitle" name="contact[Requested_Product]" value="{{ product.title }}">
      <input type="hidden" id="QuoteProductVariant" name="contact[Variant]" value="{{ product.selected_or_first_available_variant.title }}">
      <input type="hidden" id="QuoteProductSKU" name="contact[SKU]" value="{{ product.selected_or_first_available_variant.sku }}">

      <!-- Visible product context -->
      <div class="quote-modal__product-preview">
        <span class="quote-modal__product-label">{{ 'quote.product' | t }}:</span>
        <strong id="QuoteProductDisplay">{{ product.title | default: 'quote.general_product' | t }}</strong>
      </div>

      <div class="quote-modal__grid">
        <div class="quote-modal__field">
          <label for="QuoteName">{{ 'quote.full_name' | t }}</label>
          <input type="text" id="QuoteName" name="contact[Name]" required placeholder="{{ 'quote.full_name_placeholder' | t }}">
        </div>

        <div class="quote-modal__field">
          <label for="QuoteCompany">{{ 'quote.company' | t }}</label>
          <input type="text" id="QuoteCompany" name="contact[Company]" required placeholder="{{ 'quote.company_placeholder' | t }}">
        </div>
      </div>

      <div class="quote-modal__grid">
        <div class="quote-modal__field">
          <label for="QuoteEmail">{{ 'quote.email' | t }}</label>
          <input type="email" id="QuoteEmail" name="contact[email]" required placeholder="{{ 'quote.email_placeholder' | t }}">
        </div>

        <div class="quote-modal__field">
          <label for="QuotePhone">{{ 'quote.phone' | t }}</label>
          <input type="tel" id="QuotePhone" name="contact[Phone]" required placeholder="{{ 'quote.phone_placeholder' | t }}">
        </div>
      </div>

      <div class="quote-modal__field">
        <label for="QuoteQuantity">{{ 'quote.quantity' | t }}</label>
        <input type="number" id="QuoteQuantity" name="contact[Quantity]" min="1" value="1">
      </div>

      <div class="quote-modal__field">
        <label for="QuoteMessage">{{ 'quote.message' | t }}</label>
        <textarea id="QuoteMessage" name="contact[body]" rows="3" placeholder="{{ 'quote.message_placeholder' | t }}"></textarea>
      </div>

      <button type="submit" class="quote-modal__submit button button--primary">{{ 'quote.submit' | t }}</button>
    {% endform %}
  </div>
</div>
