+{% schema %}
+{
+  "name": "Complete Your Setup",
+  "enabled_on": { "templates": ["product"] },
+  "settings": [
+    { "type": "text", "id": "select_label", "label": "Selection prompt", "default": "Select an option" },
+    { "type": "text", "id": "instock_label", "label": "Available label", "default": "Available" },
+    { "type": "text", "id": "soldout_label", "label": "Unavailable label", "default": "Unavailable" },
+    { "type": "text", "id": "details_label", "label": "Special purchase label", "default": "View product for purchase details" },
+    { "type": "text", "id": "suggestion_label", "label": "Color suggestion label", "default": "Suggested color — review before adding:" },
+    { "type": "text", "id": "accepted_label", "label": "Unconfirmed display label", "default": "Added to cart. Refresh the cart display before adding again." },
+    { "type": "text", "id": "refresh_label", "label": "Refresh cart label", "default": "Refresh cart" },
+    { "type": "text", "id": "quick_add_label", "label": "Quick add label", "default": "Add to cart" },
+    { "type": "text", "id": "options_label", "label": "Options link label", "default": "Choose options" },
+    { "type": "text", "id": "quote_label", "label": "Quote link label", "default": "View quote details" },
+    { "type": "text", "id": "unavailable_label", "label": "Unavailable link label", "default": "View availability" },
+    { "type": "text", "id": "added_label", "label": "Added label", "default": "Added! ✓" },
+    { "type": "text", "id": "metafield_namespace", "label": "Metafield namespace", "default": "custom" },
+    { "type": "text", "id": "metafield_key", "label": "Metafield key", "default": "complete_your_setup", "info": "Use an existing product metafield of type list.product_reference. Displays up to three products." }
+  ],
