    "faq": {
      "type": "category-faq",
      "blocks": {
        "faq_item_gaEA6M": {
          "type": "faq_item",
          "settings": {
            "question": "What are the main benefits of a saddle stool compared to a round stool?",
            "answer": "<p>The saddle-style seat naturally forces your pelvis into an upright posture, keeping your spine aligned in a neutral position. This opens up the hip angle, reduces tension in the lower back, and improves blood circulation during long hours of continuous seating.</p>"
          }
        },
        "faq_item_JkpEmj": {
          "type": "faq_item",
          "settings": {
            "question": "Can the backrest height and tilt angle be adjusted independently?",
            "answer": "<p>Yes. On our stools equipped with backrests, you can fully adjust both the height and the tilt tension to match your body frame, providing targeted lumbar support exactly where you need it most.</p>"
          }
        },
        "faq_item_r7tr7G": {
          "type": "faq_item",
          "settings": {
            "question": "Are the caster wheels safe for hardwood floors?",
            "answer": "<p>Absolutely. Our rolling bases feature high-grade, smooth-rolling casters that are specifically designed to glide flawlessly across hard studio flooring, commercial tiles, and thin laminate without leaving marks or scuffs.</p>"
          }
        },
        "faq_item_dd9n3Q": {
          "type": "faq_item",
          "settings": {
            "question": "What is the maximum height range and weight capacity?",
            "answer": "<p>Equipro professional stools support up to 300 lbs (136 kg) with exceptional structural integrity. Height adjustment ranges vary by model but are engineered to perfectly fit standard treatment tables and low-profile setups alike.</p>"
          }
        },
        "faq_item_8YiyhY": {
          "type": "faq_item",
          "settings": {
            "question": "How do I clean and care for the stool's upholstery?",
            "answer": "<p>The premium vinyl covering is non-porous and incredibly durable. For daily cleaning, simply wipe it down with a damp cloth and mild antibacterial, non-alcohol soap solution or professional salon-grade disinfectant wipes between client shifts.</p>"
          }
        }
      },
