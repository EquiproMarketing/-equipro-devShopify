        "faq_item_r7tr7G": {
          "type": "faq_item",
          "settings": {
            "question": "Does the stool come with a backrest?",
            "answer": "<p><strong>Both backless and backrest models are available.</strong> Model 31100/EI-311 is backless, while 31200/EI-312 includes an adjustable backrest.</p>"
