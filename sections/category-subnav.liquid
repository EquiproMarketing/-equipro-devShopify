{{ 'section-category-subnav.css' | asset_url | stylesheet_tag }}

{% assign subnav_menu = section.settings.category_menu %}

{% if subnav_menu != blank and subnav_menu.links.size > 0 %}
  <nav class="category-subnav">
    <div class="page-width">
      <ul class="category-subnav__list">
        {% for link in subnav_menu.links %}
          <li>
            <a href="{{ link.url }}" class="category-subnav__link {% if link.active %}is-active{% endif %}">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </nav>
{% endif %}

{% schema %}
{
  "name": "Category Subnav",
  "settings": [
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category Menu Source",
      "info": "Select the menu containing your product categories (e.g. Trolleys, Steamers)."
    }
  ],
  "presets": [
    {
      "name": "Category Subnav"
    }
  ]
}
{% endschema %}