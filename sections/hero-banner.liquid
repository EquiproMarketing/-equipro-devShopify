{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

<div class="hero-banner-wrapper hero-banner-wrapper--{{ section.settings.banner_height }}" id="HeroBanner-{{ section.id }}">
  <div class="hero-banner">
    
    <div class="hero-banner__slides">
      {% for block in section.blocks %}
        <div 
          class="hero-banner__slide{% if forloop.first %} is-active{% endif %}" 
          data-slide-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <img 
              src="{{ block.settings.image | image_url: width: 2000 }}" 
              alt="{{ block.settings.heading | escape }}"
              loading="eager"
              width="2000"
              height="1000"
              class="hero-banner__image position-{{ block.settings.image_position | default: 'center' }}"
            >
          {% else %}
            <div class="hero-banner__placeholder"></div>
          {% endif %}

          <div class="hero-banner__overlay" style="background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});">
            <div class="hero-banner__container page-width">
              <div class="hero-banner__content">
                {% if block.settings.subheading != blank %}
                  <span class="hero-banner__subheading">{{ block.settings.subheading }}</span>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h1 class="hero-banner__heading">{{ block.settings.heading }}</h1>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="hero-banner__text">{{ block.settings.text }}</p>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <a href="{{ block.settings.button_link }}" class="button button--primary hero-banner__button">
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <button class="hero-banner__nav hero-banner__nav--prev" aria-label="Previous slide">
        <svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2L2 10L10 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      
      <button class="hero-banner__nav hero-banner__nav--next" aria-label="Next slide">
        <svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2L10 10L2 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="hero-banner__dots">
        {% for block in section.blocks %}
          <button 
            class="hero-banner__dot{% if forloop.first %} hero-banner__dot--active{% endif %}" 
            data-dot-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}

  </div>

  {% if section.settings.bottom_bar_text != blank %}
    <div class="hero-banner__bar">
      <p class="hero-banner__bar-text">{{ section.settings.bottom_bar_text }}</p>
    </div>
  {% endif %}
</div>

<style>
/* ALTURAS DEL HERO BANNER */
.hero-banner-wrapper--small .hero-banner { height: 400px; }
.hero-banner-wrapper--medium .hero-banner { height: 550px; }
.hero-banner-wrapper--large .hero-banner { height: 700px; }
.hero-banner-wrapper--full .hero-banner { height: 100vh; }

.hero-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* FORZAR A QUE SLIDES E IMAGEN LLENEN EL 100% DEL ALTO Y ANCHO */
.hero-banner__slides {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-banner__slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.6s ease, visibility 0.6s ease;
  z-index: 1;
}

.hero-banner__slide.is-active {
  opacity: 1;
  visibility: visible;
  z-index: 2;
}

.hero-banner__image {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important; /* Llena todo el espacio sin deformarse */
  display: block;
}

.hero-banner__image.position-center { object-position: center; }
.hero-banner__image.position-top { object-position: top; }
.hero-banner__image.position-bottom { object-position: bottom; }

.hero-banner__overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  z-index: 3;
}

.hero-banner__dot {
  cursor: pointer;
  border: none;
  background: rgba(255, 255, 255, 0.4);
}
.hero-banner__dot--active {
  background: #ffffff;
}

@media (max-width: 767px) {
  .hero-banner-wrapper--small .hero-banner { height: 320px; }
  .hero-banner-wrapper--medium .hero-banner { height: 420px; }
  .hero-banner-wrapper--large .hero-banner { height: 520px; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('HeroBanner-{{ section.id }}');
    if (!wrapper) return;

    const slides = wrapper.querySelectorAll('.hero-banner__slide');
    const dots = wrapper.querySelectorAll('.hero-banner__dot');
    const prevBtn = wrapper.querySelector('.hero-banner__nav--prev');
    const nextBtn = wrapper.querySelector('.hero-banner__nav--next');
    const autoRotate = {{ section.settings.auto_rotate | json }};
    const speed = {{ section.settings.change_speed | times: 1000 }};

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer = null;

    function goToSlide(index) {
      slides[currentIndex].classList.remove('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.remove('hero-banner__dot--active');

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex].classList.add('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.add('hero-banner__dot--active');
    }

    function startTimer() {
      if (autoRotate) {
        stopTimer();
        timer = setInterval(() => goToSlide(currentIndex + 1), speed);
      }
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        goToSlide(currentIndex + 1);
        startTimer();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        goToSlide(currentIndex - 1);
        startTimer();
      });
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToSlide(idx);
        startTimer();
      });
    });

    wrapper.addEventListener('mouseenter', stopTimer);
    wrapper.addEventListener('mouseleave', startTimer);

    startTimer();
  });
</script>

{% schema %}
{
  "name": "Hero Banner Slider",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner Height",
      "options": [
        { "value": "small", "label": "Small (400px)" },
        { "value": "medium", "label": "Medium (550px)" },
        { "value": "large", "label": "Large (700px)" },
        { "value": "full", "label": "Full Screen (100vh)" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "bottom_bar_text",
      "label": "Bottom Bar Text",
      "default": "Redefining the standard of comfort for the modern clinical spa and boutique institute."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Focal Position",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Dark Overlay Opacity",
          "default": 30
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "DIVINE EI-504"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Multi-Treatment Electric Table"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Quiet, versatile, and built to last."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}