{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

<div class="hero-banner-wrapper" id="HeroBanner-{{ section.id }}">
  <div class="hero-banner">
    
    <div class="hero-banner__slides" id="HeroBannerSlides-{{ section.id }}">
      {% for block in section.blocks %}
        <div 
          class="hero-banner__slide{% if forloop.first %} is-active{% endif %}" 
          data-slide-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <img 
              src="{{ block.settings.image | image_url: width: 2000 }}" 
              alt="{{ block.settings.heading | escape }}"
              loading="eager"
              width="2000"
              height="1000"
              class="hero-banner__image position-{{ block.settings.image_position | default: 'center' }}"
            >
          {% else %}
            <div class="hero-banner__placeholder"></div>
          {% endif %}

          <div class="hero-banner__overlay" style="background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});">
            <div class="hero-banner__container page-width">
              <div class="hero-banner__content">
                {% if block.settings.subheading != blank %}
                  <span class="hero-banner__subheading" style="color: {{ block.settings.subheading_color }};">{{ block.settings.subheading }}</span>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h1 class="hero-banner__heading" style="color: {{ block.settings.heading_color }};">{{ block.settings.heading }}</h1>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="hero-banner__text" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</p>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <a 
                    href="{{ block.settings.button_link }}" 
                    class="button hero-banner__button"
                    style="background-color: {{ block.settings.btn_bg_color }}; color: {{ block.settings.btn_text_color }};"
                  >
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} ALWAYS VISIBLE ARROWS IF > 1 SLIDE {%- endcomment -%}
    {% if section.blocks.size > 1 %}
      <button class="hero-banner__nav hero-banner__nav--prev" aria-label="Previous slide">
        <svg width="14" height="24" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2L2 10L10 18" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      
      <button class="hero-banner__nav hero-banner__nav--next" aria-label="Next slide">
        <svg width="14" height="24" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2L10 10L2 18" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="hero-banner__dots">
        {% for block in section.blocks %}
          <button 
            class="hero-banner__dot{% if forloop.first %} hero-banner__dot--active{% endif %}" 
            data-dot-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}

  </div>

  {% if section.settings.bottom_bar_text != blank %}
    <div class="hero-banner__bar" style="background-color: {{ section.settings.bar_bg_color }};">
      <p class="hero-banner__bar-text" style="color: {{ section.settings.bar_text_color }};">{{ section.settings.bottom_bar_text }}</p>
    </div>
  {% endif %}
</div>

<style>
/* FORCED CONTAINER & SLIDE HEIGHTS */
#HeroBanner-{{ section.id }} .hero-banner,
#HeroBanner-{{ section.id }} .hero-banner__slides,
#HeroBanner-{{ section.id }} .hero-banner__slide,
#HeroBanner-{{ section.id }} .hero-banner__image {
  height: {{ section.settings.custom_height }}px !important;
  min-height: {{ section.settings.custom_height }}px !important;
  max-height: {{ section.settings.custom_height }}px !important;
}

#HeroBanner-{{ section.id }} .hero-banner {
  position: relative !important;
  width: 100% !important;
  overflow: hidden !important;
  user-select: none;
  touch-action: pan-y;
}

#HeroBanner-{{ section.id }} .hero-banner__slides {
  position: relative !important;
  width: 100% !important;
  cursor: grab;
}

#HeroBanner-{{ section.id }} .hero-banner__slides:active {
  cursor: grabbing;
}

#HeroBanner-{{ section.id }} .hero-banner__slide {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s ease, visibility 0.5s ease;
  z-index: 1;
}

#HeroBanner-{{ section.id }} .hero-banner__slide.is-active {
  opacity: 1 !important;
  visibility: visible !important;
  z-index: 2;
}

#HeroBanner-{{ section.id }} .hero-banner__image {
  width: 100% !important;
  object-fit: cover !important;
  display: block !important;
}

#HeroBanner-{{ section.id }} .hero-banner__image.position-center { object-position: center !important; }
#HeroBanner-{{ section.id }} .hero-banner__image.position-top { object-position: top !important; }
#HeroBanner-{{ section.id }} .hero-banner__image.position-bottom { object-position: bottom !important; }

#HeroBanner-{{ section.id }} .hero-banner__overlay {
  position: absolute !important;
  inset: 0 !important;
  display: flex !important;
  align-items: center !important;
  z-index: 3;
}

/* NAVIGATION ARROWS STYLING */
#HeroBanner-{{ section.id }} .hero-banner__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.2);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: background 0.2s ease, transform 0.2s ease;
}

#HeroBanner-{{ section.id }} .hero-banner__nav:hover {
  background: rgba(0, 0, 0, 0.8);
  transform: translateY(-50%) scale(1.08);
}

#HeroBanner-{{ section.id }} .hero-banner__nav--prev { left: 20px; }
#HeroBanner-{{ section.id }} .hero-banner__nav--next { right: 20px; }

@media (max-width: 767px) {
  #HeroBanner-{{ section.id }} .hero-banner,
  #HeroBanner-{{ section.id }} .hero-banner__slides,
  #HeroBanner-{{ section.id }} .hero-banner__slide,
  #HeroBanner-{{ section.id }} .hero-banner__image {
    height: {{ section.settings.custom_height_mobile }}px !important;
    min-height: {{ section.settings.custom_height_mobile }}px !important;
    max-height: {{ section.settings.custom_height_mobile }}px !important;
  }

  #HeroBanner-{{ section.id }} .hero-banner__nav {
    width: 38px;
    height: 38px;
  }
  #HeroBanner-{{ section.id }} .hero-banner__nav--prev { left: 10px; }
  #HeroBanner-{{ section.id }} .hero-banner__nav--next { right: 10px; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('HeroBanner-{{ section.id }}');
    if (!wrapper) return;

    const slidesContainer = wrapper.querySelector('.hero-banner__slides');
    const slides = wrapper.querySelectorAll('.hero-banner__slide');
    const dots = wrapper.querySelectorAll('.hero-banner__dot');
    const prevBtn = wrapper.querySelector('.hero-banner__nav--prev');
    const nextBtn = wrapper.querySelector('.hero-banner__nav--next');
    const autoRotate = {{ section.settings.auto_rotate | json }};
    const speed = {{ section.settings.change_speed | times: 1000 }};

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer = null;
    let startX = 0;
    let currentX = 0;
    let isDragging = false;

    function goToSlide(index) {
      slides[currentIndex].classList.remove('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.remove('hero-banner__dot--active');

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex].classList.add('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.add('hero-banner__dot--active');
    }

    function startTimer() {
      if (autoRotate) {
        stopTimer();
        timer = setInterval(() => goToSlide(currentIndex + 1), speed);
      }
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    // ARROW CLICK LISTENERS
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(currentIndex + 1);
        startTimer();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(currentIndex - 1);
        startTimer();
      });
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToSlide(idx);
        startTimer();
      });
    });

    // MOUSE & TOUCH DRAG SWIPE LOGIC
    const handleDragStart = (e) => {
      isDragging = true;
      startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      stopTimer();
    };

    const handleDragMove = (e) => {
      if (!isDragging) return;
      currentX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
    };

    const handleDragEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      const diffX = startX - currentX;

      // Threshold of 50px swipe
      if (Math.abs(diffX) > 50) {
        if (diffX > 0) {
          goToSlide(currentIndex + 1); // Swipe left -> Next
        } else {
          goToSlide(currentIndex - 1); // Swipe right -> Prev
        }
      }
      startTimer();
    };

    slidesContainer.addEventListener('mousedown', handleDragStart);
    slidesContainer.addEventListener('mousemove', handleDragMove);
    slidesContainer.addEventListener('mouseup', handleDragEnd);
    slidesContainer.addEventListener('mouseleave', handleDragEnd);

    slidesContainer.addEventListener('touchstart', handleDragStart, { passive: true });
    slidesContainer.addEventListener('touchmove', handleDragMove, { passive: true });
    slidesContainer.addEventListener('touchend', handleDragEnd);

    wrapper.addEventListener('mouseenter', stopTimer);
    wrapper.addEventListener('mouseleave', startTimer);

    startTimer();
  });
</script>

{% schema %}
{
  "name": "Hero Banner Slider",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "header",
      "content": "Height Controls (Drag Sliders)"
    },
    {
      "type": "range",
      "id": "custom_height",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop Height",
      "default": 450
    },
    {
      "type": "range",
      "id": "custom_height_mobile",
      "min": 180,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Mobile Height",
      "default": 320
    },
    {
      "type": "header",
      "content": "Autoplay Options"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "header",
      "content": "Bottom Bar Settings"
    },
    {
      "type": "textarea",
      "id": "bottom_bar_text",
      "label": "Bottom Bar Text",
      "default": "Redefining the standard of comfort for the modern clinical spa and boutique institute."
    },
    {
      "type": "color",
      "id": "bar_bg_color",
      "label": "Bar Background Color",
      "default": "#f5f5f7"
    },
    {
      "type": "color",
      "id": "bar_text_color",
      "label": "Bar Text Color",
      "default": "#1d1d1f"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Focal Position",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Dark Overlay Opacity",
          "default": 30
        },
        {
          "type": "header",
          "content": "Slide Content"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "DIVINE EI-504"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Multi-Treatment Electric Table"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Quiet, versatile, and built to last."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Color Pickers"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Subheading Color",
          "default": "#ab273b"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Description Color",
          "default": "#f5f5f7"
        },
        {
          "type": "color",
          "id": "btn_bg_color",
          "label": "Button Background Color",
          "default": "#ab273b"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Button Text Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}