{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

<div class="hero-banner-wrapper">
  <div class="hero-banner">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'hero-banner__image' }}
    {% else %}
      <div class="hero-banner__placeholder"></div>
    {% endif %}

    <div class="hero-banner__overlay">
      <div class="hero-banner__container">
        <div class="hero-banner__content">
          {% if section.settings.subheading != blank %}
            <span class="hero-banner__subheading">{{ section.settings.subheading }}</span>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
          {% endif %}

          {% if section.settings.text != blank %}
            <p class="hero-banner__text">{{ section.settings.text }}</p>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link }}" class="button button--primary hero-banner__button">
              {{ section.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button class="hero-banner__nav hero-banner__nav--prev" aria-label="Previous slide">
      <svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 2L2 10L10 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="hero-banner__nav hero-banner__nav--next" aria-label="Next slide">
      <svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 2L10 10L2 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <!-- Pagination Dots -->
    <div class="hero-banner__dots">
      <span class="hero-banner__dot hero-banner__dot--active"></span>
      <span class="hero-banner__dot"></span>
      <span class="hero-banner__dot"></span>
    </div>
  </div>

  <!-- Bottom Accent Bar -->
  {% if section.settings.bottom_bar_text != blank %}
    <div class="hero-banner__bar">
      <p class="hero-banner__bar-text">{{ section.settings.bottom_bar_text }}</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hero Banner Slider",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DIVINE EI-504"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Multi-Treatment Electric Table"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Quiet, versatile, and built to last. Elevate your clients' comfort while protecting your posture during long treatment days."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop the Divine EI-504"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "textarea",
      "id": "bottom_bar_text",
      "label": "Bottom Bar Text",
      "default": "Redefining the standard of comfort for the modern clinical spa and boutique institute."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Slider"
    }
  ]
}
{% endschema %}