{{ 'section-about-pillars.css' | asset_url | stylesheet_tag }}

<section class="about-pillars page-width">
  <div class="about-pillars__header">
    {%- if section.settings.subtitle != blank -%}
      <p class="about-pillars__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="about-pillars__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  <div class="about-pillars__grid">
    {%- for block in section.blocks -%}
      <div class="about-pillars__col {% if block.settings.is_highlight %}about-pillars__col--highlight{% endif %}" {{ block.shopify_attributes }}>
        
        <!-- Ícono circular flotante -->
        <div class="about-pillars__icon-badge">
          {%- if block.settings.icon_image != blank -%}
            {{ block.settings.icon_image | image_url: width: 100 | image_tag: class: 'about-pillars__icon-img', alt: block.settings.title }}
          {%- else -%}
            <span class="about-pillars__icon-fallback">★</span>
          {%- endif -%}
        </div>

        <!-- Tarjeta de Contenido -->
        <div class="about-pillars__card">
          {%- if block.settings.title != blank -%}
            <h3 class="about-pillars__card-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="about-pillars__card-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "About - Values & Pillars",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Header Subtitle",
      "default": "Making you our top priority for more than 3 generations!"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Header Intro Text",
      "default": "Our family has been supporting beauty and wellbeing professionals for more than fifty years.\nAs a high-end beauty and spa equipment manufacturer, we have always understood that our products are your work tools. That is why excellence is our commitment so you can provide clients the very best care day after day."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Column",
      "limit": 4,
      "settings": [
        {
          "type": "checkbox",
          "id": "is_highlight",
          "label": "Red Block Style (Highlighted)",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Circle Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quality Equipment"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Quality, innovation, design & technology are the results of a dynamic production team working hand in hand..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Values & Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Quality Equipment",
            "text": "Quality, innovation, design & technology are the results of a dynamic production team working hand in hand with the research and development department in order to design top quality aesthetic appliances and equipment.",
            "is_highlight": false
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Superior Service",
            "text": "With 30 years of experience in esthetics, Equipro Esthetic Equipment's main concern is customer service: with a network of North American distributors, Equipro is able to offer a courteous & reliable after-sales service.",
            "is_highlight": true
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Qualified Distributors",
            "text": "Our North American network of qualified distributors also provides technical training, maintenance and after-sales service for the equipment.",
            "is_highlight": false
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Reputation",
            "text": "Our reputation speaks about our products and services. Don't hesitate to visit our Instagram to see from yourself how satisfy our customers are!",
            "is_highlight": true
          }
        }
      ]
    }
  ]
}
{% endschema %}