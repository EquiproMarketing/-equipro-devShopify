{{ 'custom-subcategory-slider.css' | asset_url | stylesheet_tag }}

<section class="custom-subcat-section" id="subcat-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-subcat-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="swiper custom-subcat-swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- assign target_col = block.settings.collection -%}
          {%- assign target_prod = block.settings.product -%}
          
          {%- comment -%} 1. CASO COLECCIÓN (CATEGORÍA) - SÓLO 1 IMAGEN {%- endcomment -%}
          {%- if target_col != blank -%}
            {%- assign display_url = target_col.url -%}
            {%- assign display_title = block.settings.title | default: target_col.title -%}
            {%- assign display_image = block.settings.image | default: target_col.image -%}
            {%- assign hover_image = blank -%}{%- comment -%} Las colecciones no llevan hover de segunda imagen {%- endcomment -%}
            {%- assign display_subtitle = block.settings.subtitle | default: target_col.description | strip_html | truncatewords: 15 -%}
            {%- assign display_price = '' -%}
            {%- assign is_product = false -%}

          {%- comment -%} 2. CASO PRODUCTO - SOPORTA HOVER DE SEGUNDA IMAGEN {%- endcomment -%}
          {%- elsif target_prod != blank -%}
            {%- assign display_url = target_prod.url -%}
            {%- assign display_title = block.settings.title | default: target_prod.title -%}
            {%- assign display_image = block.settings.image | default: target_prod.featured_media -%}
            
            {%- assign hover_image = block.settings.hover_image -%}
            {%- if hover_image == blank and target_prod.media.size > 1 -%}
              {%- assign hover_image = target_prod.media[1].preview_image -%}
            {%- endif -%}

            {%- assign display_subtitle = block.settings.subtitle | default: target_prod.description | strip_html | truncatewords: 12 -%}
            
            {%- capture display_price -%}
              {%- if block.settings.price != blank -%}
                {{ block.settings.price }}
              {%- elsif target_prod.price_varies -%}
                {{ 'products.product.from_lowest_price_html' | t: lowest_price: target_prod.price_min | money }}
              {%- else -%}
                {{ target_prod.price | money }}
              {%- endif -%}
            {%- endcapture -%}
            {%- assign is_product = true -%}

          {%- comment -%} 3. CASO MANUAL / VACÍO {%- endcomment -%}
          {%- else -%}
            {%- assign display_url = block.settings.link | default: '#' -%}
            {%- assign display_title = block.settings.title | default: 'Selecciona una categoría o producto' -%}
            {%- assign display_image = block.settings.image -%}
            {%- assign hover_image = block.settings.hover_image -%}
            {%- assign display_subtitle = block.settings.subtitle -%}
            {%- assign display_price = block.settings.price -%}
            {%- assign is_product = false -%}
          {%- endif -%}

          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="custom-subcat-card">
              
              <!-- IMAGEN (CON HOVER CONDICIONAL SÓLO SI EXISTE SEGUNDA IMAGEN) -->
              <a href="{{ display_url }}" class="custom-subcat-card__link-wrap" style="width: 100%;">
                <div class="custom-subcat-card__image-container" style="background-color: {{ block.settings.card_bg_color | default: '#f5f5f7' }};">
                  {%- if display_image != blank -%}
                    <img src="{{ display_image | image_url: width: 600 }}" alt="{{ display_title | escape }}" loading="lazy" width="280" height="350" class="custom-subcat-card__image custom-subcat-card__image--primary">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'custom-subcat-card__placeholder' }}
                  {%- endif -%}

                  {%- if hover_image != blank -%}
                    <img src="{{ hover_image | image_url: width: 600 }}" alt="{{ display_title | escape }}" loading="lazy" width="280" height="350" class="custom-subcat-card__image custom-subcat-card__image--secondary">
                  {%- endif -%}
                </div>
              </a>

              <!-- SWATCHES DE COLOR -->
              {%- if block.settings.available_colors != blank -%}
                <div class="custom-subcat-card__swatches">
                  {%- assign colors = block.settings.available_colors | split: ',' -%}
                  {%- for color_code in colors -%}
                    {%- assign clean_color = color_code | strip -%}
                    {%- if clean_color != blank -%}
                      <span class="custom-subcat-card__swatch-dot" style="background-color: {{ clean_color }};"></span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <!-- TEXTOS -->
              <a href="{{ display_url }}" class="custom-subcat-card__link-wrap" style="width: 100%; text-decoration: none;">
                <div class="custom-subcat-card__content">
                  {%- if block.settings.tag != blank -%}
                    <span class="custom-subcat-card__tag">{{ block.settings.tag }}</span>
                  {%- endif -%}
                  <h3 class="custom-subcat-card__title">{{ display_title }}</h3>
                  {%- if display_subtitle != blank -%}
                    <p class="custom-subcat-card__subtitle">{{ display_subtitle }}</p>
                  {%- endif -%}
                  {%- if display_price != blank -%}
                    <p class="custom-subcat-card__price">{{ display_price }}</p>
                  {%- endif -%}
                </div>
              </a>

              <!-- BOTÓN DE COMPRA -->
              {%- if is_product -%}
                <div class="custom-subcat-card__actions">
                  <a href="{{ display_url }}" class="custom-subcat-card__btn">Comprar</a>
                </div>
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('#subcat-section-{{ section.id }} .custom-subcat-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 32,
      loop: true,
      freeMode: true,
      grabCursor: true,
      speed: 6000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      breakpoints: {
        750: { spaceBetween: 40 }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Subcategory Slider",
  "tag": "section",
  "class": "section-custom-subcategory-slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Explore Subcategories"
    }
  ],
  "blocks": [
    {
      "type": "subcategory_card",
      "name": "Item Card",
      "settings": [
        {
          "type": "header",
          "content": "Origen Automático (Elige uno)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Seleccionar Colección (Extrae imagen y descripción)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Seleccionar Producto (Extrae info, precio y botón)"
        },
        {
          "type": "header",
          "content": "Sobreescrituras Manuales (Opcional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Imagen al pasar el cursor (Hover - Solo productos)"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Color de fondo de la tarjeta",
          "default": "#f5f5f7"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace personalizado"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Etiqueta / Badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Descripción personalizada"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio personalizado"
        },
        {
          "type": "textarea",
          "id": "available_colors",
          "label": "Colores (HEX separados por comas)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subcategory Slider",
      "blocks": [
        { "type": "subcategory_card" },
        { "type": "subcategory_card" },
        { "type": "subcategory_card" },
        { "type": "subcategory_card" }
      ]
    }
  ]
}
{% endschema %}