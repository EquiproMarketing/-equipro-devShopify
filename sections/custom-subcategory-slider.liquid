{{ 'custom-subcategory-slider.css' | asset_url | stylesheet_tag }}

<section class="custom-subcat-section" id="subcat-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-subcat-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="swiper custom-subcat-swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- assign selected_product = block.settings.product -%}
          {%- assign selected_collection = block.settings.collection -%}
          
          {%- comment -%} RESOLUCIÓN DINÁMICA DE DATOS (COLECCIÓN, PRODUCTO O MANUAL) {%- endcomment -%}
          {%- if selected_collection != blank -%}
            {%- assign display_url = selected_collection.url -%}
            {%- assign display_title = block.settings.title | default: selected_collection.title -%}
            {%- assign display_image = block.settings.image | default: selected_collection.image -%}
            {%- assign display_subtitle = block.settings.subtitle | default: selected_collection.description | strip_html | truncatewords: 10 -%}
            {%- assign hover_image = block.settings.hover_image -%}
            {%- assign display_price = '' -%}
          {%- elsif selected_product != blank -%}
            {%- assign display_url = selected_product.url -%}
            {%- assign display_title = block.settings.title | default: selected_product.title -%}
            {%- assign display_image = block.settings.image | default: selected_product.featured_media -%}
            {%- assign display_subtitle = block.settings.subtitle | default: selected_product.description | strip_html | truncatewords: 10 -%}
            {%- assign hover_image = block.settings.hover_image -%}
            {%- if hover_image == blank and selected_product.media.size > 1 -%}
              {%- assign hover_image = selected_product.media[1] -%}
            {%- endif -%}
            {%- capture display_price -%}
              {%- if block.settings.price != blank -%}
                {{ block.settings.price }}
              {%- elsif selected_product.price_varies -%}
                {{ 'products.product.from_lowest_price_html' | t: lowest_price: selected_product.price_min | money }}
              {%- else -%}
                {{ selected_product.price | money }}
              {%- endif -%}
            {%- endcapture -%}
          {%- else -%}
            {%- assign display_url = block.settings.link | default: '#' -%}
            {%- assign display_title = block.settings.title | default: 'Title' -%}
            {%- assign display_image = block.settings.image -%}
            {%- assign hover_image = block.settings.hover_image -%}
            {%- assign display_subtitle = block.settings.subtitle -%}
            {%- assign display_price = block.settings.price -%}
          {%- endif -%}

          <div class="swiper-slide" {{ block.shopify_attributes }}>
            
            <!-- FULL CARD CLICKABLE LINK -->
            <a href="{{ display_url }}" class="custom-subcat-card">
              
              <!-- 4:5 ROUNDED IMAGE CONTAINER -->
              <div 
                class="custom-subcat-card__image-container"
                style="background-color: {{ block.settings.card_bg_color | default: '#f5f5f7' }};"
              >
                {%- if display_image != blank -%}
                  <img
                    src="{{ display_image | image_url: width: 500 }}"
                    alt="{{ display_title | escape }}"
                    loading="lazy"
                    width="240"
                    height="300"
                    class="custom-subcat-card__image custom-subcat-card__image--primary"
                  >
                  {%- if hover_image != blank -%}
                    <img
                      src="{{ hover_image | image_url: width: 500 }}"
                      alt="{{ display_title | escape }}"
                      loading="lazy"
                      width="240"
                      height="300"
                      class="custom-subcat-card__image custom-subcat-card__image--secondary"
                    >
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'custom-subcat-card__placeholder' }}
                {%- endif -%}
              </div>

              <!-- COLOR SWATCHES -->
              <div class="custom-subcat-card__swatches">
                {%- assign colors = block.settings.available_colors | split: ',' -%}
                {%- for color_code in colors -%}
                  {%- assign clean_color = color_code | strip -%}
                  {%- if clean_color != blank -%}
                    <span 
                      class="custom-subcat-card__swatch-dot" 
                      style="background-color: {{ clean_color }};"
                    ></span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <!-- LEFT-ALIGNED CONTENT DETAILS -->
              <div class="custom-subcat-card__content">
                {%- if block.settings.tag != blank -%}
                  <span class="custom-subcat-card__tag">{{ block.settings.tag }}</span>
                {%- endif -%}

                <h3 class="custom-subcat-card__title">{{ display_title }}</h3>
                
                {%- if display_subtitle != blank -%}
                  <p class="custom-subcat-card__subtitle">{{ display_subtitle }}</p>
                {%- endif -%}

                {%- if display_price != blank -%}
                  <p class="custom-subcat-card__price">{{ display_price }}</p>
                {%- endif -%}
              </div>

            </a>

          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('#subcat-section-{{ section.id }} .custom-subcat-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 32,
      loop: true,
      freeMode: true,
      grabCursor: true,
      speed: 6000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      breakpoints: {
        750: { spaceBetween: 40 }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Subcategory Slider",
  "tag": "section",
  "class": "section-custom-subcategory-slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Explore Subcategories"
    }
  ],
  "blocks": [
    {
      "type": "subcategory_card",
      "name": "Item Card",
      "settings": [
        {
          "type": "header",
          "content": "Automatic Source (Choose one)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "header",
          "content": "Custom Overrides (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image Override"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Custom Hover Image Override"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Background Color",
          "default": "#f5f5f7"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom URL Override"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge / Tag",
          "default": "Skincare"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Description Override"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Custom Price Override"
        },
        {
          "type": "textarea",
          "id": "available_colors",
          "label": "Color Swatches (HEX list separated by comma)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subcategory Slider",
      "blocks": [
        { "type": "subcategory_card" },
        { "type": "subcategory_card" },
        { "type": "subcategory_card" },
        { "type": "subcategory_card" }
      ]
    }
  ]
}
{% endschema %}