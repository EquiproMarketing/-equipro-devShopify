{{ 'custom-subcategory-slider.css' | asset_url | stylesheet_tag }}

<section class="custom-subcat-section" id="subcat-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-subcat-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="swiper custom-subcat-swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          
          {%- comment -%} ==========================================
              BLOQUE TIPO COLECCIÓN (CATEGORÍA)
              ========================================== {%- endcomment -%}
          {%- if block.type == 'collection_card' -%}
            {%- assign target_col = block.settings.collection -%}
            
            {%- if target_col != blank -%}
              {%- assign display_url = target_col.url -%}
              {%- assign display_title = target_col.title -%}
              {%- assign display_image = target_col.image -%}
              {%- assign display_subtitle = target_col.description | strip_html | truncatewords: 10 -%}
            {%- else -%}
              {%- assign display_url = '#' -%}
              {%- assign display_title = 'Selecciona una Colección' -%}
              {%- assign display_image = blank -%}
              {%- assign display_subtitle = 'La descripción aparecerá aquí automáticamente.' -%}
            {%- endif -%}

            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <a href="{{ display_url }}" class="custom-subcat-card">
                <div class="custom-subcat-card__image-container" style="background-color: {{ block.settings.card_bg_color | default: '#f5f5f7' }};">
                  {%- if display_image != blank -%}
                    <img src="{{ display_image | image_url: width: 500 }}" alt="{{ display_title | escape }}" loading="lazy" width="240" height="300" class="custom-subcat-card__image">
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'custom-subcat-card__placeholder' }}
                  {%- endif -%}
                </div>

                <div class="custom-subcat-card__content">
                  {%- if block.settings.tag != blank -%}
                    <span class="custom-subcat-card__tag">{{ block.settings.tag }}</span>
                  {%- endif -%}
                  <h3 class="custom-subcat-card__title">{{ display_title }}</h3>
                  {%- if display_subtitle != blank -%}
                    <p class="custom-subcat-card__subtitle">{{ display_subtitle }}</p>
                  {%- endif -%}
                </div>
              </a>
            </div>

          {%- comment -%} ==========================================
              BLOQUE TIPO PRODUCTO
              ========================================== {%- endcomment -%}
          {%- elsif block.type == 'product_card' -%}
            {%- assign target_prod = block.settings.product -%}
            
            {%- if target_prod != blank -%}
              {%- assign display_url = target_prod.url -%}
              {%- assign display_title = target_prod.title -%}
              {%- assign display_image = target_prod.featured_media -%}
              {%- assign hover_image = target_prod.media[1] -%}
              {%- assign display_subtitle = target_prod.description | strip_html | truncatewords: 10 -%}
              
              {%- capture display_price -%}
                {%- if target_prod.price_varies -%}
                  {{ 'products.product.from_lowest_price_html' | t: lowest_price: target_prod.price_min | money }}
                {%- else -%}
                  {{ target_prod.price | money }}
                {%- endif -%}
              {%- endcapture -%}
            {%- else -%}
              {%- assign display_url = '#' -%}
              {%- assign display_title = 'Selecciona un Producto' -%}
              {%- assign display_image = blank -%}
              {%- assign hover_image = blank -%}
              {%- assign display_subtitle = 'Descripción automática del producto.' -%}
              {%- assign display_price = 'CA$ 0.00' -%}
            {%- endif -%}

            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="custom-subcat-card">
                <a href="{{ display_url }}" class="custom-subcat-card__link-wrap">
                  <div class="custom-subcat-card__image-container" style="background-color: {{ block.settings.card_bg_color | default: '#f5f5f7' }};">
                    {%- if display_image != blank -%}
                      <img src="{{ display_image | image_url: width: 500 }}" alt="{{ display_title | escape }}" loading="lazy" width="240" height="300" class="custom-subcat-card__image custom-subcat-card__image--primary">
                      {%- if hover_image != blank -%}
                        <img src="{{ hover_image | image_url: width: 500 }}" alt="{{ display_title | escape }}" loading="lazy" width="240" height="300" class="custom-subcat-card__image custom-subcat-card__image--secondary">
                      {%- endif -%}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'custom-subcat-card__placeholder' }}
                    {%- endif -%}
                  </div>
                </a>

                <!-- COLOR SWATCHES -->
                <div class="custom-subcat-card__swatches">
                  {%- assign colors = block.settings.available_colors | split: ',' -%}
                  {%- for color_code in colors -%}
                    {%- assign clean_color = color_code | strip -%}
                    {%- if clean_color != blank -%}
                      <span class="custom-subcat-card__swatch-dot" style="background-color: {{ clean_color }};"></span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                <a href="{{ display_url }}" class="custom-subcat-card__link-wrap custom-subcat-card__content-link">
                  <div class="custom-subcat-card__content">
                    {%- if block.settings.tag != blank -%}
                      <span class="custom-subcat-card__tag">{{ block.settings.tag }}</span>
                    {%- endif -%}
                    <h3 class="custom-subcat-card__title">{{ display_title }}</h3>
                    {%- if display_subtitle != blank -%}
                      <p class="custom-subcat-card__subtitle">{{ display_subtitle }}</p>
                    {%- endif -%}
                    {%- if display_price != blank -%}
                      <p class="custom-subcat-card__price">{{ display_price }}</p>
                    {%- endif -%}
                  </div>
                </a>

                {%- if target_prod != blank -%}
                  <div class="custom-subcat-card__actions">
                    <a href="{{ display_url }}" class="custom-treatment-btn custom-treatment-btn--primary">Comprar</a>
                  </div>
                {%- endif -%}
              </div>
            </div>

          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('#subcat-section-{{ section.id }} .custom-subcat-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 32,
      loop: true,
      freeMode: true,
      grabCursor: true,
      speed: 6000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      breakpoints: {
        750: { spaceBetween: 40 }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Subcategory Slider",
  "tag": "section",
  "class": "section-custom-subcategory-slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Explore Subcategories"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection (Category)",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection (Auto-fetches info & image)"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Background Color",
          "default": "#f5f5f7"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge / Tag (Optional)"
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product (Auto-fetches info, price & button)"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Background Color",
          "default": "#f5f5f7"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge / Tag (Optional)"
        },
        {
          "type": "textarea",
          "id": "available_colors",
          "label": "Color Swatches (HEX list separated by comma)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subcategory Slider",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}