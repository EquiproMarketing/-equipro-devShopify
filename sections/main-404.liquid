{{ 'section-404.css' | asset_url | stylesheet_tag }}

<div class="page-width page-404">
  <div class="page-404__content">
    <span class="page-404__code">404</span>
    <h1 class="page-404__title">
      {% if section.settings.title == blank or section.settings.title == 'Page Not Found' %}
        {{ '404.not_found' | t }}
      {% else %}
        {{ section.settings.title }}
      {% endif %}
    </h1>
    <p class="page-404__subtext">
      {% if section.settings.subtext == blank or section.settings.subtext == 'The page you are looking for does not exist or has been moved.' %}
        {{ '404.description' | t }}
      {% else %}
        {{ section.settings.subtext }}
      {% endif %}
    </p>

    <div class="page-404__actions">
      <a href="{{ section.settings.button_link | default: '/' }}" class="button button--primary page-404__btn">
        {% if section.settings.button_text == blank or section.settings.button_text == 'Back to Home' %}
          {{ 'general.back_home' | t }}
        {% else %}
          {{ section.settings.button_text }}
        {% endif %}
      </a>
      <button type="button" class="button button--secondary page-404__btn-quote" data-open-quote-modal>
        {{ 'quote.open' | t }}
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Page Content",
  "tag": "section",
  "class": "section-404",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Page Not Found"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext Message",
      "default": "The page you are looking for does not exist or has been moved."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Back to Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/"
    }
  ]
}
{% endschema %}