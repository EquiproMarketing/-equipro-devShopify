{{ 'section-header.css' | asset_url | stylesheet_tag }}

<header class="site-header">
  <div class="page-width site-header__container">
    
    <!-- 1. Left: Hamburger (Mobile) / Desktop Nav -->
    <nav class="site-header__nav">
      <!-- Hamburger Icon (Mobile Only) -->
      <button class="site-header__hamburger" id="HeaderHamburger" aria-label="Toggle Navigation Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <!-- Desktop Menu (Dinamico de Shopify Navigation) -->
      <ul class="site-header__menu">
        {% assign header_menu = section.settings.menu %}
        {% if header_menu != blank and header_menu.links.size > 0 %}
          {% for link in header_menu.links %}
            <li class="{% if link.links != blank %}site-header__item-has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="site-header__link {% if link.active or link.child_active %}site-header__link--active{% endif %}">
                {{ link.title }}
                {% if link.links != blank %}
                  <svg class="icon-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% endif %}
              </a>

              <!-- Dropdown Anidado Automático -->
              {% if link.links != blank %}
                <ul class="site-header__dropdown">
                  {% for childlink in link.links %}
                    <li>
                      <a href="{{ childlink.url }}" class="{% if childlink.active %}site-header__link--active{% endif %}">
                        {{ childlink.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          <!-- Fallback de Resguardo -->
          <li><a href="/" class="site-header__link">Home</a></li>
          <li><a href="/collections" class="site-header__link">Shop</a></li>
          <li><a href="/pages/about-us" class="site-header__link">About Us</a></li>
          <li><a href="/pages/contact" class="site-header__link">Contact</a></li>
        {% endif %}
      </ul>
    </nav>

    <!-- 2. Center: Logo -->
    <div class="site-header__logo">
      <a href="/">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'site-header__logo-img', alt: shop.name }}
        {% else %}
          <span class="site-header__logo-text">EQUI<span>PRO</span></span>
        {% endif %}
      </a>
    </div>

    <!-- 3. Right: Actions (Socials, Cart & B2B Quote Trigger) -->
    <div class="site-header__actions">
      <div class="site-header__socials">
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>

      <a href="/cart" class="site-header__cart" aria-label="View Shopping Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="site-header__cart-count">{{ cart.item_count | default: 0 }}</span>
      </a>

      <!-- Trigger Modal B2B -->
      <button type="button" class="button-quote" data-open-quote-modal>Get a Quote</button>
    </div>

  </div>
</header>

<!-- Mobile Drawer Navigation (Dinamico) -->
<div class="mobile-drawer-overlay" id="MobileDrawerOverlay"></div>
<aside class="mobile-drawer" id="MobileDrawer">
  <div class="mobile-drawer__header">
    <span class="mobile-drawer__title">MENU</span>
    <button class="mobile-drawer__close" id="MobileDrawerClose" aria-label="Close Menu">&times;</button>
  </div>
  
  <ul class="mobile-drawer__menu">
    {% assign mobile_menu = section.settings.menu %}
    {% if mobile_menu != blank and mobile_menu.links.size > 0 %}
      {% for link in mobile_menu.links %}
        {% if link.links != blank %}
          <li class="mobile-drawer__has-sub">
            <div class="mobile-drawer__sub-header">
              <a href="{{ link.url }}" class="mobile-drawer__link">{{ link.title }}</a>
              <button class="mobile-drawer__toggle-sub" data-sub-toggle aria-label="Toggle Submenu">+</button>
            </div>
            <ul class="mobile-drawer__submenu">
              {% for childlink in link.links %}
                <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
              {% endfor %}
            </ul>
          </li>
        {% else %}
          <li><a href="{{ link.url }}" class="mobile-drawer__link">{{ link.title }}</a></li>
        {% endif %}
      {% endfor %}
    {% else %}
      <li><a href="/" class="mobile-drawer__link">Home</a></li>
      <li><a href="/collections" class="mobile-drawer__link">Shop</a></li>
      <li><a href="/pages/about-us" class="mobile-drawer__link">About Us</a></li>
      <li><a href="/pages/contact" class="mobile-drawer__link">Contact</a></li>
    {% endif %}
  </ul>
  
  <div class="mobile-drawer__footer">
    <button type="button" class="button-quote" data-open-quote-modal style="width: 100%; text-align: center;">Get a Quote</button>
  </div>
</aside>

<!-- Snippet Global Quote Modal -->
{% render 'quote-modal' %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const hamburgerBtn = document.getElementById('HeaderHamburger');
    const drawerCloseBtn = document.getElementById('MobileDrawerClose');
    const drawer = document.getElementById('MobileDrawer');
    const overlay = document.getElementById('MobileDrawerOverlay');

    function openDrawer() {
      if (drawer && overlay) {
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      if (drawer && overlay) {
        drawer.classList.remove('is-open');
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }

    if (hamburgerBtn) hamburgerBtn.addEventListener('click', openDrawer);
    if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);

    // Submenu Toggle en Mobile
    const subToggles = document.querySelectorAll('[data-sub-toggle]');
    subToggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        const submenu = this.closest('.mobile-drawer__has-sub')?.querySelector('.mobile-drawer__submenu');
        if (submenu) {
          submenu.classList.toggle('is-open');
          this.textContent = submenu.classList.contains('is-open') ? '−' : '+';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Header Navbar",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}