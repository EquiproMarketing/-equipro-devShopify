{{ 'section-about-vision.css' | asset_url | stylesheet_tag }}

<section class="about-vision page-width">
  <div class="about-vision__container">
    <!-- Columna Izquierda: Imagen principal + Card flotante rojo -->
    <div class="about-vision__left">
      <div class="about-vision__image-wrapper">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'about-vision__img', alt: section.settings.badge_title }}
        {%- else -%}
          <div class="about-placeholder-img"></div>
        {%- endif -%}
      </div>
      <!-- Tarjeta Roja Overlap -->
      {%- if section.settings.badge_title != blank -%}
        <div class="about-vision__badge">
          <h2 class="about-vision__badge-title">{{ section.settings.badge_title }}</h2>
        </div>
      {%- endif -%}
    </div>

    <!-- Columna Derecha: Parrafo + Boton -->
    <div class="about-vision__right">
      {%- if section.settings.description != blank -%}
        <div class="about-vision__description">
          <p>{{ section.settings.description }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <div class="about-vision__cta">
          <a href="{{ section.settings.btn_link }}" class="btn-equipro-solid">
            {{ section.settings.btn_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About - Vision",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "textarea",
      "id": "badge_title",
      "label": "Red Card Heading",
      "default": "Your Vision, Powered by North American Engineering."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Stop settling for equipment that stalls your growth. We provide esthetic solutions designed for 20 years of performance and the expert guidance to help your clinic thrive."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SCHEDULE YOUR 1-ON-1 CONSULTATION"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "About - Vision"
    }
  ]
}
{% endschema %}