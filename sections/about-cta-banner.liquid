{{ 'section-about-cta-banner.css' | asset_url | stylesheet_tag }}

<section class="about-cta-banner">
  <div class="about-cta-banner__bg">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 2000 | image_tag: class: 'about-cta-banner__img', alt: section.settings.title, loading: 'lazy' }}
    {%- else -%}
      <div class="about-cta-banner__placeholder"></div>
    {%- endif -%}
  </div>

  <div class="about-cta-banner__overlay"></div>

  <div class="about-cta-banner__content">
    {%- if section.settings.title != blank -%}
      <h2 class="about-cta-banner__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link }}" class="btn-equipro-cta">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About - CTA Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Big Ideas, Real Impact."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SEE ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "About - CTA Banner"
    }
  ]
}
{% endschema %}