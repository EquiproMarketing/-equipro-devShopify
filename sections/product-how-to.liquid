<div class="product-how-to page-width">
  <div class="product-how-to__grid">
    <div class="product-how-to__media">
      <div class="product-how-to__img-placeholder"></div>
    </div>

    <div class="product-how-to__content">
      <h2 class="product-how-to__title">How to Use</h2>
      <ul class="product-how-to__list">
        <li><strong>Height Calibration:</strong> Adjust the chair elevation using the control mechanism to match your optimal working height.</li>
        <li><strong>Backrest Positioning:</strong> Utilize the manual release handle to recline the backrest to the desired angle.</li>
        <li><strong>Tilt Activation:</strong> Engage the 15-degree tilt system to optimize facial and neck access.</li>
      </ul>

      <h2 class="product-how-to__title" style="margin-top: 2rem;">Safety & Disclaimers</h2>
      <ul class="product-how-to__list">
        <li><strong>Weight Distribution:</strong> Ensure clients are seated centrally, and never exceed maximum weight capacity.</li>
        <li><strong>Authorized Service:</strong> All maintenance and repairs must be performed by Equipro-certified technicians.</li>
      </ul>
    </div>
  </div>
</div>

<style>
.product-how-to { margin: 4rem auto; }
.product-how-to__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }
.product-how-to__media { width: 100%; aspect-ratio: 4/3; border-radius: 20px; overflow: hidden; background: #eee; }
.product-how-to__img-placeholder { width: 100%; height: 100%; background: #ddd; }
.product-how-to__title { font-size: 1.8rem; font-weight: 700; color: #a22938; margin-bottom: 1rem; }
.product-how-to__list { list-style: none; padding: 0; margin: 0; }
.product-how-to__list li { margin-bottom: 1rem; font-size: 0.95rem; line-height: 1.5; color: #444; }
@media (max-width: 767px) { .product-how-to__grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "How to Use & Care",
  "settings": [],
  "presets": [{ "name": "How to Use & Care" }]
}
{% endschema %}