<div class="collection-banner page-width">
  <div class="collection-banner__inner">
    {%- assign banner_image = section.settings.custom_image | default: collection.image -%}
    
    {%- if banner_image != blank -%}
      <img src="{{ banner_image | image_url: width: 1600 }}" alt="{{ section.settings.custom_title | default: collection.title | escape }}" class="collection-banner__bg" loading="lazy">
    {%- else -%}
      <div class="collection-banner__placeholder"></div>
    {%- endif -%}

    <div class="collection-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

    <div class="collection-banner__content">
      <h1 class="collection-banner__title">
        {%- if section.settings.custom_title != blank -%}
          {{ section.settings.custom_title | escape }}
        {%- else -%}
          {{ collection.title | default: "Trolleys" }}
        {%- endif -%}
      </h1>

      {%- assign description_text = section.settings.custom_description | default: collection.description -%}
      {%- if description_text != blank -%}
        <div class="collection-banner__desc">
          {{ description_text }}
        </div>
      {%- elsif section.settings.fallback_description != blank -%}
        <p class="collection-banner__desc">
          {{ section.settings.fallback_description | escape }}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
.collection-banner { margin-top: 1rem; margin-bottom: 2rem; }
.collection-banner__inner {
  position: relative;
  width: 100%;
  min-height: 240px;
  border-radius: 20px;
  overflow: hidden;
  display: flex;
  align-items: center;
}
.collection-banner__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.collection-banner__placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
}
.collection-banner__overlay {
  position: absolute;
  inset: 0;
  background: #000000;
  transition: opacity 0.3s ease;
}
.collection-banner__content {
  position: relative;
  z-index: 2;
  padding: 2.5rem 3rem;
  max-width: 550px;
  color: #ffffff;
}
.collection-banner__title {
  font-size: 2.4rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
  color: #ffffff;
}
.collection-banner__desc {
  font-size: 0.95rem;
  line-height: 1.5;
  color: rgba(255,255,255,0.9);
}
.collection-banner__desc p { margin: 0; }

@media (max-width: 767px) {
  /* Ocultamos la imagen y el overlay oscuro de fondo en móvil */
  .collection-banner__bg,
  .collection-banner__placeholder,
  .collection-banner__overlay {
    display: none !important;
  }

  .collection-banner__inner {
    background: transparent;
    border-radius: 0;
    flex-direction: column;
    min-height: auto;
    overflow: visible;
  }

  /* Bloque del título con fondo rojo corporativo (#a22938) */
  .collection-banner__content {
    background-color: #a22938;
    color: #ffffff;
    width: 100%;
    max-width: 100%;
    padding: 1.75rem 1.25rem;
    border-radius: 12px 12px 0 0;
  }

  .collection-banner__title {
    font-size: 1.8rem;
    color: #ffffff;
    margin-bottom: 0;
  }

  /* Bloque de descripción debajo con texto negro sobre fondo blanco */
  .collection-banner__desc {
    background-color: #ffffff;
    color: #1d1d1f;
    padding: 1.25rem;
    border-radius: 0 0 12px 12px;
    border: 1px solid #e5e5ea;
    border-top: none;
    font-size: 0.9rem;
  }

  .collection-banner__desc p {
    color: #1d1d1f !important;
  }
}
</style>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "section-collection-banner",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom Title Override",
      "info": "Leave blank to dynamically use the Shopify Collection title."
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Custom Description Override",
      "info": "Leave blank to dynamically use the Shopify Collection description."
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback Description",
      "default": "Professional magnifying lamps with powerful LED lighting for beauty treatments and esthetics.",
      "info": "Used only if both Custom Description and Collection Description are empty."
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom Background Image",
      "info": "Overrides the featured collection image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
