{{ 'section-pre-footer-hub.css' | asset_url | stylesheet_tag }}

<section class="pre-footer-hub page-width" id="PreFooterHub-{{ section.id }}">
  {% if section.settings.main_title != blank %}
    <div class="pre-footer-hub__header animate-on-scroll">
      <h2 class="pre-footer-hub__main-title">{{ section.settings.main_title }}</h2>
    </div>
  {% endif %}

  <!-- Staggered Offset Grid (Masonry 2-Column Style, 4:5 Aspect Ratio) -->
  <div class="pre-footer-hub__grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign is_even = forloop.index | modulo: 2 %}
        {% assign enable_rotator = block.settings.enable_interactive_rotator %}

        <div 
          class="porsche-card {% if is_even == 0 %}porsche-card--offset{% endif %} {% if enable_rotator %}js-interactive-card{% endif %} animate-on-scroll" 
          style="
            --porsche-bg: {{ block.settings.bg_color | default: '#111111' }};
            --porsche-text-color: {{ block.settings.text_color | default: '#ffffff' }};
          "
          {{ block.shopify_attributes }}
        >
          <!-- Multi-Image Rotator Layer -->
          <div class="porsche-card__media">
            {% if block.settings.image_1 != blank %}
              <img 
                src="{{ block.settings.image_1 | image_url: width: 1200 }}" 
                alt="{{ block.settings.title | escape }}" 
                class="porsche-card__img porsche-card__img--active js-rotator-img" 
                loading="lazy" 
                width="600" 
                height="750"
              >
            {% endif %}

            {% if enable_rotator %}
              {% if block.settings.image_2 != blank %}
                <img 
                  src="{{ block.settings.image_2 | image_url: width: 1200 }}" 
                  alt="{{ block.settings.title | escape }}" 
                  class="porsche-card__img js-rotator-img" 
                  loading="lazy" 
                  width="600" 
                  height="750"
                >
              {% endif %}
              {% if block.settings.image_3 != blank %}
                <img 
                  src="{{ block.settings.image_3 | image_url: width: 1200 }}" 
                  alt="{{ block.settings.title | escape }}" 
                  class="porsche-card__img js-rotator-img" 
                  loading="lazy" 
                  width="600" 
                  height="750"
                >
              {% endif %}
              {% if block.settings.image_4 != blank %}
                <img 
                  src="{{ block.settings.image_4 | image_url: width: 1200 }}" 
                  alt="{{ block.settings.title | escape }}" 
                  class="porsche-card__img js-rotator-img" 
                  loading="lazy" 
                  width="600" 
                  height="750"
                >
              {% endif %}

              <!-- Bullet Indicators for Active Image -->
              <div class="porsche-card__rotator-dots js-rotator-dots">
                <span class="porsche-dot porsche-dot--active"></span>
                {% if block.settings.image_2 != blank %}<span class="porsche-dot"></span>{% endif %}
                {% if block.settings.image_3 != blank %}<span class="porsche-dot"></span>{% endif %}
                {% if block.settings.image_4 != blank %}<span class="porsche-dot"></span>{% endif %}
              </div>
            {% endif %}

            <div class="porsche-card__gradient"></div>
          </div>

          <!-- Content Bottom Overlay -->
          <div class="porsche-card__content">
            {% if block.settings.tag != blank %}
              <span class="porsche-card__tag" style="color: {{ block.settings.tag_color | default: '#a22938' }};">
                {{ block.settings.tag }}
              </span>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="porsche-card__title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="porsche-card__text">{{ block.settings.text }}</p>
            {% endif %}

            <!-- Color Swatches Row -->
            {% if block.settings.color_list != blank %}
              {% assign colors = block.settings.color_list | split: "," %}
              <div class="porsche-card__swatches">
                {% for hex in colors %}
                  <span class="porsche-swatch" style="background-color: {{ hex | strip }};"></span>
                {% endfor %}
              </div>
            {% endif %}

            <!-- Action Buttons / Pills -->
            <div class="porsche-card__actions">
              {% if block.settings.btn_1_link != blank %}
                <a href="{{ block.settings.btn_1_link }}" class="porsche-btn">
                  {{ block.settings.btn_1_text | default: "Discover Options" }}
                </a>
              {% endif %}

              {% if block.settings.btn_2_link != blank %}
                <a href="{{ block.settings.btn_2_link }}" class="porsche-btn porsche-btn--secondary" {% if block.settings.btn_2_is_pdf %}target="_blank"{% endif %}>
                  {{ block.settings.btn_2_text | default: "Download Specs PDF ➔" }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% comment %} DEFAULT FALLBACK CARDS {% endcomment %}
      <div class="porsche-card animate-on-scroll">
        <div class="porsche-card__content">
          <h3 class="porsche-card__title">Support & Service.</h3>
          <p class="porsche-card__text">Contact our clinical support specialists near you.</p>
          <a href="#" class="porsche-btn">Get Technical Support</a>
        </div>
      </div>
      <div class="porsche-card porsche-card--offset animate-on-scroll" style="--porsche-bg: #2d1e3e;">
        <div class="porsche-card__content">
          <h3 class="porsche-card__title">Personalization & Finishes.</h3>
          <p class="porsche-card__text">Discover custom upholstery finishes for treatment beds and stools.</p>
          <a href="#" class="porsche-btn">Explore Custom Colors</a>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<!-- Mousemove Interactive Multi-Image Rotator Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Scroll Observer for smooth entrance animations
    const observerOptions = { threshold: 0.1 };
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('#PreFooterHub-{{ section.id }} .animate-on-scroll').forEach(el => {
      observer.observe(el);
    });

    // 2. Interactive Cursor Position Image Switcher
    const interactiveCards = document.querySelectorAll('#PreFooterHub-{{ section.id }} .js-interactive-card');

    interactiveCards.forEach(card => {
      const images = card.querySelectorAll('.js-rotator-img');
      const dots = card.querySelectorAll('.porsche-dot');
      const totalImages = images.length;

      if (totalImages <= 1) return;

      card.addEventListener('mousemove', function(e) {
        const rect = card.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const cardWidth = rect.width;

        // Calculate active index based on cursor horizontal position percentage
        let activeIndex = Math.floor((mouseX / cardWidth) * totalImages);
        if (activeIndex < 0) activeIndex = 0;
        if (activeIndex >= totalImages) activeIndex = totalImages - 1;

        // Update active image class
        images.forEach((img, idx) => {
          img.classList.toggle('porsche-card__img--active', idx === activeIndex);
        });

        // Update active indicator dot
        dots.forEach((dot, idx) => {
          dot.classList.toggle('porsche-dot--active', idx === activeIndex);
        });
      });

      // Reset to primary image when cursor leaves card area
      card.addEventListener('mouseleave', function() {
        images.forEach((img, idx) => {
          img.classList.toggle('porsche-card__img--active', idx === 0);
        });
        dots.forEach((dot, idx) => {
          dot.classList.toggle('porsche-dot--active', idx === 0);
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Pre-Footer Hub Interactive",
  "tag": "section",
  "class": "section-pre-footer-hub",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Section Title",
      "default": "Customization & Support Hub"
    }
  ],
  "blocks": [
    {
      "type": "staggered_card",
      "name": "Porsche Style Card",
      "settings": [
        {
          "type": "header",
          "content": "Interactive Multi-Image Settings"
        },
        {
          "type": "checkbox",
          "id": "enable_interactive_rotator",
          "label": "Enable Cursor Movement Image Rotator",
          "default": true,
          "info": "Switches through images dynamically as the user moves the mouse across the card."
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Primary Image 1 (Default)"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Hover Image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Hover Image 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Hover Image 4"
        },
        {
          "type": "header",
          "content": "Card Content & Customization"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Support"
        },
        {
          "type": "color",
          "id": "tag_color",
          "label": "Tag Color",
          "default": "#a22938"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Personnalisation et finitions."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Découvrez les possibilités de personnalisation qu'offre Equipro pour votre mobilier de clinique."
        },
        {
          "type": "text",
          "id": "color_list",
          "label": "Color Swatches Hex List",
          "default": "#ffffff, #191919, #2d1e3e",
          "info": "Comma separated: #ffffff, #000000"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background Color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "btn_1_text",
          "label": "Button 1 Text",
          "default": "Découvrez les finitions"
        },
        {
          "type": "url",
          "id": "btn_1_link",
          "label": "Button 1 Link"
        },
        {
          "type": "text",
          "id": "btn_2_text",
          "label": "Button 2 Text",
          "default": "Télécharger la fiche technique (PDF)"
        },
        {
          "type": "url",
          "id": "btn_2_link",
          "label": "Button 2 Link"
        },
        {
          "type": "checkbox",
          "id": "btn_2_is_pdf",
          "label": "Open Button 2 in New Tab (PDF)",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pre-Footer Hub Interactive",
      "blocks": [
        {
          "type": "staggered_card",
          "settings": {
            "title": "Equipro Connect.",
            "text": "Accédez aux manuels, guides de soutien technique et service après-vente.",
            "btn_1_text": "Service et Support"
          }
        },
        {
          "type": "staggered_card",
          "settings": {
            "title": "Teintes au choix.",
            "text": "Découvrez les couleurs intérieures et extérieures très spéciales disponibles pour vos lits et tabourets.",
            "bg_color": "#2c1f3d",
            "btn_1_text": "Découvrez les choix de couleurs"
          }
        }
      ]
    }
  ]
}
{% endschema %}