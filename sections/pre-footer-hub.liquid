{{ 'section-pre-footer-hub.css' | asset_url | stylesheet_tag }}

<section class="pre-footer-hub page-width" id="PreFooterHub-{{ section.id }}">
  {% if section.settings.main_title != blank %}
    <div class="pre-footer-hub__header animate-on-scroll">
      <h2 class="pre-footer-hub__main-title">{{ section.settings.main_title }}</h2>
    </div>
  {% endif %}

  <div class="pre-footer-hub__grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign img_fit = block.settings.image_fit | default: "cover" %}
        
        <div 
          class="pre-footer-card pre-footer-card--{{ img_fit }} animate-on-scroll" 
          style="
            background-color: {{ block.settings.bg_color | default: '#f5f5f7' }};
            --card-text-color: {{ block.settings.text_color | default: '#1d1d1f' }};
          "
          {{ block.shopify_attributes }}
        >
          <!-- Full Bleed Image Background / Container -->
          <div class="pre-footer-card__media">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 1000 }}" 
                alt="{{ block.settings.title | escape }}" 
                class="pre-footer-card__img" 
                loading="lazy" 
                width="600" 
                height="600"
              >
            {% endif %}
            <div class="pre-footer-card__overlay" style="opacity: {{ block.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};"></div>
          </div>

          <!-- Card Content Floating Over Image -->
          <div class="pre-footer-card__content">
            {% if block.settings.tag != blank %}
              <span class="pre-footer-card__tag" style="color: {{ block.settings.tag_color | default: '#a22938' }};">
                {{ block.settings.tag }}
              </span>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="pre-footer-card__title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="pre-footer-card__text">{{ block.settings.text }}</p>
            {% endif %}

            <!-- Dynamic Swatches (Optional overlay if color swatches are supplied) -->
            {% if block.settings.color_list != blank %}
              {% assign colors = block.settings.color_list | split: "," %}
              <div class="pre-footer-swatches">
                {% for hex in colors %}
                  <span class="pre-footer-swatch" style="background-color: {{ hex | strip }};"></span>
                {% endfor %}
              </div>
            {% endif %}

            <!-- Action Buttons -->
            <div class="pre-footer-card__actions">
              {% if block.settings.btn_1_link != blank %}
                <a href="{{ block.settings.btn_1_link }}" class="hub-btn hub-btn--primary">
                  {{ block.settings.btn_1_text | default: "Learn More" }}
                </a>
              {% endif %}

              {% if block.settings.btn_2_link != blank %}
                <a href="{{ block.settings.btn_2_link }}" class="hub-btn hub-btn--secondary" {% if block.settings.btn_2_is_pdf %}target="_blank"{% endif %}>
                  {{ block.settings.btn_2_text | default: "Download Spec PDF ➔" }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% comment %} DEFAULT FALLBACK CARDS {% endcomment %}
      <div class="pre-footer-card animate-on-scroll">
        <div class="pre-footer-card__content">
          <span class="pre-footer-card__tag">Support & Specs</span>
          <h3 class="pre-footer-card__title">Technical Support & PDF Manuals</h3>
          <p class="pre-footer-card__text">Download product specification sheets or contact our service team.</p>
          <div class="pre-footer-card__actions">
            <a href="#" class="hub-btn hub-btn--primary">Get Support</a>
            <a href="#" class="hub-btn hub-btn--secondary">Download PDFs ➔</a>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const observerOptions = { threshold: 0.15 };
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('#PreFooterHub-{{ section.id }} .animate-on-scroll').forEach(el => {
      observer.observe(el);
    });
  });
</script>

{% schema %}
{
  "name": "Pre-Footer Hub",
  "tag": "section",
  "class": "section-pre-footer-hub",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Section Title",
      "default": "Customization & Support Hub"
    }
  ],
  "blocks": [
    {
      "type": "hub_card",
      "name": "Hub Bento Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Background / Product Image"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image Display Mode",
          "options": [
            { "value": "cover", "label": "Full Card Cover (Fondo completo)" },
            { "value": "contain", "label": "Contain Product (Ajustar producto)" }
          ],
          "default": "cover"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Dark Overlay Opacity",
          "default": 10
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Card Tag",
          "default": "New Colors"
        },
        {
          "type": "color",
          "id": "tag_color",
          "label": "Tag Color",
          "default": "#a22938"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "New Colors for Beds & Stools"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Explore our latest premium upholstery options tailored for clinical spaces."
        },
        {
          "type": "text",
          "id": "color_list",
          "label": "Color Swatches Hex List (Comma separated)",
          "default": "#ffffff, #191919, #4c4c4c, #1b1e2e",
          "info": "Example: #ffffff, #000000, #a22938"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background Color",
          "default": "#f5f5f7"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#1d1d1f"
        },
        {
          "type": "text",
          "id": "btn_1_text",
          "label": "Primary Button Text",
          "default": "Explore Customization"
        },
        {
          "type": "url",
          "id": "btn_1_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "btn_2_text",
          "label": "Secondary Button Text",
          "default": "Download Specs PDF ➔"
        },
        {
          "type": "url",
          "id": "btn_2_link",
          "label": "Secondary Button Link"
        },
        {
          "type": "checkbox",
          "id": "btn_2_is_pdf",
          "label": "Open Secondary Link in New Tab (PDF)",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pre-Footer Hub",
      "blocks": [
        {
          "type": "hub_card",
          "settings": {
            "tag": "Technical Support",
            "title": "Need Guides or PDF Spec Sheets?",
            "text": "Access manuals, warranty forms, or speak directly with our tech support."
          }
        },
        {
          "type": "hub_card",
          "settings": {
            "tag": "Customization",
            "title": "New Colors for Beds & Stools",
            "text": "Upgrade your spa clinic aesthetic with our vibrant new upholstery finishes."
          }
        }
      ]
    }
  ]
}
{% endschema %}