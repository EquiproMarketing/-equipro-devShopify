{{ 'custom-assistance-hub.css' | asset_url | stylesheet_tag }}

<section class="assistance-hub-section" id="assistance-hub-{{ section.id }}">
  <div class="page-width">
    
    {%- comment -%} 1. HEADER & SEARCH BAR {%- endcomment -%}
    <div class="assistance-hub__header">
      {%- if section.settings.title != blank -%}
        <h1 class="assistance-hub__title">{{ section.settings.title | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="assistance-hub__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- comment -%} SEARCH BAR {%- endcomment -%}
      <div class="assistance-hub__search-wrapper">
        <form action="{{ routes.search_url }}" method="get" role="search" class="assistance-hub__search-form">
          <input type="hidden" name="type" value="article,page">
          <svg class="assistance-hub__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#86868b" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            name="q" 
            class="assistance-hub__search-input" 
            placeholder="{{ section.settings.search_placeholder | escape }}"
            autocomplete="off"
          >
        </form>
      </div>
    </div>

    {%- comment -%} 2. PRODUCT CATEGORY ICONS {%- endcomment -%}
    {%- assign icon_blocks = section.blocks | where: 'type', 'category_icon' -%}
    {%- if icon_blocks.size > 0 -%}
      <div class="assistance-hub__categories">
        <div class="assistance-hub__categories-list">
          {%- for block in icon_blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="assistance-category-item" {{ block.shopify_attributes }}>
              <div class="assistance-category-item__icon-wrapper">
                {%- if block.settings.icon_image != blank -%}
                  <img src="{{ block.settings.icon_image | image_url: width: 120 }}" alt="{{ block.settings.label | escape }}" loading="lazy" class="assistance-category-item__img">
                {%- else -%}
                  <svg class="assistance-category-item__svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1d1d1f" stroke-width="1.5">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                {%- endif -%}
              </div>
              <span class="assistance-category-item__label">{{ block.settings.label }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 3. QUICK HELP CARDS (WHITE ROUNDED CONTAINERS) {%- endcomment -%}
    {%- assign quick_help_blocks = section.blocks | where: 'type', 'quick_help_card' -%}
    {%- if quick_help_blocks.size > 0 -%}
      <div class="assistance-hub__quick-cards">
        {%- for block in quick_help_blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="assistance-quick-card" {{ block.shopify_attributes }}>
            <div class="assistance-quick-card__icon-badge">
              {%- if block.settings.icon_svg != blank -%}
                {{ block.settings.icon_svg }}
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ab273b" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
              {%- endif -%}
            </div>
            <h3 class="assistance-quick-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="assistance-quick-card__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} 4. SAFETY & GENUINE PARTS NOTICE {%- endcomment -%}
    {%- if section.settings.show_notice -%}
      <div class="assistance-hub__notice-card">
        <div class="assistance-hub__notice-content">
          <h2 class="assistance-hub__notice-title">{{ section.settings.notice_title | escape }}</h2>
          <p class="assistance-hub__notice-text">{{ section.settings.notice_text | escape }}</p>
          {%- if section.settings.notice_link_text != blank -%}
            <a href="{{ section.settings.notice_link_url | default: '#' }}" class="assistance-hub__notice-link">
              {{ section.settings.notice_link_text | escape }} &rarr;
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 5. TRENDING GUIDES & MAINTENANCE BLOGS {%- endcomment -%}
    {%- if section.settings.blog != blank and section.settings.blog.articles.size > 0 -%}
      <div class="assistance-hub__blog-section">
        <h2 class="assistance-hub__section-title">{{ section.settings.blog_title | escape }}</h2>
        
        <div class="assistance-hub__blog-grid">
          {%- for article in section.settings.blog.articles limit: section.settings.articles_to_show -%}
            <a href="{{ article.url }}" class="assistance-blog-card">
              <div class="assistance-blog-card__image-wrapper">
                {%- if article.image != blank -%}
                  <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" class="assistance-blog-card__img">
                {%- else -%}
                  <div class="assistance-blog-card__placeholder"></div>
                {%- endif -%}
              </div>
              <div class="assistance-blog-card__content">
                <h3 class="assistance-blog-card__title">{{ article.title }}</h3>
                <div class="assistance-blog-card__meta">
                  <span class="assistance-blog-card__date">{{ article.published_at | date: "%b %d, %Y" }}</span>
                  <span class="assistance-blog-card__read-time">
                    {%- assign words = article.content | strip_html | split: ' ' | size -%}
                    {{ words | divided_by: 200 | plus: 1 }} min read
                  </span>
                </div>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Assistance Hub",
  "tag": "section",
  "class": "section-assistance-hub",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Equipro Support"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Need help? Start here to find guides, manuals, and troubleshooting."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder Text",
      "default": "Search support, manuals, or replacement parts..."
    },
    {
      "type": "header",
      "content": "Notice Banner Settings"
    },
    {
      "type": "checkbox",
      "id": "show_notice",
      "label": "Show Notice Card",
      "default": true
    },
    {
      "type": "text",
      "id": "notice_title",
      "label": "Notice Title",
      "default": "Genuine Parts & Maintenance Security"
    },
    {
      "type": "textarea",
      "id": "notice_text",
      "label": "Notice Text",
      "default": "Always insist on genuine Equipro replacement bulbs, motors, and accessories. Using non-certified components can invalidate your warranty and compromise safety standards."
    },
    {
      "type": "text",
      "id": "notice_link_text",
      "label": "Notice Link Label",
      "default": "Download PDF Certificate"
    },
    {
      "type": "url",
      "id": "notice_link_url",
      "label": "Notice Link URL"
    },
    {
      "type": "header",
      "content": "Trending Guides / Blog Section"
    },
    {
      "type": "text",
      "id": "blog_title",
      "label": "Blog Section Title",
      "default": "Trending Guides & Tips"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Support Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 6,
      "step": 2,
      "label": "Articles to Show",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "category_icon",
      "name": "Product Category Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Category Icon Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category Label",
          "default": "Facial Steamers"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    },
    {
      "type": "quick_help_card",
      "name": "Quick Help Card",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG Icon (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Assembly Manuals"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Card Description",
          "default": "Download step-by-step PDF setup guides for all treatment tables and units."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Assistance Hub",
      "blocks": [
        { "type": "category_icon", "settings": { "label": "Treatment Beds" } },
        { "type": "category_icon", "settings": { "label": "Facial Steamers" } },
        { "type": "category_icon", "settings": { "label": "Mag Lamps" } },
        { "type": "category_icon", "settings": { "label": "Trolleys" } },
        {
          "type": "quick_help_card",
          "settings": {
            "title": "Shipping & Delivery",
            "description": "Track orders, shipping timelines, and freight delivery procedures."
          }
        },
        {
          "type": "quick_help_card",
          "settings": {
            "title": "Assembly & Setup Manuals",
            "description": "Download setup guides and wiring diagrams for your equipment."
          }
        },
        {
          "type": "quick_help_card",
          "settings": {
            "title": "Warranty & Repairs",
            "description": "Submit a technical support request or register product warranties."
          }
        }
      ]
    }
  ]
}
{% endschema %}