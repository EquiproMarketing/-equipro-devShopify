{{ 'section-subcategories-grid.css' | asset_url | stylesheet_tag }}

<div class="subcategories page-width" id="SubcategoriesGrid-{{ section.id }}">
  <div class="subcategories__top-bar">
    <div class="subcategories__back">
      <a href="javascript:history.back()" class="back-link">
        <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ section.settings.back_text | default: "Back" }}</span>
      </a>
    </div>

    <div class="subcategories__header">
      <h1 class="subcategories__title">
        {{ section.settings.title | default: collection.title | default: "Treatment Tables" }}
      </h1>
    </div>

    <div class="subcategories__spacer"></div>
  </div>

  <div class="subcategories__grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign img_fit = block.settings.image_fit | default: "cover" %}
        {% assign img_size = block.settings.image_size | default: 100 %}
        {% assign title_size = block.settings.title_font_size | default: 28 %}
        {% assign title_color = block.settings.title_color | default: "#000000" %}
        {% assign title_bg = block.settings.title_bg_color | default: "#ffffff" %}
        {% assign title_bg_opacity = block.settings.title_bg_opacity | default: 0 | divided_by: 100.0 %}
        {% assign shadow_color = block.settings.shadow_color | default: "rgba(0,0,0,0.3)" %}
        {% assign shadow_blur = block.settings.shadow_blur | default: 8 %}
        {% assign shadow_y = block.settings.shadow_offset_y | default: 4 %}

        <a 
          href="{{ block.settings.link | default: '#' }}" 
          class="bento-tile bento-tile--fit-{{ img_fit }}" 
          style="
            --tile-bg: {{ block.settings.bg_color | default: '#e8e8ed' }};
            --tile-title-size: {{ title_size }}px;
            --tile-title-color: {{ title_color }};
            --tile-shadow-color: {{ shadow_color }};
            --tile-shadow-blur: {{ shadow_blur }}px;
            --tile-shadow-y: {{ shadow_y }}px;
            --tile-img-size: {{ img_size }}%;
          "
          {{ block.shopify_attributes }}
        >
          <div class="bento-tile__header">
            <h2 class="bento-tile__title {% if block.settings.enable_text_shadow %}bento-tile__title--shadow{% endif %}">
              {{ block.settings.title }}
            </h2>
          </div>

          <div class="bento-tile__media">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 1000 }}" 
                alt="{{ block.settings.title | escape }}" 
                class="bento-tile__image" 
                loading="lazy" 
                width="500" 
                height="500"
              >
            {% else %}
              <div class="bento-tile__placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'bento-tile__svg' }}
              </div>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% assign default_titles = "Electric, Hydraulic / Mechanical, Portable" | split: "," %}
      {% for title in default_titles %}
        <a href="#" class="bento-tile">
          <div class="bento-tile__header">
            <h2 class="bento-tile__title">{{ title | strip }}</h2>
          </div>
          <div class="bento-tile__media">
            <div class="bento-tile__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'bento-tile__svg' }}
            </div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Subcategories Bento Grid",
  "tag": "section",
  "class": "section-subcategories-grid",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Link Text",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Category Title",
      "default": "Treatment Tables"
    }
  ],
  "blocks": [
    {
      "type": "subcategory",
      "name": "Bento Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Subcategory Title",
          "default": "Electric"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Subcategory Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product / Category Image"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "title_font_size",
          "min": 18,
          "max": 42,
          "step": 1,
          "unit": "px",
          "label": "Title Font Size",
          "default": 28
        },
        {
          "type": "color",
          "id": "title_bg_color",
          "label": "Title Background Box Color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "title_bg_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Title Background Box Opacity",
          "default": 0,
          "info": "Set to 0% for transparent background."
        },
        {
          "type": "checkbox",
          "id": "enable_text_shadow",
          "label": "Enable Custom Text Shadow",
          "default": false
        },
        {
          "type": "color",
          "id": "shadow_color",
          "label": "Shadow Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "shadow_blur",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Shadow Blur / Softness",
          "default": 8
        },
        {
          "type": "range",
          "id": "shadow_offset_y",
          "min": -10,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Shadow Vertical Offset (Y)",
          "default": 4
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image Fit Mode",
          "options": [
            { "value": "cover", "label": "Full Bleed / Cover" },
            { "value": "contain", "label": "Fit Complete Image (Contain)" }
          ],
          "default": "cover"
        },
        {
          "type": "range",
          "id": "image_size",
          "min": 50,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Image Scale / Width",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subcategories Bento Grid",
      "blocks": [
        { "type": "subcategory", "settings": { "title": "Electric" } },
        { "type": "subcategory", "settings": { "title": "Hydraulic / Mechanical" } },
        { "type": "subcategory", "settings": { "title": "Portable" } }
      ]
    }
  ]
}
{% endschema %}