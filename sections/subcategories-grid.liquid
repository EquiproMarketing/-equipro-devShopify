{{ 'section-subcategories-grid.css' | asset_url | stylesheet_tag }}

<div class="subcategories-wrapper page-width" id="SubcategoriesGrid-{{ section.id }}">
  <!-- Back Button -->
  <div class="subcategories__back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{{ section.settings.back_text | default: "Back" }}</span>
    </a>
  </div>

  <div class="subcategories__container">
    <!-- Header -->
    <div class="subcategories__header">
      <h1 class="subcategories__title">
        {{ section.settings.title | default: collection.title | default: "Treatment Tables" }}
      </h1>
    </div>

    <!-- Modular Grid (3 Columns) -->
    <div class="subcategories__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a href="{{ block.settings.link | default: '#' }}" class="subcategory-tile" {{ block.shopify_attributes }}>
            <div class="subcategory-tile__bg">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="subcategory-tile__img" loading="lazy" width="400" height="300">
              {% else %}
                <div class="subcategory-tile__placeholder"></div>
              {% endif %}
              <div class="subcategory-tile__overlay"></div>
            </div>
            <div class="subcategory-tile__content">
              <span class="subcategory-tile__name">{{ block.settings.title }}</span>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% comment %} FALLBACK TILES FOR THEME EDITOR PREVIEW {% endcomment %}
        {% assign default_titles = "Electric, Hydraulic / Mechanical, Portable" | split: "," %}
        {% for title in default_titles %}
          <a href="#" class="subcategory-tile">
            <div class="subcategory-tile__bg">
              <div class="subcategory-tile__placeholder"></div>
              <div class="subcategory-tile__overlay"></div>
            </div>
            <div class="subcategory-tile__content">
              <span class="subcategory-tile__name">{{ title | strip }}</span>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Subcategories Grid",
  "tag": "section",
  "class": "section-subcategories-grid",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Link Text",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Category Title Override",
      "info": "Leave empty to use Collection Title"
    }
  ],
  "blocks": [
    {
      "type": "subcategory",
      "name": "Subcategory Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Subcategory Name",
          "default": "Electric"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Subcategory Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Subcategory Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subcategories Grid",
      "blocks": [
        {
          "type": "subcategory",
          "settings": { "title": "Electric" }
        },
        {
          "type": "subcategory",
          "settings": { "title": "Hydraulic / Mechanical" }
        },
        {
          "type": "subcategory",
          "settings": { "title": "Portable" }
        }
      ]
    }
  ]
}
{% endschema %}