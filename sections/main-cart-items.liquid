{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

<div class="page-width product-page" style="max-width: 1000px; margin: 0 auto; padding: 40px 20px;">
  <h1 style="font-size: 2.2rem; font-weight: 700; color: #1d1d1f; margin-bottom: 30px;">Shopping Cart</h1>

  <div id="main-cart-container">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="main-cart-form">
        <div style="display: flex; flex-direction: column; gap: 20px;">
          {% for item in cart.items %}
            <div class="cart-page-item" data-line-item-key="{{ item.key }}" style="display: flex; gap: 20px; border-bottom: 1px solid #e5e5e7; padding-bottom: 20px; align-items: center; transition: opacity 0.2s ease;">
              
              <!-- IMAGEN -->
              <div style="width: 100px; height: 100px; border-radius: 12px; overflow: hidden; background: #f5f5f7; flex-shrink: 0; border: 1px solid #e5e5e7;">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% endif %}
              </div>

              <!-- DETALLES -->
              <div style="flex: 1;">
                <a href="{{ item.url }}" style="font-size: 1.1rem; font-weight: 600; color: #1d1d1f; text-decoration: none; display: block;">
                  {{ item.product.title }}
                </a>

                {% unless item.product.has_only_default_variant %}
                  <div style="font-size: 0.88rem; color: #6e6e73; margin-top: 4px;">
                    {% for option in item.options_with_values %}
                      <span>{{ option.name }}: <strong>{{ option.value }}</strong></span>{% unless forloop.last %} &bull; {% endunless %}
                    {% endfor %}
                  </div>
                {% endunless %}

                <div style="font-size: 1.05rem; font-weight: 700; color: #ab273b; margin-top: 8px;">
                  {{ item.final_line_price | money }}
                </div>
              </div>

              <!-- CANTIDAD -->
              <div style="display: flex; align-items: center; border: 1px solid #d2d2d7; border-radius: 6px; overflow: hidden; height: 36px; background: #ffffff;">
                <button type="button" class="js-qty-change" data-key="{{ item.key }}" data-action="minus" style="background: none; border: none; padding: 0 12px; cursor: pointer; color: #1d1d1f; font-size: 1rem; height: 100%; display: flex; align-items: center;">−</button>
                <input type="number" value="{{ item.quantity }}" readonly style="width: 36px; border: none; text-align: center; font-size: 0.9rem; font-weight: 600; color: #1d1d1f; -moz-appearance: textfield; padding: 0;">
                <button type="button" class="js-qty-change" data-key="{{ item.key }}" data-action="plus" style="background: none; border: none; padding: 0 12px; cursor: pointer; color: #1d1d1f; font-size: 1rem; height: 100%; display: flex; align-items: center;">+</button>
              </div>

              <!-- BOTÓN REMOVE CON AJAX (EVITA NAVEGACIÓN Y APERTURA DE DRAWER) -->
              <button type="button" class="js-remove-cart-item" data-key="{{ item.key }}" style="background: none; border: none; color: #86868b; font-size: 0.85rem; text-decoration: underline; margin-left: 12px; cursor: pointer; padding: 0;">
                Remove
              </button>
            </div>
          {% endfor %}
        </div>

        <!-- SUBTOTAL Y CHECKOUT -->
        <div style="margin-top: 30px; display: flex; flex-direction: column; align-items: flex-end; gap: 12px;">
          <div style="font-size: 1.25rem; font-weight: 700; color: #1d1d1f;">
            Subtotal: <span id="cart-subtotal" style="color: #ab273b;">{{ cart.total_price | money }}</span>
          </div>
          <p style="font-size: 0.85rem; color: #6e6e73; margin: 0;">Taxes and shipping calculated at checkout.</p>
          
          <div style="display: flex; gap: 12px; margin-top: 10px;">
            <button type="submit" name="checkout" class="product-add-cart-btn" style="height: 44px; padding: 0 32px; cursor: pointer; border-radius: 22px;">CHECKOUT</button>
          </div>
        </div>
      </form>
    {% else %}
      <div style="text-align: center; padding: 60px 0;">
        <p style="font-size: 1.1rem; color: #6e6e73;">Your cart is currently empty.</p>
        <a href="/collections/all" class="product-add-cart-btn" style="display: inline-block; line-height: 44px; text-decoration: none; padding: 0 24px; margin-top: 16px; border-radius: 22px;">Continue Shopping</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] { -moz-appearance: textfield; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Función para actualizar ítem vía AJAX
    function updateCartItem(idKey, newQty) {
      fetch(window.Shopify.routes.root + 'cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: idKey, quantity: newQty })
      })
      .then(res => res.json())
      .then(cart => {
        // Recargar suavemente para sincronizar subtotales y estado
        window.location.reload();
      })
      .catch(err => console.error('Error updating cart:', err));
    }

    // Interceptar botones de eliminación
    document.querySelectorAll('.js-remove-cart-item').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation(); // Detener cualquier evento que intente abrir el drawer

        const key = btn.getAttribute('data-key');
        const itemRow = btn.closest('.cart-page-item');
        if (itemRow) itemRow.style.opacity = '0.3'; // Feedback visual inmediato

        updateCartItem(key, 0);
      });
    });

    // Interceptar botones + y -
    document.querySelectorAll('.js-qty-change').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const key = btn.getAttribute('data-key');
        const action = btn.getAttribute('data-action');
        const input = btn.parentElement.querySelector('input');
        let currentVal = parseInt(input.value) || 0;
        
        let newQty = action === 'plus' ? currentVal + 1 : currentVal - 1;
        if (newQty < 0) newQty = 0;

        updateCartItem(key, newQty);
      });
    });
  });
</script>

{% schema %}
{
  "name": "Main Cart Items",
  "settings": [],
  "presets": [{ "name": "Main Cart Items" }]
}
{% endschema %}