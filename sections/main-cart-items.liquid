{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

<div class="page-width product-page" style="max-width: 1000px; margin: 0 auto; padding: 40px 20px;">
  <h1 style="font-size: 2.2rem; font-weight: 700; color: #1d1d1f; margin-bottom: 30px;">Shopping Cart</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <div style="display: flex; flex-direction: column; gap: 20px;">
        {% for item in cart.items %}
          <div style="display: flex; gap: 20px; border-bottom: 1px solid #e5e5e7; padding-bottom: 20px; align-items: center;">
            <div style="width: 100px; height: 100px; border-radius: 12px; overflow: hidden; background: #f5f5f7; flex-shrink: 0; border: 1px solid #e5e5e7;">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
              {% endif %}
            </div>

            <div style="flex: 1;">
              <a href="{{ item.url }}" style="font-size: 1.05rem; font-weight: 600; color: #1d1d1f; text-decoration: none;">{{ item.product.title }}</a>
              {% unless item.product.has_only_default_variant %}
                <p style="font-size: 0.85rem; color: #6e6e73; margin: 4px 0 0 0;">{{ item.variant.title }}</p>
              {% endunless %}
              <div style="font-size: 1rem; font-weight: 700; color: #ab273b; margin-top: 8px;">{{ item.final_line_price | money }}</div>
            </div>

            <div class="product-quantity" style="height: 38px;">
              <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" style="width: 50px; text-align: center; border: 1px solid #d2d2d7; border-radius: 4px;">
            </div>

            <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="color: #86868b; font-size: 0.85rem; text-decoration: underline; margin-left: 10px;">Remove</a>
          </div>
        {% endfor %}
      </div>

      <div style="margin-top: 30px; display: flex; flex-direction: column; align-items: flex-end; gap: 12px;">
        <div style="font-size: 1.25rem; font-weight: 700; color: #1d1d1f;">
          Subtotal: <span style="color: #ab273b;">{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size: 0.85rem; color: #6e6e73; margin: 0;">Taxes and shipping calculated at checkout.</p>
        
        <div style="display: flex; gap: 12px; margin-top: 10px;">
          <button type="submit" name="update" class="product-compare-trigger-btn" style="height: 44px; padding: 0 20px; cursor: pointer;">Update Cart</button>
          <button type="submit" name="checkout" class="product-add-cart-btn" style="height: 44px; padding: 0 30px; cursor: pointer;">Checkout</button>
        </div>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 60px 0;">
      <p style="font-size: 1.1rem; color: #6e6e73;">Your cart is currently empty.</p>
      <a href="/collections/all" class="product-add-cart-btn" style="display: inline-block; line-height: 44px; text-decoration: none; padding: 0 24px; margin-top: 16px;">Continue Shopping</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main Cart Items",
  "settings": [],
  "presets": [
    {
      "name": "Main Cart Items"
    }
  ]
}
{% endschema %}