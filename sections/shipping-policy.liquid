{{ 'section-shipping.css' | asset_url | stylesheet_tag }}

<div class="shipping-page page-width">
<div class="shipping-page__nav-back">
    <a href="/pages/assistance" class="shipping-back-link">&larr; Back to Support Hub</a>
  </div>
  
  <h1 class="shipping-page__title">{{ section.settings.title }}</h1>

  {% if section.settings.banner_image != blank %}
    <div class="shipping-page__banner">
      {{ section.settings.banner_image | image_url: width: 1600 | image_tag: 
        class: 'shipping-banner__img', 
        alt: section.settings.title,
        loading: 'eager' 
      }}
    </div>
  {% endif %}

  <div class="shipping-page__intro rte">
    <p>At Equipro Beauty, we strive to deliver your order as quickly and efficiently as possible. Most orders are processed within <strong>2–4 business days</strong> and shipped from Canada or our US division.</p>
    <p>Customers in Quebec can generally expect delivery within <strong>1–3 business days after shipment</strong>, while deliveries to other Canadian provinces typically arrive within <strong>3–7 business days</strong>. A tracking number will be provided once your order is on its way, allowing you to monitor its journey in real time.</p>
    <p class="shipping-disclaimer">Please note that delivery estimates may vary due to carrier schedules, weather conditions, remote locations, or other factors outside our control.</p>
  </div>

  {%- comment -%} SHIPPING CALCULATOR CARD {%- endcomment -%}
  <div class="shipping-simulators">
    <div class="shipping-card">
      <h3>Estimate Transit Time</h3>
      <p class="shipping-card__sub">Select your destination country and province or state to calculate estimated processing and ground transit times.</p>
      
      <form id="EquiproShippingForm" class="shipping-form">
        <select id="ShippingCountry" class="shipping-select" required>
          <option value="" disabled selected>Select Country</option>
          <option value="CA">Canada (Montreal Hub)</option>
          <option value="US">United States (Isle La Motte Hub)</option>
        </select>

        <select id="ShippingRegion" class="shipping-select" required disabled>
          <option value="" disabled selected>Select Province / State</option>
        </select>

        <button type="submit" class="hero-btn">CALCULATE</button>
      </form>

      <div id="ShippingResult" class="shipping-result"></div>
      
      <p class="shipping-card__footer-note">*Estimated transit times provided are estimates only and are based on standard carrier schedules. Actual delivery times may vary due to carrier delays, weather conditions, volume spikes, or other operational factors outside of our control. Processing time for order packing remains subject to official quote confirmation.</p>
    </div>
  </div>
</div>

{%- comment -%} DYNAMIC REGIONS POPULATOR {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const countrySelect = document.getElementById('ShippingCountry');
    const regionSelect = document.getElementById('ShippingRegion');

    const regions = {
      CA: [
        { code: 'QC', name: 'Quebec' },
        { code: 'ON', name: 'Ontario' },
        { code: 'NB', name: 'New Brunswick' },
        { code: 'NS', name: 'Nova Scotia' },
        { code: 'PE', name: 'Prince Edward Island' },
        { code: 'NL', name: 'Newfoundland and Labrador' },
        { code: 'MB', name: 'Manitoba' },
        { code: 'SK', name: 'Saskatchewan' },
        { code: 'AB', name: 'Alberta' },
        { code: 'BC', name: 'British Columbia' }
      ],
      US: [
        { code: 'VT', name: 'Vermont' },
        { code: 'NY', name: 'New York' },
        { code: 'MA', name: 'Massachusetts' },
        { code: 'ME', name: 'Maine' },
        { code: 'NH', name: 'New Hampshire' },
        { code: 'CT', name: 'Connecticut' },
        { code: 'RI', name: 'Rhode Island' },
        { code: 'NJ', name: 'New Jersey' },
        { code: 'PA', name: 'Pennsylvania' },
        { code: 'FL', name: 'Florida' },
        { code: 'TX', name: 'Texas' },
        { code: 'CA', name: 'California' },
        { code: 'DEFAULT', name: 'Other US State' }
      ]
    };

    countrySelect.addEventListener('change', (e) => {
      const selectedCountry = e.target.value;
      regionSelect.innerHTML = '<option value="" disabled selected>Select Province / State</option>';

      if (regions[selectedCountry]) {
        regions[selectedCountry].forEach((reg) => {
          const opt = document.createElement('option');
          opt.value = reg.code;
          opt.textContent = reg.name;
          regionSelect.appendChild(opt);
        });
        regionSelect.disabled = false;
      } else {
        regionSelect.disabled = true;
      }
    });
  });
</script>

<script src="{{ 'shipping-calculator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Shipping Policy & Calc",
  "tag": "section",
  "class": "section-shipping-policy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Shipping & Delivery Policy"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Header Banner Image"
    }
  ],
  "presets": [
    {
      "name": "Shipping Policy & Calc"
    }
  ]
}
{% endschema %}