{{ 'section-shipping.css' | asset_url | stylesheet_tag }}

<div class="shipping-page page-width">
<div class="shipping-page__nav-back">
    <a href="{{ routes.root_url }}pages/assistance" class="shipping-back-link">&larr; {{ 'delivery.back' | t }}</a>
  </div>
  
  <h1 class="shipping-page__title">{{ section.settings.title }}</h1>

  {% if section.settings.banner_image != blank %}
    <div class="shipping-page__banner">
      {{ section.settings.banner_image | image_url: width: 1600 | image_tag: 
        class: 'shipping-banner__img', 
        alt: section.settings.title,
        loading: 'eager' 
      }}
    </div>
  {% endif %}

  <div class="shipping-page__intro rte">
    {{ section.settings.intro }}
  </div>

  {%- comment -%} SHIPPING CALCULATOR CARD {%- endcomment -%}
  <div class="shipping-simulators">
    <div class="shipping-card">
      <h3>{{ 'delivery.heading' | t }}</h3>
      <p class="shipping-card__sub">{{ 'delivery.intro' | t }}</p>
      
      <form id="EquiproShippingForm" class="shipping-form">
        <select id="ShippingCountry" class="shipping-select" required>
          <option value="" disabled selected>{{ 'delivery.country' | t }}</option>
          <option value="CA">{{ 'delivery.canada_destination' | t }}</option>
          <option value="US">{{ 'delivery.us_destination' | t }}</option>
        </select>

        <select id="ShippingRegion" class="shipping-select" required disabled>
          <option value="" disabled selected>{{ 'delivery.region' | t }}</option>
        </select>

        <button type="submit" class="hero-btn">{{ 'delivery.calculate' | t }}</button>
      </form>

      <div id="ShippingResult" class="shipping-result"></div>
      
      <p class="shipping-card__footer-note">{{ 'delivery.footer_note' | t }}</p>
    </div>
  </div>
</div>

{%- comment -%} DYNAMIC REGIONS POPULATOR {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const countrySelect = document.getElementById('ShippingCountry');
    const regionSelect = document.getElementById('ShippingRegion');

    const regions = {
      CA: [
        { code: 'QC', name: {{ 'delivery.regions.QC' | t | json }} },
        { code: 'ON', name: {{ 'delivery.regions.ON' | t | json }} },
        { code: 'NB', name: {{ 'delivery.regions.NB' | t | json }} },
        { code: 'NS', name: {{ 'delivery.regions.NS' | t | json }} },
        { code: 'PE', name: {{ 'delivery.regions.PE' | t | json }} },
        { code: 'NL', name: {{ 'delivery.regions.NL' | t | json }} },
        { code: 'MB', name: {{ 'delivery.regions.MB' | t | json }} },
        { code: 'SK', name: {{ 'delivery.regions.SK' | t | json }} },
        { code: 'AB', name: {{ 'delivery.regions.AB' | t | json }} },
        { code: 'BC', name: {{ 'delivery.regions.BC' | t | json }} }
      ],
      US: [
        { code: 'VT', name: {{ 'delivery.regions.VT' | t | json }} },
        { code: 'NY', name: {{ 'delivery.regions.NY' | t | json }} },
        { code: 'MA', name: {{ 'delivery.regions.MA' | t | json }} },
        { code: 'ME', name: {{ 'delivery.regions.ME' | t | json }} },
        { code: 'NH', name: {{ 'delivery.regions.NH' | t | json }} },
        { code: 'CT', name: {{ 'delivery.regions.CT' | t | json }} },
        { code: 'RI', name: {{ 'delivery.regions.RI' | t | json }} },
        { code: 'NJ', name: {{ 'delivery.regions.NJ' | t | json }} },
        { code: 'PA', name: {{ 'delivery.regions.PA' | t | json }} },
        { code: 'FL', name: {{ 'delivery.regions.FL' | t | json }} },
        { code: 'TX', name: {{ 'delivery.regions.TX' | t | json }} },
        { code: 'CA', name: {{ 'delivery.regions.CA' | t | json }} },
        { code: 'DEFAULT', name: {{ 'delivery.regions.other_us' | t | json }} }
      ]
    };

    countrySelect.addEventListener('change', (e) => {
      const selectedCountry = e.target.value;
      regionSelect.replaceChildren(new Option({{ 'delivery.region' | t | json }}, '', true, true));

      if (regions[selectedCountry]) {
        regions[selectedCountry].forEach((reg) => {
          const opt = document.createElement('option');
          opt.value = reg.code;
          opt.textContent = reg.name;
          regionSelect.appendChild(opt);
        });
        regionSelect.disabled = false;
      } else {
        regionSelect.disabled = true;
      }
    });
  });
</script>

<script src="{{ 'shipping-calculator.js' | asset_url }}" defer></script>
<script type="application/json" id="ShippingCalculatorLabels">{"estimate":{{ 'delivery.estimate_title' | t | json }},"origin":{{ 'delivery.origin' | t | json }},"processing":{{ 'delivery.processing' | t | json }},"transit":{{ 'delivery.transit' | t | json }},"total":{{ 'delivery.total' | t | json }},"businessDays":{{ 'delivery.business_days' | t | json }},"originCa":{{ 'delivery.origin_ca' | t | json }},"originUs":{{ 'delivery.origin_us' | t | json }},"range":{{ 'delivery.range' | t | json }}}</script>

{% schema %}
{
  "name": "Shipping Policy & Calc",
  "tag": "section",
  "class": "section-shipping-policy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Shipping & Delivery Policy"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Shipping policy introduction",
      "default": "<p>At Equipro Beauty, we strive to deliver your order as quickly and efficiently as possible. Most orders are processed within <strong>2–4 business days</strong> and shipped from Canada or our US division.</p><p>Customers in Quebec can generally expect delivery within <strong>1–3 business days after shipment</strong>, while deliveries to other Canadian provinces typically arrive within <strong>3–7 business days</strong>. A tracking number will be provided once your order is on its way, allowing you to monitor its journey in real time.</p><p>Please note that delivery estimates may vary due to carrier schedules, weather conditions, remote locations, or other factors outside our control.</p>"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Header Banner Image"
    }
  ],
  "presets": [
    {
      "name": "Shipping Policy & Calc"
    }
  ]
}
{% endschema %}
