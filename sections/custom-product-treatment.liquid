{{ 'custom-product-treatment.css' | asset_url | stylesheet_tag }}

<section class="custom-treatment-section" id="treatment-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-treatment-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="custom-treatment-grid">
      {%- for block in section.blocks -%}
        <div class="custom-treatment-card" {{ block.shopify_attributes }}>
          
          {%- comment -%} CONTENEDOR DE IMAGEN REDONDEADO ESTILO APPLE {%- endcomment -%}
          <div 
            class="custom-treatment-card__image-container"
            style="background-color: {{ block.settings.card_bg_color | default: '#f5f5f7' }};"
          >
            {%- if block.settings.product_image != blank -%}
              <img
                src="{{ block.settings.product_image | image_url: width: 500 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="240"
                height="240"
                class="custom-treatment-card__image"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
            {%- endif -%}
          </div>

          {%- comment -%} MUESTRAS DE COLOR (SWATCHES) {%- endcomment -%}
          <div class="custom-treatment-card__swatches">
            {%- assign colors = block.settings.available_colors | split: ',' -%}
            {%- for color_code in colors -%}
              {%- assign clean_color = color_code | strip -%}
              {%- if clean_color != blank -%}
                <span 
                  class="custom-treatment-card__swatch-dot" 
                  style="background-color: {{ clean_color }};"
                  title="{{ clean_color }}"
                ></span>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} DETALLES Y TEXTOS {%- endcomment -%}
          <div class="custom-treatment-card__content">
            <h3 class="custom-treatment-card__title">{{ block.settings.title }}</h3>
            
            {%- if block.settings.subtitle != blank -%}
              <p class="custom-treatment-card__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}

            {%- if block.settings.price != blank -%}
              <p class="custom-treatment-card__price">{{ block.settings.price }}</p>
            {%- endif -%}

            {%- comment -%} BOTONES DE ACCIÓN ROJOS (ESTILO APPLE) {%- endcomment -%}
            <div class="custom-treatment-card__actions">
              <a href="{{ block.settings.btn_primary_url | default: '#' }}" class="custom-treatment-btn custom-treatment-btn--primary">
                {{ block.settings.btn_primary_text | default: 'En savoir plus' }}
              </a>

              <a href="{{ block.settings.btn_secondary_url | default: '#' }}" class="custom-treatment-btn custom-treatment-btn--link">
                {{ block.settings.btn_secondary_text | default: 'Acheter >' }}
              </a>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Product Treatment",
  "tag": "section",
  "class": "section-custom-product-treatment",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Beds & Stools"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Background Color",
          "default": "#f5f5f7"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Name",
          "default": "Ultra-comfort"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Description",
          "default": "Parfaite alliée de votre pratique."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price Text",
          "default": "À partir de 1 299 $"
        },
        {
          "type": "textarea",
          "id": "available_colors",
          "label": "Color Swatches (HEX list separated by comma)",
          "default": "#ffffff, #111111, #808080"
        },
        {
          "type": "header",
          "content": "Primary Button (Red Pill)"
        },
        {
          "type": "text",
          "id": "btn_primary_text",
          "label": "Button Text",
          "default": "En savoir plus"
        },
        {
          "type": "url",
          "id": "btn_primary_url",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Secondary Link (Red Text)"
        },
        {
          "type": "text",
          "id": "btn_secondary_text",
          "label": "Link Text",
          "default": "Acheter >"
        },
        {
          "type": "url",
          "id": "btn_secondary_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Treatment",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}