{{ 'custom-product-treatment.css' | asset_url | stylesheet_tag }}

<section class="custom-treatment-section" id="treatment-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-treatment-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="custom-treatment-grid">
      {%- assign collection_target = section.settings.featured_collection -%}
      {%- assign products_limit = section.settings.products_to_show | default: 6 -%}

      {%- if collection_target != blank and collection_target.products.size > 0 -%}
        {%- for product in collection_target.products limit: products_limit -%}
          {%- comment -%} DYNAMIC PRODUCT VALUES FROM COLLECTION {%- endcomment -%}
          {%- assign display_title = product.title -%}
          {%- assign display_url = product.url -%}
          {%- assign display_image = product.featured_media -%}
          
          {%- assign hover_image = nil -%}
          {%- if product.media.size > 1 -%}
            {%- assign hover_image = product.media[1] -%}
          {%- endif -%}

          {%- capture display_price -%}
            {%- if product.price_varies -%}
              {{ 'products.product.from_lowest_price_html' | t: lowest_price: product.price_min | money }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          {%- endcapture -%}

          <div class="custom-treatment-card">
            {%- comment -%} APPLE-STYLE ROUNDED IMAGE CONTAINER (4:5 ASPECT RATIO) {%- endcomment -%}
            <div 
              class="custom-treatment-card__image-container"
              style="background-color: {{ section.settings.card_bg_color | default: '#f5f5f7' }};"
            >
              {%- if display_image != blank -%}
                <a href="{{ display_url }}" class="custom-treatment-card__image-link">
                  <img
                    src="{{ display_image | image_url: width: 600 }}"
                    alt="{{ display_title | escape }}"
                    loading="lazy"
                    width="240"
                    height="300"
                    class="custom-treatment-card__image {% if hover_image != blank %}custom-treatment-card__image--primary{% endif %}"
                  >
                  {%- if hover_image != blank -%}
                    <img
                      src="{{ hover_image | image_url: width: 600 }}"
                      alt="{{ display_title | escape }}"
                      loading="lazy"
                      width="240"
                      height="300"
                      class="custom-treatment-card__image custom-treatment-card__image--hover"
                    >
                  {%- endif -%}
                </a>
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
              {%- endif -%}
            </div>

            {%- comment -%} CARD DETAILS & TEXTS {%- endcomment -%}
            <div class="custom-treatment-card__content">
              <h3 class="custom-treatment-card__title">
                <a href="{{ display_url }}">{{ display_title }}</a>
              </h3>
              
              <p class="custom-treatment-card__subtitle">
                {{ product.vendor | default: section.settings.default_subtitle }}
              </p>

              <p class="custom-treatment-card__price">{{ display_price }}</p>

              {%- comment -%} ACTION BUTTONS {%- endcomment -%}
              <div class="custom-treatment-card__actions">
                <a href="{{ display_url }}" class="custom-treatment-btn custom-treatment-btn--primary">
                  {{ section.settings.btn_primary_text | default: 'Learn More' }}
                </a>

                <a href="{{ display_url }}" class="custom-treatment-btn custom-treatment-btn--link">
                  {{ section.settings.btn_secondary_text | default: 'Buy Now >' }}
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} FALLBACK PLACEHOLDER WHEN NO COLLECTION IS SELECTED {%- endcomment -%}
        {%- for i in (1..3) -%}
          <div class="custom-treatment-card">
            <div class="custom-treatment-card__image-container" style="background-color: #f5f5f7;">
              {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
            </div>
            <div class="custom-treatment-card__content">
              <h3 class="custom-treatment-card__title">Sample Treatment Bed</h3>
              <p class="custom-treatment-card__subtitle">Professional Spa Series</p>
              <p class="custom-treatment-card__price">$1,299.00</p>
              <div class="custom-treatment-card__actions">
                <a href="#" class="custom-treatment-btn custom-treatment-btn--primary">Learn More</a>
                <a href="#" class="custom-treatment-btn custom-treatment-btn--link">Buy Now ></a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Product Treatment",
  "tag": "section",
  "class": "section-custom-product-treatment",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Beds & Stools"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select Collection",
      "info": "Automatically fetches all products, titles, prices, images, and links from the selected collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 6
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f5f5f7"
    },
    {
      "type": "text",
      "id": "default_subtitle",
      "label": "Default Subtitle / Category Tag",
      "default": "Professional Treatment Series"
    },
    {
      "type": "header",
      "content": "Button Labels"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Text",
      "default": "Learn More"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary Button Text",
      "default": "Buy Now >"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Treatment"
    }
  ]
}
{% endschema %}