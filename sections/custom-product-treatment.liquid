{{ 'custom-product-treatment.css' | asset_url | stylesheet_tag }}

<section class="custom-treatment-section" id="treatment-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-treatment-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="custom-treatment-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- comment -%} VERIFICAR SI LA TARJETA ESTÁ OCULTA {%- endcomment -%}
          {%- if block.settings.hide_card == true -%}{%- continue -%}{%- endif -%}

          {%- assign product = block.settings.product -%}
          
          {%- comment -%} EXTRAER DATOS AUTOMÁTICOS DEL PRODUCTO CON OPCIÓN DE SOBRESCRIBIR {%- endcomment -%}
          {%- assign display_title = block.settings.title | default: product.title -%}
          {%- assign display_description = block.settings.description | default: product.description | strip_html | truncatewords: 10 -%}
          {%- assign display_url = product.url -%}
          {%- assign display_image = block.settings.custom_image | default: product.featured_media -%}
          
          {%- assign variant_id = product.selected_or_first_available_variant.id -%}
          {%- assign is_available = product.selected_or_first_available_variant.available -%}
          
          {%- assign hover_image = nil -%}
          {%- if block.settings.custom_hover_image != blank -%}
            {%- assign hover_image = block.settings.custom_hover_image -%}
          {%- elsif product.media.size > 1 -%}
            {%- assign hover_image = product.media[1] -%}
          {%- endif -%}

          {%- capture display_price -%}
            {%- if product.price_varies -%}
              {{ 'products.product.from_lowest_price_html' | t: lowest_price: product.price_min | money }}
            {%- elsif product.price != blank -%}
              {{ product.price | money }}
            {%- else -%}
              {{ block.settings.custom_price }}
            {%- endif -%}
          {%- endcapture -%}

          <div class="custom-treatment-card" {{ block.shopify_attributes }}>
            <!-- CONTENEDOR DE IMAGEN (ASPECT RATIO 4:5) -->
            <div 
              class="custom-treatment-card__image-container"
              style="background-color: {{ section.settings.card_bg_color | default: '#f5f5f7' }};"
            >
              {%- if display_image != blank -%}
                <a href="{{ display_url | default: '#' }}" class="custom-treatment-card__image-link">
                  <img
                    src="{{ display_image | image_url: width: 600 }}"
                    alt="{{ display_title | escape }}"
                    loading="lazy"
                    width="240"
                    height="300"
                    class="custom-treatment-card__image {% if hover_image != blank %}custom-treatment-card__image--primary{% endif %}"
                  >
                  {%- if hover_image != blank -%}
                    <img
                      src="{{ hover_image | image_url: width: 600 }}"
                      alt="{{ display_title | escape }}"
                      loading="lazy"
                      width="240"
                      height="300"
                      class="custom-treatment-card__image custom-treatment-card__image--hover"
                    >
                  {%- endif -%}
                </a>
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
              {%- endif -%}
            </div>

            <!-- CONTENIDO DE LA TARJETA -->
            <div class="custom-treatment-card__content">
              {%- if display_title != blank -%}
                <h3 class="custom-treatment-card__title">
                  {%- if display_url != blank -%}
                    <a href="{{ display_url }}">{{ display_title }}</a>
                  {%- else -%}
                    {{ display_title }}
                  {%- endif -%}
                </h3>
              {%- endif -%}
              
              <p class="custom-treatment-card__subtitle">
                {{ block.settings.subtitle | default: product.vendor | default: section.settings.default_subtitle }}
              </p>

              {%- if display_description != blank -%}
                <p class="custom-treatment-card__description">
                  {{ display_description }}
                </p>
              {%- endif -%}

              {%- if display_price != blank -%}
                <p class="custom-treatment-card__price">{{ display_price }}</p>
              {%- endif -%}

              <!-- BOTONES DE ACCIÓN (LEARN MORE + ADD TO CART AJAX) -->
              <div class="custom-treatment-card__actions">
                <a href="{{ display_url | default: '#' }}" class="custom-treatment-btn custom-treatment-btn--primary">
                  {{ section.settings.btn_primary_text | default: 'Learn More' }}
                </a>

                {%- if is_available and variant_id != blank -%}
                  <button 
                    type="button"
                    class="custom-treatment-btn custom-treatment-btn--add-to-cart js-add-to-cart-btn"
                    data-variant-id="{{ variant_id }}"
                  >
                    <span class="btn-text">{{ section.settings.btn_cart_text | default: 'Add to Cart' }}</span>
                    <span class="btn-spinner" style="display:none;">...</span>
                  </button>
                {%- else -%}
                  <button type="button" class="custom-treatment-btn custom-treatment-btn--disabled" disabled>
                    Sold Out
                  </button>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- FALLBACK SI AÚN NO SE HAN AGREGADO BLOQUES -->
        {%- for i in (1..4) -%}
          <div class="custom-treatment-card">
            <div class="custom-treatment-card__image-container" style="background-color: #f5f5f7;">
              {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
            </div>
            <div class="custom-treatment-card__content">
              <h3 class="custom-treatment-card__title">Sample Treatment Bed</h3>
              <p class="custom-treatment-card__subtitle">Professional Spa Series</p>
              <p class="custom-treatment-card__description">High-end ergonomic design for ultimate treatment comfort.</p>
              <p class="custom-treatment-card__price">$1,299.00</p>
              <div class="custom-treatment-card__actions">
                <a href="#" class="custom-treatment-btn custom-treatment-btn--primary">Learn More</a>
                <button type="button" class="custom-treatment-btn custom-treatment-btn--add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<!-- SCRIPT AJAX ADD TO CART -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.getElementById('treatment-section-{{ section.id }}');
    if (!sectionContainer) return;

    const cartBtns = sectionContainer.querySelectorAll('.js-add-to-cart-btn');

    cartBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const variantId = this.getAttribute('data-variant-id');
        if (!variantId) return;

        const textSpan = this.querySelector('.btn-text');
        const spinnerSpan = this.querySelector('.btn-spinner');
        const originalText = textSpan.textContent;

        this.disabled = true;
        textSpan.style.display = 'none';
        spinnerSpan.style.display = 'inline-block';

        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: 1
            }]
          })
        })
        .then(response => response.json())
        .then(data => {
          textSpan.textContent = 'Added! ✓';
          textSpan.style.display = 'inline-block';
          spinnerSpan.style.display = 'none';
          this.classList.add('is-added');

          if (document.querySelector('cart-notification')) {
            document.querySelector('cart-notification').renderContents(data);
          } else if (document.querySelector('cart-drawer')) {
            fetch(`${window.Shopify.routes.root}?sections=cart-drawer`)
              .then(res => res.json())
              .then(sections => {
                const drawer = document.querySelector('cart-drawer');
                if (drawer) {
                  drawer.renderContents(data);
                  drawer.open();
                }
              });
          }

          setTimeout(() => {
            textSpan.textContent = originalText;
            this.classList.remove('is-added');
            this.disabled = false;
          }, 2000);
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          textSpan.textContent = 'Error';
          textSpan.style.display = 'inline-block';
          spinnerSpan.style.display = 'none';
          this.disabled = false;
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Custom Product Treatment",
  "tag": "section",
  "class": "section-custom-product-treatment",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Beds & Stools"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f5f5f7"
    },
    {
      "type": "text",
      "id": "default_subtitle",
      "label": "Default Subtitle / Category Tag",
      "default": "Professional Treatment Series"
    },
    {
      "type": "header",
      "content": "Button Labels"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Text",
      "default": "Learn More"
    },
    {
      "type": "text",
      "id": "btn_cart_text",
      "label": "Add to Cart Button Text",
      "default": "Add to Cart"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "hide_card",
          "label": "Hide / Disable Card",
          "default": false,
          "info": "Check this box to temporarily hide this card from the store without deleting it."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product",
          "info": "Selecting a product fills title, price, description, images, and add-to-cart action automatically."
        },
        {
          "type": "header",
          "content": "Custom Overrides (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Custom Subtitle Override"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Custom Short Description Override",
          "info": "Leave blank to use the product summary."
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Price Override (text)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Primary Image"
        },
        {
          "type": "image_picker",
          "id": "custom_hover_image",
          "label": "Custom Hover Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Treatment",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}