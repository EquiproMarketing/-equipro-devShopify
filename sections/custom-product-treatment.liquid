{{ 'custom-product-treatment.css' | asset_url | stylesheet_tag }}

<section class="custom-treatment-section" id="treatment-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-treatment-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="custom-treatment-grid">
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.product -%}
        
        {%- comment -%} DYNAMIC PRODUCT DATA FALLBACKS {%- endcomment -%}
        {%- assign display_title = block.settings.title | default: card_product.title | default: 'Product Title' -%}
        {%- assign display_url = block.settings.btn_primary_url | default: card_product.url | default: '#' -%}
        {%- assign display_buy_url = block.settings.btn_secondary_url | default: card_product.url | default: '#' -%}
        
        {%- comment -%} PRICE RESOLUTION {%- endcomment -%}
        {%- if block.settings.price != blank -%}
          {%- assign display_price = block.settings.price -%}
        {%- elsif card_product != blank -%}
          {%- capture display_price -%}
            {%- if card_product.price_varies -%}
              {{ 'products.product.from_lowest_price_html' | t: lowest_price: card_product.price_min | money }}
            {%- else -%}
              {{ card_product.price | money }}
            {%- endif -%}
          {%- endcapture -%}
        {%- else -%}
          {%- assign display_price = 'À partir de 1 299 $' -%}
        {%- endif -%}

        {%- comment -%} IMAGE RESOLUTION {%- endcomment -%}
        {%- assign display_image = block.settings.product_image -%}
        {%- if display_image == blank and card_product.featured_media != blank -%}
          {%- assign display_image = card_product.featured_media -%}
        {%- endif -%}

        <div class="custom-treatment-card" {{ block.shopify_attributes }}>
          
          {%- comment -%} APPLE-STYLE ROUNDED IMAGE CONTAINER (4:5 ASPECT RATIO) {%- endcomment -%}
          <div 
            class="custom-treatment-card__image-container"
            style="background-color: {{ block.settings.card_bg_color | default: '#f5f5f7' }};"
          >
            {%- if display_image != blank -%}
              <a href="{{ display_url }}" class="custom-treatment-card__image-link">
                <img
                  src="{{ display_image | image_url: width: 600 }}"
                  alt="{{ display_title | escape }}"
                  loading="lazy"
                  width="240"
                  height="300"
                  class="custom-treatment-card__image"
                >
              </a>
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
            {%- endif -%}
          </div>

          {%- comment -%} COLOR SWATCHES {%- endcomment -%}
          <div class="custom-treatment-card__swatches">
            {%- assign colors = block.settings.available_colors | split: ',' -%}
            {%- for color_code in colors -%}
              {%- assign clean_color = color_code | strip -%}
              {%- if clean_color != blank -%}
                <span 
                  class="custom-treatment-card__swatch-dot" 
                  style="background-color: {{ clean_color }};"
                  title="{{ clean_color }}"
                ></span>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} CARD DETAILS AND TEXTS {%- endcomment -%}
          <div class="custom-treatment-card__content">
            <h3 class="custom-treatment-card__title">
              <a href="{{ display_url }}">{{ display_title }}</a>
            </h3>
            
            {%- if block.settings.subtitle != blank -%}
              <p class="custom-treatment-card__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}

            {%- if display_price != blank -%}
              <p class="custom-treatment-card__price">{{ display_price }}</p>
            {%- endif -%}

            {%- comment -%} ACTION BUTTONS {%- endcomment -%}
            <div class="custom-treatment-card__actions">
              <a href="{{ display_url }}" class="custom-treatment-btn custom-treatment-btn--primary">
                {{ block.settings.btn_primary_text | default: 'En savoir plus' }}
              </a>

              <a href="{{ display_buy_url }}" class="custom-treatment-btn custom-treatment-btn--link">
                {{ block.settings.btn_secondary_text | default: 'Acheter >' }}
              </a>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Product Treatment",
  "tag": "section",
  "class": "section-custom-product-treatment",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Beds & Stools"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "header",
          "content": "Product Selection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product",
          "info": "Pulls title, main image, price, and URL automatically from Shopify."
        },
        {
          "type": "header",
          "content": "Custom Overrides (Optional)"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Custom Image (Overrides product image)"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Background Color",
          "default": "#f5f5f7"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Product Name (Overrides product title)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Description",
          "default": "Parfaite alliée de votre pratique."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Custom Price Text (Overrides automatic product price)"
        },
        {
          "type": "textarea",
          "id": "available_colors",
          "label": "Color Swatches (HEX list separated by comma)",
          "default": "#ffffff, #111111, #808080"
        },
        {
          "type": "header",
          "content": "Primary Button"
        },
        {
          "type": "text",
          "id": "btn_primary_text",
          "label": "Button Text",
          "default": "En savoir plus"
        },
        {
          "type": "url",
          "id": "btn_primary_url",
          "label": "Custom Link (Overrides product URL)"
        },
        {
          "type": "header",
          "content": "Secondary Link"
        },
        {
          "type": "text",
          "id": "btn_secondary_text",
          "label": "Link Text",
          "default": "Acheter >"
        },
        {
          "type": "url",
          "id": "btn_secondary_url",
          "label": "Custom Link URL (Overrides product URL)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Treatment",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}