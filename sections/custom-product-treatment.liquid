{{ 'custom-product-treatment.css' | asset_url | stylesheet_tag }}

<section class="custom-treatment-section" id="treatment-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-treatment-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="custom-treatment-grid">
      {%- comment -%} 1. BLOQUES MANUALES (REORDENAR/OCULTAR ESPECÍFICOS) {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.hide_card == true -%}{%- continue -%}{%- endif -%}

          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            {%- assign display_title = block.settings.title | default: product.title -%}
            {%- assign display_description = block.settings.description | default: product.description | strip_html | truncatewords: 10 -%}
            {%- assign display_url = product.url -%}
            {%- assign display_image = block.settings.custom_image | default: product.featured_media -%}
            
            {%- assign variant_id = product.selected_or_first_available_variant.id -%}
            {%- assign is_available = product.selected_or_first_available_variant.available -%}
            
            {%- assign hover_image = nil -%}
            {%- if block.settings.custom_hover_image != blank -%}
              {%- assign hover_image = block.settings.custom_hover_image -%}
            {%- elsif product.media.size > 1 -%}
              {%- assign hover_image = product.media[1] -%}
            {%- endif -%}

            {%- capture display_price -%}
              {%- if product.price_varies -%}
                {{ 'products.product.from_lowest_price_html' | t: lowest_price: product.price_min | money }}
              {%- else -%}
                {{ product.price | money }}
              {%- endif -%}
            {%- endcapture -%}

            <div class="custom-treatment-card" {{ block.shopify_attributes }}>
              <div 
                class="custom-treatment-card__image-container"
                style="background-color: {{ section.settings.card_bg_color | default: '#f5f5f7' }};"
              >
                {%- if display_image != blank -%}
                  <a href="{{ display_url }}" class="custom-treatment-card__image-link">
                    <img
                      src="{{ display_image | image_url: width: 600 }}"
                      alt="{{ display_title | escape }}"
                      loading="lazy"
                      width="240"
                      height="300"
                      class="custom-treatment-card__image {% if hover_image != blank %}custom-treatment-card__image--primary{% endif %}"
                    >
                    {%- if hover_image != blank -%}
                      <img
                        src="{{ hover_image | image_url: width: 600 }}"
                        alt="{{ display_title | escape }}"
                        loading="lazy"
                        width="240"
                        height="300"
                        class="custom-treatment-card__image custom-treatment-card__image--hover"
                      >
                    {%- endif -%}
                  </a>
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
                {%- endif -%}
              </div>

              <div class="custom-treatment-card__content">
                <h3 class="custom-treatment-card__title">
                  <a href="{{ display_url }}">{{ display_title }}</a>
                </h3>
                
                <p class="custom-treatment-card__subtitle">
                  {{ block.settings.subtitle | default: product.vendor | default: section.settings.default_subtitle }}
                </p>

                <p class="custom-treatment-card__description">
                  {{ display_description }}
                </p>

                <p class="custom-treatment-card__price">{{ display_price }}</p>

                <div class="custom-treatment-card__actions">
                  <a href="{{ display_url }}" class="custom-treatment-btn custom-treatment-btn--primary">
                    {{ section.settings.btn_primary_text | default: 'Learn More' }}
                  </a>

                  {%- if is_available -%}
                    <button 
                      type="button"
                      class="custom-treatment-btn custom-treatment-btn--add-to-cart js-add-to-cart-btn"
                      data-variant-id="{{ variant_id }}"
                    >
                      <span class="btn-text">{{ section.settings.btn_cart_text | default: 'Add to Cart' }}</span>
                      <span class="btn-spinner" style="display:none;">...</span>
                    </button>
                  {%- else -%}
                    <button type="button" class="custom-treatment-btn custom-treatment-btn--disabled" disabled>
                      Sold Out
                    </button>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

      {%- comment -%} 2. CARGA AUTOMÁTICA DE COLECCIÓN (SI NO HAY BLOQUES) {%- endcomment -%}
      {%- else -%}
        {%- assign collection_target = section.settings.featured_collection -%}
        {%- assign products_limit = section.settings.products_to_show | default: 8 -%}

        {%- if collection_target != blank and collection_target.products.size > 0 -%}
          {%- for product in collection_target.products limit: products_limit -%}
            {%- assign display_title = product.title -%}
            {%- assign display_url = product.url -%}
            {%- assign display_image = product.featured_media -%}
            {%- assign variant_id = product.selected_or_first_available_variant.id -%}
            {%- assign is_available = product.selected_or_first_available_variant.available -%}
            
            {%- assign hover_image = nil -%}
            {%- if product.media.size > 1 -%}
              {%- assign hover_image = product.media[1] -%}
            {%- endif -%}

            {%- capture display_price -%}
              {%- if product.price_varies -%}
                {{ 'products.product.from_lowest_price_html' | t: lowest_price: product.price_min | money }}
              {%- else -%}
                {{ product.price | money }}
              {%- endif -%}
            {%- endcapture -%}

            <div class="custom-treatment-card">
              <div 
                class="custom-treatment-card__image-container"
                style="background-color: {{ section.settings.card_bg_color | default: '#f5f5f7' }};"
              >
                {%- if display_image != blank -%}
                  <a href="{{ display_url }}" class="custom-treatment-card__image-link">
                    <img
                      src="{{ display_image | image_url: width: 600 }}"
                      alt="{{ display_title | escape }}"
                      loading="lazy"
                      width="240"
                      height="300"
                      class="custom-treatment-card__image {% if hover_image != blank %}custom-treatment-card__image--primary{% endif %}"
                    >
                    {%- if hover_image != blank -%}
                      <img
                        src="{{ hover_image | image_url: width: 600 }}"
                        alt="{{ display_title | escape }}"
                        loading="lazy"
                        width="240"
                        height="300"
                        class="custom-treatment-card__image custom-treatment-card__image--hover"
                      >
                    {%- endif -%}
                  </a>
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'custom-treatment-card__placeholder' }}
                {%- endif -%}
              </div>

              <div class="custom-treatment-card__content">
                <h3 class="custom-treatment-card__title">
                  <a href="{{ display_url }}">{{ display_title }}</a>
                </h3>
                
                <p class="custom-treatment-card__subtitle">
                  {{ product.vendor | default: section.settings.default_subtitle }}
                </p>

                <p class="custom-treatment-card__description">
                  {{ product.description | strip_html | truncatewords: 10 }}
                </p>

                <p class="custom-treatment-card__price">{{ display_price }}</p>

                <div class="custom-treatment-card__actions">
                  <a href="{{ display_url }}" class="custom-treatment-btn custom-treatment-btn--primary">
                    {{ section.settings.btn_primary_text | default: 'Learn More' }}
                  </a>

                  {%- if is_available -%}
                    <button 
                      type="button"
                      class="custom-treatment-btn custom-treatment-btn--add-to-cart js-add-to-cart-btn"
                      data-variant-id="{{ variant_id }}"
                    >
                      <span class="btn-text">{{ section.settings.btn_cart_text | default: 'Add to Cart' }}</span>
                      <span class="btn-spinner" style="display:none;">...</span>
                    </button>
                  {%- else -%}
                    <button type="button" class="custom-treatment-btn custom-treatment-btn--disabled" disabled>
                      Sold Out
                    </button>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

<!-- ROBUST AJAX ADD TO CART SCRIPT -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.getElementById('treatment-section-{{ section.id }}');
    if (!sectionContainer) return;

    const cartBtns = sectionContainer.querySelectorAll('.js-add-to-cart-btn');

    cartBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const variantId = this.getAttribute('data-variant-id');
        if (!variantId) return;

        const textSpan = this.querySelector('.btn-text');
        const spinnerSpan = this.querySelector('.btn-spinner');
        const originalText = textSpan.textContent;

        this.disabled = true;
        textSpan.style.display = 'none';
        spinnerSpan.style.display = 'inline-block';

        // Solicitud AJAX robusta obteniendo el estado completo del carrito
        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => {
          return response.json();
        })
        .then(data => {
          textSpan.textContent = 'Added! ✓';
          textSpan.style.display = 'inline-block';
          spinnerSpan.style.display = 'none';
          this.classList.add('is-added');

          // Forzar la actualización de los elementos de carrito del tema (Drawer o burbuja de conteo)
          fetch(window.Shopify.routes.root + 'cart.js')
            .then(res => res.json())
            const cartUpdateEvent = new CustomEvent('cart:updated', { detail: data });
            document.dispatchEvent(cartUpdateEvent);

            // Actualizar contadores globales si existen en el tema
            document.querySelectorAll('.cart-count-bubble').forEach(badge => {
              // Opcional: refrescar mediante fetch de secciones de header/drawer si aplica
            });

            // Si el tema usa cart-drawer nativo de Dawn
            const cartDrawer = document.querySelector('cart-drawer');
            if (cartDrawer && typeof cartDrawer.open === 'function' && typeof cartDrawer.setActiveElement === 'function') {
              fetch(`${window.Shopify.routes.root}?sections=cart-drawer,cart-icon-bubble`)
                .then(res => res.json())
                .then(parsedState => {
                  if (parsedState['cart-drawer']) {
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = parsedState['cart-drawer'];
                    const newDrawer = tempDiv.querySelector('cart-drawer');
                    if (newDrawer) {
                      cartDrawer.innerHTML = newDrawer.innerHTML;
                    }
                  }
                  cartDrawer.open();
                });
            }

          setTimeout(() => {
            textSpan.textContent = originalText;
            this.classList.remove('is-added');
            this.disabled = false;
          }, 2000);
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          textSpan.textContent = 'Error';
          textSpan.style.display = 'inline-block';
          spinnerSpan.style.display = 'none';
          this.disabled = false;
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Custom Product Treatment",
  "tag": "section",
  "class": "section-custom-product-treatment",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Beds & Stools"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select Automatic Collection",
      "info": "Automatically fetches products from this collection unless manual blocks are added below."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Collection Limit",
      "default": 8
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f5f5f7"
    },
    {
      "type": "text",
      "id": "default_subtitle",
      "label": "Default Subtitle / Category Tag",
      "default": "Professional Treatment Series"
    },
    {
      "type": "header",
      "content": "Button Labels"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Text",
      "default": "Learn More"
    },
    {
      "type": "text",
      "id": "btn_cart_text",
      "label": "Add to Cart Button Text",
      "default": "Add to Cart"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Manual Product Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "hide_card",
          "label": "Hide / Disable Card",
          "default": false
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Custom Subtitle Override"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Custom Short Description Override"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Primary Image"
        },
        {
          "type": "image_picker",
          "id": "custom_hover_image",
          "label": "Custom Hover Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Treatment"
    }
  ]
}
{% endschema %}