{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="site-footer">
  <div class="page-width site-footer__container">
    
    <!-- Columna 1: Our Offices -->
    <div class="site-footer__col">
      <h3 class="site-footer__title">Our offices</h3>
      <div class="site-footer__address-block">
        <strong class="site-footer__subtitle">CANADA</strong>
        <p>11970 Albert Hudon<br>H1G 3K3,<br>Montréal, QC</p>
      </div>
      <div class="site-footer__address-block">
        <strong class="site-footer__subtitle">USA DIVISION</strong>
        <p>2425 Main street<br>P.O.Box 154<br>ISLE LA MOTTE, VT 05463</p>
      </div>
    </div>

    <!-- Columna 2: Our Products -->
    <div class="site-footer__col">
      <h3 class="site-footer__title">Our products</h3>
      <ul class="site-footer__links">
        <li><a href="/collections/skincare-equipment">Skincare Equipment</a></li>
        <li><a href="/collections/treatment-tables">Treatment tables</a></li>
        <li><a href="/collections/stools">Stools</a></li>
        <li><a href="/collections/trolleys">Trolleys</a></li>
        <li><a href="/collections/mag-lamps">Mag-lamps</a></li>
        <li><a href="/collections/wellness-therapy">Wellness therapy</a></li>
      </ul>
    </div>

    <!-- Columna 3: Newsletter -->
    <div class="site-footer__col site-footer__col--center">
      <h2 class="site-footer__newsletter-title">Newsletter</h2>
      <p class="site-footer__newsletter-sub">Subscribe to the newsletter</p>
      
      {% form 'customer', class: 'site-footer__newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="site-footer__input-wrapper">
          <input 
            type="email" 
            name="contact[email]" 
            class="site-footer__input" 
            placeholder="Adresse e-mail" 
            required
          >
          <button type="submit" class="site-footer__submit-btn">SIGNUP</button>
        </div>
      {% endform %}
    </div>

    <!-- Columna 4: Brand & Contact -->
    <div class="site-footer__col site-footer__col--right">
      <div class="site-footer__logo">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
        {% else %}
          <span class="site-footer__logo-text">EQUI<span>PRO</span></span>
        {% endif %}
      </div>

      <div class="site-footer__contact-info">
        <p><strong>Toll-free +1 877 324-2226</strong></p>
        <p><a href="mailto:info@equipro-bty.com">info@equipro-bty.com</a></p>
      </div>

      <div class="site-footer__emergency">
        <a href="tel:+18773242226">Emergency : 24 hours</a>
      </div>

      <div class="site-footer__socials">
        <a href="#" class="social-circle" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a22938" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="#" class="social-circle" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a22938" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="#" class="social-circle" aria-label="Pinterest">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a22938" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.25 2.67 7.9 6.42 9.34-.09-.78-.17-1.98.04-2.83.19-.77 1.22-5.17 1.22-5.17s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.57 2.26-.87 3.51-.25 1.05.53 1.91 1.56 1.91 1.87 0 3.31-1.97 3.31-4.82 0-2.52-1.81-4.28-4.4-4.28-2.99 0-4.75 2.24-4.75 4.56 0 .9.35 1.87.79 2.4.09.11.1.2.07.31-.08.31-.25 1.03-.28 1.17-.04.18-.16.22-.36.13-1.34-.62-2.18-2.57-2.18-4.14 0-3.37 2.45-6.47 7.07-6.47 3.71 0 6.6 2.65 6.6 6.19 0 3.69-2.33 6.66-5.56 6.66-1.09 0-2.11-.56-2.46-1.23l-.67 2.55c-.24.93-.9 2.09-1.34 2.8 1.06.33 2.19.5 3.36.5 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "White Logo Image"
    }
  ]
}
{% endschema %}