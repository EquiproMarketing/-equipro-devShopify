{{ 'section-about.css' | asset_url | stylesheet_tag }}

<div class="page-width page-about">
  <div class="page-about__header">
    <h1 class="page-about__title">{{ section.settings.title | default: page.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="page-about__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="page-about__grid">
    <div class="page-about__card">
      <h3>Canadian Craftsmanship</h3>
      <p>Designed and manufactured with high-grade engineering standards in Quebec, Canada.</p>
    </div>

    <div class="page-about__card">
      <h3>2-Year Comprehensive Warranty</h3>
      <p>Direct manufacturer warranty support, quick parts replacement, and technical assistance.</p>
    </div>

    <div class="page-about__card">
      <h3>Ergonomic & Modular Design</h3>
      <p>Tailored for estheticians with posture support and sleek clinical aesthetics.</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Main",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "About Equipro Beauty"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Leading manufacturer of high-end aesthetic equipment."
    }
  ]
}
{% endschema %}