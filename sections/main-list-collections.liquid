{{ 'section-main-list-collections.css' | asset_url | stylesheet_tag }}

<div class="collections-page-wrapper page-width">
  <!-- Page Title -->
  {%- if section.settings.title != blank -%}
    <h1 class="collections-page__title">{{ section.settings.title | escape }}</h1>
  {%- endif -%}

  <!-- Bento Red Categories Grid -->
  <div class="collections-bento-grid">
    {% for block in section.blocks %}
      {% assign custom_url = block.settings.custom_link %}
      {% assign target_url = custom_url | default: block.settings.collection.url | default: '#' %}

      <a href="{{ target_url }}" class="collection-bento-tile" {{ block.shopify_attributes }}>
        <div class="collection-bento-tile__bg">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'collection-bento-tile__img' }}
          {% elsif block.settings.collection.featured_image != blank %}
            {{ block.settings.collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'collection-bento-tile__img' }}
          {% else %}
            <div class="collection-bento-tile__placeholder"></div>
          {% endif %}
          
          {%- comment -%} OVERLAY ROJO MONOCROMÁTICO (EQUIPRO RED) {%- endcomment -%}
          <div class="collection-bento-tile__overlay"></div>
        </div>
        
        <div class="collection-bento-tile__content">
          <span class="collection-bento-tile__name">
            {{ block.settings.title | default: block.settings.collection.title | default: 'Category' }}
          </span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collections Grid",
  "tag": "section",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Products"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Category Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link Override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Tile Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Grid"
    }
  ]
}
{% endschema %}