{{ 'section-image-slider.css' | asset_url | stylesheet_tag }}

<div class="image-slider-wrapper" id="ImageSlider-{{ section.id }}">
  <div class="swiper image-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide image-slider__slide" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'image-slider__image', loading: 'eager' }}
          {% else %}
            <div class="image-slider__placeholder"></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <!-- Navigation Buttons -->
    {% if section.blocks.size > 1 %}
      <button type="button" class="image-slider__nav image-slider__nav--prev swiper-btn-prev-{{ section.id }}" aria-label="Previous slide">
        <svg width="12" height="20" viewBox="0 0 12 20" fill="none"><path d="M10 2L2 10L10 18" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <button type="button" class="image-slider__nav image-slider__nav--next swiper-btn-next-{{ section.id }}" aria-label="Next slide">
        <svg width="12" height="20" viewBox="0 0 12 20" fill="none"><path d="M2 2L10 10L2 18" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.image-swiper-{{ section.id }}', {
      loop: true,
      speed: 800,
      effect: 'fade',
      fadeEffect: {
        crossFade: true
      },
      autoplay: {
        delay: {{ section.settings.autoplay_speed | default: 5000 }},
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      navigation: {
        nextEl: '.swiper-btn-next-{{ section.id }}',
        prevEl: '.swiper-btn-prev-{{ section.id }}',
      }
    });
  });
</script>

{% schema %}
{
  "name": "Full Width Image Slider",
  "tag": "section",
  "class": "section-image-slider",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2000,
      "max": 9000,
      "step": 1000,
      "unit": "ms",
      "label": "Autoplay Speed",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full Width Image Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}