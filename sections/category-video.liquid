<div class="category-video page-width">
  <div class="category-video__wrapper">
    <div class="category-video__placeholder">
      <div class="category-video__play-icon">▶</div>
    </div>
  </div>
</div>

<style>
.category-video { margin: 4rem auto; }
.category-video__wrapper { width: 100%; aspect-ratio: 16 / 9; max-height: 500px; border-radius: 24px; overflow: hidden; background: #1a1a1a; display: flex; align-items: center; justify-content: center; position: relative; }
.category-video__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; cursor: pointer; background: linear-gradient(135deg, #333 0%, #111 100%); }
.category-video__play-icon { width: 64px; height: 64px; border-radius: 50%; background: #a22938; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; padding-left: 4px; }
</style>

{% schema %}
{
  "name": "Category Video",
  "settings": [],
  "presets": [{ "name": "Category Video" }]
}
{% endschema %}