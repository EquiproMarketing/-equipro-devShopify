{{ 'section-about-how-we-work.css' | asset_url | stylesheet_tag }}

<section class="about-how page-width">
  {%- if section.settings.title != blank -%}
    <h2 class="about-how__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  <div class="about-how__grid">
    {%- for block in section.blocks -%}
      <div class="about-how__card" {{ block.shopify_attributes }}>
        {%- if block.settings.step_title != blank -%}
          <span class="about-how__step-title">{{ block.settings.step_title }}</span>
        {%- endif -%}

        <div class="about-how__image-wrapper">
          {%- if block.settings.step_image != blank -%}
            {{ block.settings.step_image | image_url: width: 800 | image_tag: class: 'about-how__img', alt: block.settings.step_title }}
          {%- else -%}
            <div class="about-how__placeholder-img"></div>
          {%- endif -%}
        </div>

        {%- if block.settings.step_description != blank -%}
          <p class="about-how__description">{{ block.settings.step_description }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "About - How We Work",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "How We Work"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Step Title",
          "default": "Step 1: Clinical Audit"
        },
        {
          "type": "image_picker",
          "id": "step_image",
          "label": "Step Image"
        },
        {
          "type": "textarea",
          "id": "step_description",
          "label": "Description",
          "default": "We analyze your space and business goals to recommend the exact suite that maximizes your ROI."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - How We Work",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_title": "Step 1: Clinical Audit",
            "step_description": "We analyze your space and business goals to recommend the exact suite that maximizes your ROI."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_title": "Step 2: Reliability by Design",
            "step_description": "Every piece is CSA & UL approved with a 15-20 year life expectancy. We don't just sell tools; we sell longevity."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_title": "Step 3: Continuous Partnership",
            "step_description": "Our 2 year warranty includes a courtesy equipment float we lend you a machine so your operations never stop during repairs."
          }
        }
      ]
    }
  ]
}
{% endschema %}