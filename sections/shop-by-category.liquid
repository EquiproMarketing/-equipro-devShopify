{{ 'section-shop-by-category.css' | asset_url | stylesheet_tag }}

<div class="shop-category-wrapper page-width">
  <h2 class="shop-category__title">{{ section.settings.title }}</h2>

  <div class="shop-category__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="category-card category-card--{{ block.settings.style }}" {{ block.shopify_attributes }}>
        <div class="category-card__content">
          <span class="category-card__line"></span>
          <span class="category-card__name">{{ block.settings.title }}</span>
        </div>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.title }}" class="category-card__image" loading="lazy">
        {% else %}
          <div class="category-card__image-placeholder"></div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "section-shop-by-category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SHOP BY CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Treatment Tables"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Card Style",
          "options": [
            { "value": "red", "label": "Solid Red" },
            { "value": "outline", "label": "Red Outline" }
          ],
          "default": "red"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Treatment Tables", "style": "red" } },
        { "type": "category", "settings": { "title": "Multi-function columns", "style": "outline" } },
        { "type": "category", "settings": { "title": "Wax-heaters", "style": "red" } },
        { "type": "category", "settings": { "title": "Stools", "style": "red" } },
        { "type": "category", "settings": { "title": "Steamers", "style": "red" } },
        { "type": "category", "settings": { "title": "Mag-lamps", "style": "red" } },
        { "type": "category", "settings": { "title": "Towel warmers", "style": "red" } },
        { "type": "category", "settings": { "title": "Trolleys", "style": "red" } }
      ]
    }
  ]
}
{% endschema %}