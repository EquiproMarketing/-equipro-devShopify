{{ 'section-shop-by-category.css' | asset_url | stylesheet_tag }}

<div class="shop-category-wrapper page-width">
  <h2 class="shop-category__title">{{ section.settings.title }}</h2>

  <div class="swiper category-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% assign modulo = forloop.index0 | modulo: 2 %}
        {% if modulo == 0 %}
          <div class="swiper-slide">
            <div class="category-card-pair">
        {% endif %}

              <a href="{{ block.settings.link }}" class="category-card category-card--{{ block.settings.style }}" {{ block.shopify_attributes }}>
                <div class="category-card__content">
                  <span class="category-card__line"></span>
                  <span class="category-card__name">{{ block.settings.title }}</span>
                </div>
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.title }}" class="category-card__image" loading="lazy">
                {% else %}
                  <div class="category-card__image-placeholder"></div>
                {% endif %}
              </a>

        {% if modulo == 1 or forloop.last %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="swiper-pagination category-swiper-pagination"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.category-swiper', {
      slidesPerView: 1.15,
      spaceBetween: 14,
      grabCursor: true,
      pagination: {
        el: '.category-swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        768: {
          slidesPerView: 4,
          spaceBetween: 20
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "section-shop-by-category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SHOP BY CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Treatment Tables"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Card Style",
          "options": [
            { "value": "red", "label": "Solid Red" },
            { "value": "outline", "label": "Red Outline" }
          ],
          "default": "red"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}