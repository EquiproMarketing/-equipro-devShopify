{{ 'section-shop-by-category.css' | asset_url | stylesheet_tag }}

<div class="shop-category-wrapper page-width">
  <h2 class="shop-category__title">{{ section.settings.title }}</h2>

  <div class="swiper category-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}" class="category-card category-card--{{ block.settings.style }}">
            <div class="category-card__content">
              <span class="category-card__line"></span>
              <span class="category-card__name">{{ block.settings.title }}</span>
            </div>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.title }}" class="category-card__image" loading="lazy">
            {% else %}
              <div class="category-card__image-placeholder"></div>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.category-swiper', {
      slidesPerView: 1.2,
      spaceBetween: 16,
      loop: true,
      grabCursor: true,
      speed: 3500,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      breakpoints: {
        640: { slidesPerView: 2.2, spaceBetween: 16 },
        990: { slidesPerView: 4, spaceBetween: 20 }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "section-shop-by-category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SHOP BY CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Treatment Tables"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Card Style",
          "options": [
            { "value": "red", "label": "Solid Red" },
            { "value": "outline", "label": "Red Outline" }
          ],
          "default": "red"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}