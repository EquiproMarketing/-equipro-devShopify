{{ 'section-bento-grid-v2.css' | asset_url | stylesheet_tag }}

<div class="collections-bento-v2-wrapper page-width">
  {%- if section.settings.title != blank -%}
    <h2 class="collections-bento-v2__heading">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="collections-bento-v2__grid">
    {%- for block in section.blocks -%}
      {%- assign custom_url = block.settings.custom_link -%}
      {%- assign target_url = custom_url | default: block.settings.collection.url | default: '#' -%}
      {%- assign card_image = block.settings.image | default: block.settings.collection.featured_image -%}

      {%- assign img_fit = block.settings.image_fit | default: 'cover' -%}
      {%- assign title_size = block.settings.title_font_size | default: 28 -%}
      {%- assign title_color = block.settings.title_color | default: '#000000' -%}
      {%- assign shadow_color = block.settings.shadow_color | default: 'rgba(0,0,0,0.3)' -%}
      {%- assign shadow_blur = block.settings.shadow_blur | default: 8 -%}
      {%- assign shadow_y = block.settings.shadow_offset_y | default: 4 -%}

      <a 
        href="{{ target_url }}" 
        class="bento-v2-card bento-v2-card--fit-{{ img_fit }}" 
        style="
          --tile-bg: {{ block.settings.bg_color | default: '#e8e8ed' }};
          --tile-title-size: {{ title_size }}px;
          --tile-title-color: {{ title_color }};
          --tile-shadow-color: {{ shadow_color }};
          --tile-shadow-blur: {{ shadow_blur }}px;
          --tile-shadow-y: {{ shadow_y }}px;
        "
        {{ block.shopify_attributes }}
      >
        <!-- Full Bleed Image Container (Absolute Fill) -->
        <div class="bento-v2-card__media">
          {%- if card_image != blank -%}
            <img 
              src="{{ card_image | image_url: width: 1000 }}" 
              alt="{{ block.settings.title | default: card_image.alt | escape }}" 
              class="bento-v2-card__image" 
              loading="lazy" 
              width="500" 
              height="500"
            >
          {%- else -%}
            <div class="bento-v2-card__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'bento-v2-card__svg' }}
            </div>
          {%- endif -%}
        </div>

        <!-- Floating Title Overlay (Positioned On Top of Image) -->
        <div class="bento-v2-card__header">
          <h3 class="bento-v2-card__title {% if block.settings.enable_text_shadow %}bento-v2-card__title--shadow{% endif %}">
            {{ block.settings.title | default: block.settings.collection.title | default: 'Category' }}
          </h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bento Grid V2",
  "tag": "section",
  "class": "section-bento-grid-v2",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Products"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link Override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Category Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Tile Fallback Background",
          "default": "#e8e8ed"
        },
        {
          "type": "header",
          "content": "Title Styling"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "title_font_size",
          "min": 18,
          "max": 42,
          "step": 1,
          "unit": "px",
          "label": "Title Font Size",
          "default": 28
        },
        {
          "type": "checkbox",
          "id": "enable_text_shadow",
          "label": "Enable Custom Text Shadow",
          "default": false
        },
        {
          "type": "color",
          "id": "shadow_color",
          "label": "Shadow Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "shadow_blur",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Shadow Blur / Softness",
          "default": 8
        },
        {
          "type": "range",
          "id": "shadow_offset_y",
          "min": -10,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Shadow Vertical Offset (Y)",
          "default": 4
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image Fit Mode",
          "options": [
            { "value": "cover", "label": "Full Bleed / Cover" },
            { "value": "contain", "label": "Fit Complete Image (Contain)" }
          ],
          "default": "cover"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento Grid V2",
      "blocks": [
        { "type": "collection_item", "settings": { "title": "Skincare Equipments" } },
        { "type": "collection_item", "settings": { "title": "Treatment Tables" } },
        { "type": "collection_item", "settings": { "title": "Stools" } },
        { "type": "collection_item", "settings": { "title": "Trolleys" } },
        { "type": "collection_item", "settings": { "title": "Mag-lamps" } },
        { "type": "collection_item", "settings": { "title": "Wellness therapy" } }
      ]
    }
  ]
}
{% endschema %}