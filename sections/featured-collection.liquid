{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

<div class="featured-collection-wrapper page-width">
  <div class="featured-collection__header">
    <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
  </div>

  <div class="swiper best-sellers-swiper">
    <div class="swiper-wrapper">
      {%- comment -%} DYNAMIC PRODUCTS FROM COLLECTION {%- endcomment -%}
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank and collection.products.size > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          <div class="swiper-slide">
            {% render 'product-card-item', product: product %}
          </div>
        {% endfor %}
      {% endif %}

      {%- comment -%} CUSTOM MANUAL CARDS (APPLE STYLE) {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'custom_card' %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="apple-card">
              <a href="{{ block.settings.link | default: '#' }}" class="apple-card__link">
                <div class="apple-card__image-wrapper" style="background-color: {{ block.settings.card_bg | default: '#ffffff' }};">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.title | escape }}"
                      loading="lazy"
                      width="200"
                      height="250"
                      class="apple-card__image"
                    >
                  {% else %}
                    <div class="product-card__placeholder"></div>
                  {% endif %}
                </div>

                {%- comment -%} COLOR SWATCHES {%- endcomment -%}
                <div class="apple-card__swatches">
                  {% assign colors = block.settings.swatches | split: ',' %}
                  {% for color in colors %}
                    {% assign clean_color = color | strip %}
                    {% if clean_color != blank %}
                      <span class="apple-card__swatch-dot" style="background-color: {{ clean_color }};"></span>
                    {% endif %}
                  {% endfor %}
                </div>

                <div class="apple-card__info">
                  {% if block.settings.tag != blank %}
                    <span class="apple-card__tag">{{ block.settings.tag }}</span>
                  {% endif %}
                  
                  <h3 class="apple-card__title">{{ block.settings.title }}</h3>
                  
                  {% if block.settings.price != blank %}
                    <p class="apple-card__price">{{ block.settings.price }}</p>
                  {% endif %}
                </div>
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.best-sellers-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 20,
      freeMode: true,
      grabCursor: true,
      breakpoints: {
        750: { spaceBetween: 24 }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "OUR BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "blocks": [
    {
      "type": "custom_card",
      "name": "Custom Apple Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Image Background Color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (e.g. Nouveau)",
          "default": "Nouveau"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Stool with Backrest"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "69,00 $"
        },
        {
          "type": "textarea",
          "id": "swatches",
          "label": "Color Swatches (HEX list separated by comma)",
          "default": "#ff5a5f, #f4d06f, #3d5a80, #2b2d42"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}