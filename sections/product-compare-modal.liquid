{%- capture comparison_excluded -%}{%- render 'comparison-excluded', target_product: product -%}{%- endcapture -%}
{%- if comparison_excluded == blank -%}
<dialog id="CustomCompareModal" class="custom-compare-modal-overlay" aria-modal="true" aria-labelledby="CompareModalTitle">
  <div class="custom-compare-modal-content">
    <button type="button" class="custom-compare-modal-close" id="CloseCompareModal" aria-label="{{ 'compare_legacy.close' | t | escape }}" autofocus>&times;</button>
    
    <div class="custom-compare-modal-header">
      <h2 id="CompareModalTitle">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'compare_legacy.title' | t }}{% endif %}</h2>
      <p>{{ 'compare_legacy.intro' | t }}</p>
    </div>

    {%- capture comparison_family -%}{%- render 'comparison-family', target_product: product -%}{%- endcapture -%}
    {%- assign comparison_family = comparison_family | strip -%}
    {%- assign collection_handle = section.settings.compare_collection -%}
    {%- if comparison_family != blank -%}{%- assign collection_handle = comparison_family -%}{%- endif -%}
    {%- assign compare_coll = collections[collection_handle] -%}

    {%- comment -%} FALLBACK SI NO HAY COLECCIÓN SELECCIONADA {%- endcomment -%}
    {%- if compare_coll == blank or compare_coll.products.size == 0 -%}
      {%- assign compare_coll = product.collections.first -%}
    {%- endif -%}

    <div class="custom-compare-modal-body">
      {%- if compare_coll != blank and compare_coll.products.size > 0 -%}
        <div class="compare-table-wrapper">
          <table class="compare-table">
            <thead>
              <tr>
                <th class="feature-label">{{ 'compare_legacy.specifications' | t }}</th>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <th class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- if prod.handle == product.handle -%}
                      <span class="this-model-badge">{{ 'compare_legacy.this_model' | t }}</span>
                    {%- endif -%}
                    {%- if prod.featured_media != blank -%}
                      <img src="{{ prod.featured_media | image_url: width: 200 }}" alt="{{ prod.title | escape }}" class="compare-product-img" loading="lazy">
                    {%- endif -%}
                    <h3 class="compare-product-title">{{ prod.title }}</h3>
                    <p class="compare-product-price">{{ prod.price | money }}</p>
                    <a href="{{ prod.url }}" class="compare-view-btn">{{ 'compare_legacy.view_details' | t }}</a>
                  </th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- if comparison_family != blank -%}
                {%- if comparison_family == 'stools' -%}
                  {%- assign pilot_keys = 'height|mechanism|seat|seat_dimensions|backrest|base|casters|upholstery|warranty' | split: '|' -%}
                {%- else -%}
                  {%- assign pilot_keys = 'dimensions|shelves|shelf_dimensions|spacing|drawers|cabinet|holders|outlets|casters|warranty' | split: '|' -%}
                {%- endif -%}
                {%- for pilot_key in pilot_keys -%}
                  <tr>
                    <td class="feature-label">{%- render 'comparison-pilot-spec-label', spec_key: pilot_key, value: '', value_mode: false -%}</td>
                    {%- for prod in compare_coll.products limit: 4 -%}
                      <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">{%- render 'comparison-pilot-spec-value', compared_product: prod, spec_key: pilot_key -%}</td>
                    {%- endfor -%}
                  </tr>
                {%- endfor -%}
              {%- else -%}
              <!-- 1. CATEGORÍA / TIPO DE PRODUCTO DINÁMICO -->
              <tr>
                <td class="feature-label">{{ 'compare_legacy.category_type' | t }}</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- assign product_category = prod.type | default: prod.metafields.custom.category -%}
                    {%- if product_category != blank -%}{{ product_category }}{%- else -%}{{ 'compare_legacy.equipment' | t }}{%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- 2. MODEL SKU DINÁMICO -->
              <tr>
                <td class="feature-label">{{ 'compare_legacy.model_sku' | t }}</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- assign product_sku = prod.selected_or_first_available_variant.sku | default: prod.variants.first.sku -%}
                    {%- if product_sku != blank -%}{{ product_sku }}{%- else -%}{{ 'compare_legacy.not_available' | t }}{%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- 3. SISTEMA / ELEVACIÓN DINÁMICO -->
              <tr>
                <td class="feature-label">{{ 'compare_legacy.system_elevation' | t }}</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- assign sys = prod.metafields.custom.system_type | default: prod.metafields.custom.elevation -%}
                    {%- if sys != blank -%}
                      {{ sys }}
                    {%- else -%}
                      {%- if prod.tags contains 'electric' -%}{{ 'compare_legacy.electric_motor' | t }}{%- elsif prod.tags contains 'hydraulic' -%}{{ 'compare_legacy.hydraulic_pump' | t }}{%- else -%}{{ 'compare_legacy.standard_manual' | t }}{%- endif -%}
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- 4. ROTACIÓN DINÁMICA -->
              <tr>
                <td class="feature-label">{{ 'compare_legacy.rotation' | t }}</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- assign rot = prod.metafields.custom.rotation -%}
                    {%- if rot != blank -%}
                      {{ rot }}
                    {%- else -%}
                      {%- if prod.title contains '360' or prod.description contains '360' -%}{{ 'compare_legacy.swivel_360' | t }}{%- else -%}{{ 'compare_legacy.fixed_non_swivel' | t }}{%- endif -%}
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- 5. GARANTÍA DINÁMICA -->
              <tr>
                <td class="feature-label">Warranty & Safety</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- if prod.metafields.custom.warranty != blank -%}{{ prod.metafields.custom.warranty }}{%- else -%}{{ 'compare_legacy.default_warranty' | t }}{%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- 6. DISPONIBILIDAD DINÁMICA -->
              <tr>
                <td class="feature-label">{{ 'compare_legacy.availability' | t }}</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- if prod.available -%}
                      <span style="color: #16a34a; font-weight: 600;">{{ 'compare_legacy.in_stock' | t }}</span>
                    {%- else -%}
                      <span style="color: #dc2626; font-weight: 600;">{{ 'compare_legacy.out_of_stock' | t }}</span>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
              {%- endif -%}
            </tbody>
          </table>
        </div>
      {%- else -%}
        <p class="compare-empty-notice">{{ 'compare_legacy.empty' | t }}</p>
      {%- endif -%}

      <div class="compare-modal-footer">
        <button type="button" class="compare-footer-btn" id="CloseCompareModalFooter">{{ 'compare_legacy.close' | t }}</button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .custom-compare-modal-overlay:not([open]) {
    display: none;
  }

  .custom-compare-modal-overlay::backdrop {
    background: transparent;
  }

  .custom-compare-modal-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    box-sizing: border-box;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .custom-compare-modal-content {
    background: #ffffff;
    width: 100%;
    max-width: 1100px;
    border-radius: 16px;
    padding: 35px 30px;
    position: relative;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    max-height: 88vh;
    overflow-y: auto;
  }

  .custom-compare-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #f4f4f5;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
    color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-compare-modal-header h2 {
    font-size: 26px;
    font-weight: 700;
    color: #a22938;
    margin: 0 0 6px 0;
  }

  .custom-compare-modal-header p {
    font-size: 14px;
    color: #666;
    margin: 0 0 25px 0;
  }

  .compare-table-wrapper {
    overflow-x: auto;
    margin-bottom: 25px;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
    font-size: 13px;
  }

  .compare-table th, 
  .compare-table td {
    padding: 14px 12px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
  }

  .compare-table th.feature-label,
  .compare-table td.feature-label {
    text-align: left;
    font-weight: 700;
    color: #1e293b;
    background: #f8fafc;
    width: 170px;
    min-width: 150px;
    border-right: 1px solid #e2e8f0;
  }

  .compare-table th.highlight-col,
  .compare-table td.highlight-col {
    background: #fff5f5;
    border-left: 2px solid #a22938;
    border-right: 2px solid #a22938;
  }

  .this-model-badge {
    display: inline-block;
    background: #a22938;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 12px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .compare-product-img {
    max-width: 90px;
    height: 90px;
    object-fit: contain;
    margin: 0 auto 10px auto;
    display: block;
  }

  .compare-product-title {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
    margin: 0 0 6px 0;
  }

  .compare-product-price {
    font-size: 14px;
    font-weight: 700;
    color: #a22938;
    margin: 0 0 10px 0;
  }

  .compare-view-btn {
    display: inline-block;
    padding: 6px 14px;
    background: #a22938;
    color: #ffffff;
    border-radius: 20px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
  }

  .compare-modal-footer {
    display: flex;
    justify-content: center;
    margin-top: 15px;
  }

  .compare-footer-btn {
    padding: 10px 24px;
    border-radius: 25px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
  }
</style>

<script>
  function initLegacyCompareDialog() {
    const openBtn = document.getElementById('OpenCompareModal');
    const modal = document.getElementById('CustomCompareModal');
    const closeBtn = document.getElementById('CloseCompareModal');
    const closeFooter = document.getElementById('CloseCompareModalFooter');

    if (!openBtn || !modal || !closeBtn || !closeFooter || typeof modal.showModal !== 'function') return;

    let opener = null;
    let previousOverflow = '';
    const closeModal = () => {
      if (modal.open) modal.close();
    };

    openBtn.setAttribute('aria-haspopup', 'dialog');
    openBtn.setAttribute('aria-controls', modal.id);

    openBtn.addEventListener('click', (event) => {
      event.preventDefault();
      if (modal.open) return;
      opener = event.currentTarget;
      previousOverflow = document.documentElement.style.overflow;
      modal.showModal();
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    });

    closeBtn.addEventListener('click', closeModal);
    closeFooter.addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    modal.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeModal();
    });

    modal.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
      if (opener?.isConnected) opener.focus();
      opener = null;
    });

    modal.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !modal.open) return;

      const focusable = [...modal.querySelectorAll('a[href], button, input, select, textarea, [tabindex]')]
        .filter((element) => element.tabIndex >= 0 && !element.matches(':disabled')
          && !element.closest('[inert], [hidden], [aria-hidden="true"]') && element.getClientRects().length > 0);
      if (!focusable.length) {
        event.preventDefault();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;
      if (!focusable.includes(active) || (event.shiftKey ? active === first : active === last)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLegacyCompareDialog, { once: true });
  } else {
    initLegacyCompareDialog();
  }
</script>

{%- endif -%}
{% schema %}
{
  "name": "Product Compare Modal",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Modal Heading",
      "default": "Technical Model Comparison"
    },
    {
      "type": "collection",
      "id": "compare_collection",
      "label": "Collection to Compare"
    }
  ],
  "presets": [
    {
      "name": "Product Compare Modal"
    }
  ]
}
{% endschema %}
