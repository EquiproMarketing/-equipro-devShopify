{% comment %}
  Detección de colección/tipo para la comparativa
{% endcomment %}
{% assign target_collection = section.settings.compare_collection | default: product.collections.first %}
{% if target_collection == blank %}
  {% assign target_collection = collections['all'] %}
{% endif %}

{% assign current_type_raw = product.type | downcase %}
{% assign product_url_raw = product.url | downcase %}
{% assign product_title_down = product.title | downcase %}

<!-- Detección de Categoría Dominante -->
{% assign category_key = 'generic' %}
{% if current_type_raw contains 'wax' or product_url_raw contains 'wax' or product_title_down contains 'pil' or product_title_down contains 'wax' %}
  {% assign category_key = 'wax_heaters' %}
{% elsif current_type_raw contains 'steamer' or product_url_raw contains 'steamers' or product_title_down contains 'steamer' or product_title_down contains 'vapoderm' or product_title_down contains 'digipro' %}
  {% assign category_key = 'steamers' %}
{% elsif current_type_raw contains 'table' or current_type_raw contains 'bed' or product_url_raw contains 'tables' or product_title_down contains 'table' %}
  {% assign category_key = 'treatment_tables' %}
{% elsif current_type_raw contains 'towel' or product_url_raw contains 'towel' or product_title_down contains 'towel' or product_title_down contains 'cabi' %}
  {% assign category_key = 'towel_warmers' %}
{% elsif current_type_raw contains 'stool' or product_url_raw contains 'stools' or product_title_down contains 'stool' %}
  {% assign category_key = 'stools' %}
{% endif %}

<!-- STEP 1: SELECT PRODUCTS MODAL -->
<div class="compare-modal-overlay" id="CompareModalStep1">
  <div class="compare-modal">
    <button class="compare-modal__close" onclick="closeCompareModal()">&times;</button>
    <h2 class="compare-modal__title">{{ section.settings.modal_title | default: "Select Models to Compare" }}</h2>
    <p class="compare-modal__sub">Choose up to 5 alternative models to compare against {{ product.title }}:</p>

    <div class="compare-select-list">
      <!-- Este Modelo -->
      <label class="compare-select-item is-selected">
        <input type="checkbox" checked disabled class="compare-checkbox" data-product-id="{{ product.id }}">
        <span>{{ product.title }}</span>
        <span class="this-model-tag">This Model</span>
      </label>

      <!-- Filtrado estricto para evitar duplicados del mismo producto -->
      {% assign other_products = target_collection.products | where_exp: "item", "item.handle != product.handle" %}
      {% for item in other_products limit: 5 %}
        <label class="compare-select-item is-selected">
          <input type="checkbox" checked class="compare-checkbox" data-product-id="{{ item.id }}">
          <span>{{ item.title }}</span>
        </label>
      {% endfor %}
    </div>

    <button class="compare-modal__submit-btn" onclick="goToStep2()">View Comparison</button>
  </div>
</div>

<!-- STEP 2: TECHNICAL COMPARISON TABLE MODAL -->
<div class="compare-modal-overlay" id="CompareModalStep2">
  <div class="compare-modal compare-modal--wide">
    <button class="compare-modal__close" onclick="closeCompareModal()">&times;</button>
    <h2 class="compare-modal__title">Technical Model Comparison</h2>
    <p class="compare-modal__sub">Compare key specs side by side to choose the best option for your workspace.</p>

    <div class="compare-table-scroll">
      <table class="compare-table">
        <thead>
          <tr>
            <th class="sticky-col">Key Features</th>
            
            <!-- COLUMNA MODELO ACTUAL -->
            <th class="this-model-col compare-col" data-product-id="{{ product.id }}">
              <span class="this-model-badge">This Model</span>
              <div class="compare-product-img">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}">
                {% else %}
                  <div class="placeholder-img"></div>
                {% endif %}
              </div>
              <strong>{{ product.title }}</strong>
              <div class="compare-product-price">{{ product.price | money }}</div>
              <a href="{{ product.url }}" class="compare-product-btn">View Details</a>
            </th>

            <!-- COLUMNAS OTROS MODELOS -->
            {% for item in other_products limit: 5 %}
              <th class="compare-col" data-product-id="{{ item.id }}">
                <div class="compare-product-img">
                  {% if item.featured_image != blank %}
                    <img src="{{ item.featured_image | image_url: width: 140 }}" alt="{{ item.title | escape }}">
                  {% else %}
                    <div class="placeholder-img"></div>
                  {% endif %}
                </div>
                <strong>{{ item.title }}</strong>
                <div class="compare-product-price">{{ item.price | money }}</div>
                <a href="{{ item.url }}" class="compare-product-btn">View Details</a>
              </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          <!-- 1. MODEL SKU -->
          <tr>
            <td class="sticky-col">Model SKU</td>
            <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
              <strong>{{ product.variants.first.sku | default: product.id }}</strong>
            </td>
            {% for item in other_products limit: 5 %}
              <td class="compare-col" data-product-id="{{ item.id }}">
                <strong>{{ item.variants.first.sku | default: item.id }}</strong>
              </td>
            {% endfor %}
          </tr>

          {% case category_key %}
            {% when 'steamers' %}
              <!-- ================= STEAMERS SPECIFICATIONS ================= -->
              <tr>
                <td class="sticky-col">Control Technology</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  {% assign t_down = product.title | downcase %}
                  {% if t_down contains 'digipro' or t_down contains 'digital' %}Digital Micro-Processor Control{% else %}Heavy-Duty Analog Control{% endif %}
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    {% assign it_down = item.title | downcase %}
                    {% if it_down contains 'digipro' or it_down contains 'digital' %}Digital Micro-Processor Control{% else %}Heavy-Duty Analog Control{% endif %}
                  </td>
                {% endfor %}
              </tr>
              <tr>
                <td class="sticky-col">Ozone Function</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  Integrated Purifying Ozone Lamp
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    Integrated Purifying Ozone Lamp
                  </td>
                {% endfor %}
              </tr>
              <tr>
                <td class="sticky-col">Water Jar / Capacity</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  High-Capacity Thermal Glass Reservoir
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    High-Capacity Thermal Glass Reservoir
                  </td>
                {% endfor %}
              </tr>
              <tr>
                <td class="sticky-col">Arm & Nozzle Adjustability</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  360° Directional Swivel Nozzle
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    360° Directional Swivel Nozzle
                  </td>
                {% endfor %}
              </tr>

            {% when 'wax_heaters' %}
              <!-- ================= WAX HEATERS SPECIFICATIONS ================= -->
              <tr>
                <td class="sticky-col">Number of Tanks</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  {% assign t_down = product.title | downcase %}
                  {% if t_down contains 'duo' or t_down contains '412' %}2 Independent Tanks{% else %}1 Single Tank{% endif %}
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    {% assign it_down = item.title | downcase %}
                    {% if it_down contains 'duo' or it_down contains '412' %}2 Independent Tanks{% else %}1 Single Tank{% endif %}
                  </td>
                {% endfor %}
              </tr>
              <tr>
                <td class="sticky-col">Chamber Sizes / Format</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  {% assign t_down = product.title | downcase %}
                  {% if t_down contains '41100' or t_down contains 'solo-pil standard' %}3 5/8" (Canadian / European Format)
                  {% elsif t_down contains '41101' or t_down contains 'solo-pil maxi' %}4" (US Format)
                  {% elsif t_down contains '41200' or t_down contains 'duo-pil maxi' %}Dual: 3 5/8" & 6" Bulk Reservoir
                  {% elsif t_down contains '41201' or t_down contains 'duo-pil standard' %}Dual: 3 5/8" (Can/Eur) & 4" (US)
                  {% elsif t_down contains '41202' or t_down contains 'duo-pil precision' %}Dual Precision: 3 5/8" & 4" Wells
                  {% else %}{{ product.metafields.custom.tank_capacity | default: "Standard Professional Well" }}{% endif %}
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    {% assign it_down = item.title | downcase %}
                    {% if it_down contains '41100' or it_down contains 'solo-pil standard' %}3 5/8" (Canadian / European Format)
                    {% elsif it_down contains '41101' or it_down contains 'solo-pil maxi' %}4" (US Format)
                    {% elsif it_down contains '41200' or it_down contains 'duo-pil maxi' %}Dual: 3 5/8" & 6" Bulk Reservoir
                    {% elsif it_down contains '41201' or it_down contains 'duo-pil standard' %}Dual: 3 5/8" (Can/Eur) & 4" (US)
                    {% elsif it_down contains '41202' or it_down contains 'duo-pil precision' %}Dual Precision: 3 5/8" & 4" Wells
                    {% else %}{{ item.metafields.custom.tank_capacity | default: "Standard Professional Well" }}{% endif %}
                  </td>
                {% endfor %}
              </tr>
              <tr>
                <td class="sticky-col">Thermostat Regulation</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  {% assign t_down = product.title | downcase %}
                  {% if t_down contains 'precision' or t_down contains '41202' %}Dual Electronic Thermostat (±2°C Precision)
                  {% elsif t_down contains 'duo' %}Dual Independent Rotary Thermostats
                  {% else %}Manual Precision Analog Dial{% endif %}
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    {% assign it_down = item.title | downcase %}
                    {% if it_down contains 'precision' or it_down contains '41202' %}Dual Electronic Thermostat (±2°C Precision)
                    {% elsif it_down contains 'duo' %}Dual Independent Rotary Thermostats
                    {% else %}Manual Precision Analog Dial{% endif %}
                  </td>
                {% endfor %}
              </tr>

            {% else %}
              <!-- ================= GENERIC CLEAN FALLBACK ================= -->
              <tr>
                <td class="sticky-col">Product Status</td>
                <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
                  {% if product.available %}In Stock{% else %}Out of Stock{% endif %}
                </td>
                {% for item in other_products limit: 5 %}
                  <td class="compare-col" data-product-id="{{ item.id }}">
                    {% if item.available %}In Stock{% else %}Out of Stock{% endif %}
                  </td>
                {% endfor %}
              </tr>
          {% endcase %}

          <!-- CERTIFICATIONS & WARRANTY (APLICA A TODO EQUIPAMIENTO EQUIPRO) -->
          <tr>
            <td class="sticky-col">Warranty & Safety</td>
            <td class="this-model-col compare-col" data-product-id="{{ product.id }}">
              2 Years Warranty | CSA & UL Approved
            </td>
            {% for item in other_products limit: 5 %}
              <td class="compare-col" data-product-id="{{ item.id }}">
                2 Years Warranty | CSA & UL Approved
              </td>
            {% endfor %}
          </tr>
        </tbody>
      </table>
    </div>

    <div class="compare-modal__footer">
      <button class="compare-btn-sec" onclick="goToStep1()">Go Back</button>
      <button class="compare-btn-sec" onclick="closeCompareModal()">Close</button>
    </div>
  </div>
</div>

<style>
.compare-modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000;
  display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.3s ease;
}
.compare-modal-overlay.is-open { opacity: 1; visibility: visible; }
.compare-modal {
  background: #fff; border-radius: 24px; padding: 2.5rem; width: 90%; max-width: 550px; position: relative; max-height: 90vh; overflow-y: auto;
}
.compare-modal--wide { max-width: 1100px; }
.compare-modal__close { position: absolute; top: 1.5rem; right: 1.5rem; background: #eee; border: none; width: 32px; height: 32px; border-radius: 50%; font-size: 1.2rem; cursor: pointer; }
.compare-modal__title { font-size: 2rem; font-weight: 700; color: #a22938; margin-bottom: 0.5rem; }
.compare-modal__sub { font-size: 0.9rem; color: #666; margin-bottom: 1.5rem; }
.compare-select-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; }
.compare-select-item { display: flex; align-items: center; gap: 0.75rem; padding: 1rem; border-radius: 12px; border: 1px solid #eee; cursor: pointer; font-size: 0.9rem; }
.compare-select-item.is-selected { border-color: #a22938; background: #fdf5f6; }
.this-model-tag { margin-left: auto; background: #a22938; color: #fff; font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 12px; font-weight: 600; }
.compare-modal__submit-btn { width: 100%; background: #a22938; color: #fff; padding: 1rem; border-radius: 25px; border: none; font-weight: 700; cursor: pointer; transition: background 0.2s ease; }
.compare-modal__submit-btn:hover { background: #8c1e2e; }

/* TABLE COMPARISON */
.compare-table-scroll { overflow-x: auto; margin-bottom: 1.5rem; }
.compare-table { width: 100%; border-collapse: collapse; min-width: 750px; }
.compare-table th, .compare-table td { padding: 1rem; border: 1px solid #eee; text-align: center; font-size: 0.85rem; line-height: 1.4; }
.sticky-col { text-align: left !important; font-weight: 700; background: #fafafa; color: #111; width: 180px; }
.this-model-col { border: 2px solid #a22938 !important; background: #fdf5f6; }
.this-model-badge { background: #a22938; color: #fff; font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 10px; display: inline-block; margin-bottom: 6px; }
.compare-product-img { width: 80px; height: 80px; margin: 0.5rem auto; display: flex; align-items: center; justify-content: center; }
.compare-product-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
.placeholder-img { width: 100%; height: 100%; background: #eee; border-radius: 8px; }
.compare-product-price { font-weight: 700; color: #a22938; margin: 0.3rem 0; font-size: 1rem; }
.compare-product-btn { display: inline-block; background: #a22938; color: #fff; padding: 0.5rem 1rem; border-radius: 12px; text-decoration: none; font-size: 0.75rem; font-weight: 600; margin-top: 0.4rem; }
.compare-modal__footer { display: flex; justify-content: center; gap: 1rem; }
.compare-btn-sec { padding: 0.75rem 2rem; border-radius: 20px; border: 1px solid #ccc; background: #fff; cursor: pointer; font-weight: 600; }

.compare-col.is-hidden { display: none !important; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const triggerBtn = document.getElementById('OpenCompareModal');
    if (triggerBtn) {
      triggerBtn.addEventListener('click', function() {
        document.getElementById('CompareModalStep1').classList.add('is-open');
      });
    }

    const checkboxes = document.querySelectorAll('.compare-checkbox');
    checkboxes.forEach(chk => {
      chk.addEventListener('change', function() {
        const parentLabel = this.closest('.compare-select-item');
        if (this.checked) {
          parentLabel.classList.add('is-selected');
        } else {
          parentLabel.classList.remove('is-selected');
        }
      });
    });
  });

  function closeCompareModal() {
    document.getElementById('CompareModalStep1').classList.remove('is-open');
    document.getElementById('CompareModalStep2').classList.remove('is-open');
  }

  function goToStep2() {
    const checkboxes = document.querySelectorAll('.compare-checkbox');
    checkboxes.forEach(chk => {
      const prodId = chk.getAttribute('data-product-id');
      const cols = document.querySelectorAll(`.compare-col[data-product-id="${prodId}"]`);
      
      cols.forEach(col => {
        if (chk.checked) {
          col.classList.remove('is-hidden');
        } else {
          col.classList.add('is-hidden');
        }
      });
    });

    document.getElementById('CompareModalStep1').classList.remove('is-open');
    document.getElementById('CompareModalStep2').classList.add('is-open');
  }

  function goToStep1() {
    document.getElementById('CompareModalStep2').classList.remove('is-open');
    document.getElementById('CompareModalStep1').classList.add('is-open');
  }
</script>

{% schema %}
{
  "name": "Product Compare Modal",
  "settings": [
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal Step 1 Title",
      "default": "Select Models to Compare"
    },
    {
      "type": "collection",
      "id": "compare_collection",
      "label": "Override Collection to Compare"
    }
  ],
  "presets": [{ "name": "Product Compare Modal" }]
}
{% endschema %}