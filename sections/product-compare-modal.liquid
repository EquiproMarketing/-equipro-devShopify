<div id="CustomCompareModal" class="custom-compare-modal-overlay" style="display: none;">
  <div class="custom-compare-modal-content">
    <button type="button" class="custom-compare-modal-close" id="CloseCompareModal">&times;</button>
    
    <div class="custom-compare-modal-header">
      <h2>{{ section.settings.heading | default: "Technical Model Comparison" }}</h2>
      <p>Compare key performance specs side by side to choose the best equipment for your treatment room.</p>
    </div>

    {%- assign collection_handle = section.settings.compare_collection -%}
    {%- assign compare_coll = collections[collection_handle] -%}

    {%- comment -%} FALLBACK AUTOMÁTICO SI LA COLECCIÓN CONFIGURADA NO TIENE PRODUCTOS {%- endcomment -%}
    {%- if compare_coll == blank or compare_coll.products.size == 0 -%}
      {%- assign compare_coll = product.collections.first -%}
    {%- endif -%}

    <div class="custom-compare-modal-body">
      {%- if compare_coll != blank and compare_coll.products.size > 0 -%}
        <div class="compare-table-wrapper">
          <table class="compare-table">
            <thead>
              <tr>
                <th class="feature-label">Specifications</th>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <th class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {%- if prod.handle == product.handle -%}
                      <span class="this-model-badge">This Model</span>
                    {%- endif -%}
                    {%- if prod.featured_media != blank -%}
                      <img src="{{ prod.featured_media | image_url: width: 200 }}" alt="{{ prod.title | escape }}" class="compare-product-img" loading="lazy">
                    {%- endif -%}
                    <h3 class="compare-product-title">{{ prod.title }}</h3>
                    <p class="compare-product-price">{{ prod.price | money }}</p>
                    <a href="{{ prod.url }}" class="compare-view-btn">View Details</a>
                  </th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              <!-- CARACTERÍSTICA 1: TIPO DE ELEVACIÓN / SISTEMA -->
              <tr>
                <td class="feature-label">System / Elevation</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {{ prod.metafields.custom.system_type | default: "Hydraulic System" }}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- CARACTERÍSTICA 2: ROTACIÓN / ARTICULACIÓN -->
              <tr>
                <td class="feature-label">Rotation & Articulation</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {{ prod.metafields.custom.rotation | default: "360º Swivel with Lock" }}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- CARACTERÍSTICA 3: RECTIFICACIÓN Y REPOSAPIÉS -->
              <tr>
                <td class="feature-label">Backrest & Legrest</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {{ prod.metafields.custom.adjustments | default: "Manual Independent Adjustment" }}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- CARACTERÍSTICA 4: CAPACIDAD DE PESO -->
              <tr>
                <td class="feature-label">Weight Capacity</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {{ prod.metafields.custom.weight_capacity | default: "450 lbs / 204 kg" }}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- CARACTERÍSTICA 5: APLICACIONES PRINCIPALES -->
              <tr>
                <td class="feature-label">Recommended For</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {{ prod.metafields.custom.applications | default: "Facials, Pedicure, Body Treatments" }}
                  </td>
                {%- endfor -%}
              </tr>

              <!-- CARACTERÍSTICA 6: GARANTÍA -->
              <tr>
                <td class="feature-label">Warranty & Safety</td>
                {%- for prod in compare_coll.products limit: 4 -%}
                  <td class="{% if prod.handle == product.handle %}highlight-col{% endif %}">
                    {{ prod.metafields.custom.warranty | default: "2 Years Full Warranty | CSA & UL" }}
                  </td>
                {%- endfor -%}
              </tr>
            </tbody>
          </table>
        </div>
      {%- else -%}
        <p class="compare-empty-notice">No related products found in this category to compare.</p>
      {%- endif -%}

      <div class="compare-modal-footer">
        <button type="button" class="compare-footer-btn" id="CloseCompareModalFooter">Close</button>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-compare-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .custom-compare-modal-content {
    background: #ffffff;
    width: 100%;
    max-width: 1100px;
    border-radius: 16px;
    padding: 35px 30px;
    position: relative;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    max-height: 88vh;
    overflow-y: auto;
  }

  .custom-compare-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #f4f4f5;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
    color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-compare-modal-header h2 {
    font-size: 26px;
    font-weight: 700;
    color: #a22938;
    margin: 0 0 6px 0;
  }

  .custom-compare-modal-header p {
    font-size: 14px;
    color: #666;
    margin: 0 0 25px 0;
  }

  .compare-table-wrapper {
    overflow-x: auto;
    margin-bottom: 25px;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
    font-size: 13px;
  }

  .compare-table th, 
  .compare-table td {
    padding: 14px 12px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
  }

  .compare-table th.feature-label,
  .compare-table td.feature-label {
    text-align: left;
    font-weight: 700;
    color: #1e293b;
    background: #f8fafc;
    width: 170px;
    min-width: 150px;
    border-right: 1px solid #e2e8f0;
  }

  .compare-table th.highlight-col,
  .compare-table td.highlight-col {
    background: #fff5f5;
    border-left: 2px solid #a22938;
    border-right: 2px solid #a22938;
  }

  .this-model-badge {
    display: inline-block;
    background: #a22938;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 12px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .compare-product-img {
    max-width: 90px;
    height: 90px;
    object-fit: contain;
    margin: 0 auto 10px auto;
    display: block;
  }

  .compare-product-title {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
    margin: 0 0 6px 0;
  }

  .compare-product-price {
    font-size: 14px;
    font-weight: 700;
    color: #a22938;
    margin: 0 0 10px 0;
  }

  .compare-view-btn {
    display: inline-block;
    padding: 6px 14px;
    background: #a22938;
    color: #ffffff;
    border-radius: 20px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
  }

  .compare-modal-footer {
    display: flex;
    justify-content: center;
    margin-top: 15px;
  }

  .compare-footer-btn {
    padding: 10px 24px;
    border-radius: 25px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const openBtn = document.getElementById('OpenCompareModal');
    const modal = document.getElementById('CustomCompareModal');
    const closeBtn = document.getElementById('CloseCompareModal');
    const closeFooter = document.getElementById('CloseCompareModalFooter');

    if (openBtn && modal) {
      openBtn.addEventListener('click', function(e) {
        e.preventDefault();
        modal.style.display = 'flex';
      });
    }

    const closeModal = () => { if (modal) modal.style.display = 'none'; };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeFooter) closeFooter.addEventListener('click', closeModal);

    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });
    }
  });
</script>

{% schema %}
{
  "name": "Product Compare Modal",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Modal Heading",
      "default": "Technical Model Comparison"
    },
    {
      "type": "collection",
      "id": "compare_collection",
      "label": "Collection to Compare"
    }
  ],
  "presets": [
    {
      "name": "Product Compare Modal"
    }
  ]
}
{% endschema %}