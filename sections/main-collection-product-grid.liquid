<div class="collection-products page-width">
  <div class="collection-products__back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none"><path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round"/></svg>
      Back
    </a>
  </div>

  <div class="collection-products__grid">
    {% for product in collection.products %}
      <div class="product-card-item">
        <a href="{{ product.url }}" class="product-card-item__media">
          {% if product.featured_image != blank %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" class="product-card-item__img product-card-item__img--primary" loading="lazy">
            {% if product.images[1] != blank %}
              <img src="{{ product.images[1] | image_url: width: 600 }}" class="product-card-item__img product-card-item__img--secondary" loading="lazy">
            {% endif %}
          {% else %}
            <div class="product-card-item__placeholder"></div>
          {% endif %}
        </a>

        <div class="product-card-item__info">
          <div class="product-card-item__header">
            <h3 class="product-card-item__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="product-card-item__rating">★ 4.8 (15)</div>
          </div>
          <p class="product-card-item__vendor">{{ product.vendor | default: collection.title }}</p>
          <p class="product-card-item__price">From {{ product.price | money }}</p>
          
          <a href="{{ product.url }}" class="product-card-item__btn">See Product</a>
        </div>
      </div>
    {% else %}
      {% for i in (1..4) %}
        <div class="product-card-item">
          <div class="product-card-item__media">
            <div class="product-card-item__placeholder"></div>
          </div>
          <div class="product-card-item__info">
            <div class="product-card-item__header">
              <h3 class="product-card-item__title">TM-3 Standard</h3>
              <div class="product-card-item__rating">★ 4.8 (15)</div>
            </div>
            <p class="product-card-item__vendor">Trolleys</p>
            <p class="product-card-item__price">From CA$375.00</p>
            <a href="#" class="product-card-item__btn">See Product</a>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<style>
.collection-products { margin-bottom: 4rem; }
.collection-products__back { margin-bottom: 1.5rem; }
.collection-products__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}
.product-card-item {
  background: #ffffff;
  border-radius: 20px;
  padding: 1rem;
  border: 1px solid #f0f0f0;
  display: flex;
  flex-direction: column;
}
.product-card-item__media {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 16px;
  overflow: hidden;
  background-color: #f7f7f7;
}
.product-card-item__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease;
}
.product-card-item__img--secondary { position: absolute; inset: 0; opacity: 0; }
.product-card-item__media:hover .product-card-item__img--primary { opacity: 0; }
.product-card-item__media:hover .product-card-item__img--secondary { opacity: 1; }
.product-card-item__placeholder { width: 100%; height: 100%; background: #e8e8e8; }
.product-card-item__info { margin-top: 1rem; display: flex; flex-direction: column; flex-grow: 1; }
.product-card-item__header { display: flex; justify-content: space-between; align-items: center; }
.product-card-item__title { font-size: 1rem; font-weight: 700; color: #a22938; margin: 0; }
.product-card-item__title a { color: #a22938; text-decoration: none; }
.product-card-item__rating { font-size: 0.75rem; color: #a22938; font-weight: 600; }
.product-card-item__vendor { font-size: 0.8rem; color: #888888; margin: 0.2rem 0; }
.product-card-item__price { font-size: 0.95rem; font-weight: 700; color: #1a1a1a; margin-bottom: 1rem; }
.product-card-item__btn {
  margin-top: auto;
  background-color: #a22938;
  color: #ffffff;
  text-align: center;
  padding: 0.65rem;
  border-radius: 25px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.85rem;
}

/* Reglas Móvil: 2 Tarjetas por fila y ocultar botón "See Product" */
@media (max-width: 767px) {
  .collection-products__grid {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 0.85rem !important;
  }
  .product-card-item { padding: 0.65rem !important; }
  .product-card-item__btn { display: none !important; }
}
</style>

{% schema %}
{
  "name": "Collection Product Grid",
  "settings": [],
  "presets": [{ "name": "Collection Product Grid" }]
}
{% endschema %}