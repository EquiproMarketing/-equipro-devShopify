{{ 'collection-products.css' | asset_url | stylesheet_tag }}

<section class="collection-products page-width" id="CollectionProducts-{{ section.id }}">
  <div class="collection-products__back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>{{ section.settings.back_text | default: "Back" }}</span>
    </a>
  </div>

  {% paginate collection.products by 24 %}
  <div class="collection-products__grid">
    {% for product in collection.products %}
      <div class="custom-treatment-card">
        
        {% comment %} APPLE-STYLE ROUNDED IMAGE CONTAINER (4:5 ASPECT RATIO) {% endcomment %}
        <a href="{{ product.url }}" class="custom-treatment-card__image-container">
          {% if product.featured_image != blank %}
            <img 
              src="{{ product.featured_image | image_url: width: 600 }}" 
              alt="{{ product.featured_image.alt | escape }}" 
              class="custom-treatment-card__image custom-treatment-card__image--primary" 
              loading="lazy"
              width="240"
              height="300"
            >
            {% if product.images[1] != blank %}
              <img 
                src="{{ product.images[1] | image_url: width: 600 }}" 
                alt="{{ product.images[1].alt | escape }}" 
                class="custom-treatment-card__image custom-treatment-card__image--secondary" 
                loading="lazy"
                width="240"
                height="300"
              >
            {% endif %}
          {% else %}
            <div class="custom-treatment-card__placeholder"></div>
          {% endif %}
        </a>

        {% comment %} DYNAMIC COLOR SWATCHES FROM PRODUCT VARIANTS {% endcomment %}
        <div class="custom-treatment-card__swatches">
          {% assign color_option = product.options_with_values | where: "name", "Color" | first %}
          {% if color_option == blank %}
            {% assign color_option = product.options_with_values | where: "name", "Couleur" | first %}
          {% endif %}

          {% if color_option != blank %}
            {% for value in color_option.values limit: 5 %}
              {% assign color_downcase = value | downcase %}
              <span 
                class="custom-treatment-card__swatch-dot" 
                style="background-color: {{ color_downcase }};"
                title="{{ value | escape }}"
              ></span>
            {% endfor %}
          {% endif %}
        </div>

        {% comment %} CARD DETAILS AND TEXTS {% endcomment %}
        <div class="custom-treatment-card__content">
          <h3 class="custom-treatment-card__title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          
          <p class="custom-treatment-card__subtitle">
            {{ product.vendor | default: collection.title }}
          </p>

          <p class="custom-treatment-card__price">
            {% if product.price_varies %}
              From {{ product.price_min | money }}
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </p>

          {% comment %} ACTION BUTTONS {% endcomment %}
          <div class="custom-treatment-card__actions">
            <a href="{{ product.url }}" class="custom-treatment-btn custom-treatment-btn--primary">
              {{ section.settings.btn_primary_text | default: "En savoir plus" }}
            </a>

            {% if section.settings.btn_secondary_text != blank %}
              <a href="{{ product.url }}" class="custom-treatment-btn custom-treatment-btn--link">
                {{ section.settings.btn_secondary_text }}
              </a>
            {% endif %}
          </div>
        </div>

      </div>
    {% else %}
      <p class="collection-products__empty">{{ 'collections.no_products' | t }}</p>
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}
    <nav class="collection-products__pagination" aria-label="{{ 'collections.pagination' | t }}">
      {{ paginate | default_pagination }}
    </nav>
  {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection Product Grid",
  "tag": "section",
  "class": "section-collection-products",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Button Text",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Label",
      "default": "En savoir plus"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary Link Label",
      "default": "Acheter >"
    }
  ],
  "presets": [
    {
      "name": "Collection Product Grid"
    }
  ]
}
{% endschema %}