<div class="manuals-page page-width">
  {%- comment -%} RETURN TO ASSISTANCE HUB {%- endcomment -%}
  <div class="manuals-page__nav-back">
    <a href="/pages/assistance" class="manuals-back-link">&larr; Back to Support Hub</a>
  </div>

  <div class="manuals-page__header">
    <h1 class="manuals-page__title">{{ section.settings.title | escape }}</h1>
    
    {%- comment -%} APPLE-STYLE LEGAL NOTICE BOX {%- endcomment -%}
    {%- if section.settings.show_legal_box -%}
      <div class="manuals-legal-box">
        {%- if section.settings.legal_box_title != blank -%}
          <h2 class="manuals-legal-box__title">{{ section.settings.legal_box_title | escape }}</h2>
        {%- endif -%}
        <div class="manuals-legal-box__content rte">
          {{ section.settings.legal_box_text }}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} SEARCH BAR WITH AUTOCOMPLETE DROPDOWN {%- endcomment -%}
    <div class="manuals-search-wrapper">
      <svg class="manuals-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#86868b" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="ManualsSearchInput" 
        class="manuals-search-input" 
        placeholder="{{ section.settings.search_placeholder | escape }}"
        autocomplete="off"
      >
      <div id="ManualsAutocompleteDropdown" class="manuals-autocomplete-dropdown" style="display: none;"></div>
    </div>
  </div>

  {%- comment -%} CATEGORY TABS {%- endcomment -%}
  <div class="manuals-tabs">
    <button class="manuals-tab-btn active" data-tab="all">All Documentation</button>
    <button class="manuals-tab-btn" data-tab="warranties">Warranties & Certificates</button>
    <button class="manuals-tab-btn" data-tab="specifications">Technical Specs</button>
    <button class="manuals-tab-btn" data-tab="assembly">Assembly & Operation</button>
  </div>

  {%- comment -%} DOCUMENTATION COLUMNS GRID {%- endcomment -%}
  <div class="manuals-content-wrapper">
    {%- assign blocks = section.blocks -%}
    {%- if blocks.size > 0 -%}
      {%- assign group_names = "" -%}
      {%- for block in blocks -%}
        {%- assign g_name = block.settings.group_title | strip -%}
        {%- unless group_names contains g_name -%}
          {%- assign group_names = group_names | append: g_name | append: "|||" -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign groups_array = group_names | split: "|||" -%}

      <div class="manuals-columns-grid" id="ManualsGrid">
        {%- for group in groups_array -%}
          {%- if group != blank -%}
            <div 
              class="manual-group-column" 
              data-group="{{ group | downcase }}"
            >
              <h3 class="manual-group__title">{{ group }}</h3>
              <ul class="manual-group__list">
                {%- for block in blocks -%}
                  {%- if block.settings.group_title == group -%}
                    {%- assign lang_class = "" -%}
                    {%- if block.settings.language == "en" -%}
                      {%- assign lang_class = "lang-en" -%}
                    {%- elsif block.settings.language == "fr" -%}
                      {%- assign lang_class = "lang-fr" -%}
                    {%- endif -%}

                    <li 
                      class="manual-item {{ lang_class }}" 
                      data-category="{{ block.settings.tab_category }}" 
                      data-title="{{ block.settings.document_title | downcase }}"
                      data-url="{{ block.settings.pdf_url }}"
                      data-group-name="{{ group }}"
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.pdf_url != blank -%}
                        <a href="{{ block.settings.pdf_url }}" target="_blank" rel="noopener" class="manual-link">
                          {{ block.settings.document_title }} <span class="pdf-tag">(PDF)</span>
                        </a>
                      {%- else -%}
                        <span class="manual-link disabled">{{ block.settings.document_title }} <span class="pdf-tag">(PDF)</span></span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div id="ManualsNoResults" class="manuals-no-results" style="display: none;">
      <p>No documentation found matching your query.</p>
    </div>
  </div>
</div>

<style>
.manuals-page {
  padding-top: 3rem;
  padding-bottom: 5rem;
  max-width: 1080px;
  margin: 0 auto;
}

.manuals-page__nav-back {
  margin-bottom: 1.5rem;
}

.manuals-back-link {
  display: inline-flex;
  align-items: center;
  font-size: 0.9rem;
  font-weight: 600;
  color: #ab273b;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.manuals-back-link:hover {
  opacity: 0.8;
  text-decoration: underline;
}

.manuals-page__title {
  text-align: center;
  font-size: 2.2rem;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 2rem;
}

.manuals-legal-box {
  background-color: #f5f5f7;
  border-radius: 18px;
  padding: 2.5rem 3rem;
  margin-bottom: 2.5rem;
  text-align: center;
}

.manuals-legal-box__title {
  font-size: 1.4rem;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 1rem;
}

.manuals-legal-box__content {
  font-size: 0.92rem;
  line-height: 1.6;
  color: #424245;
  max-width: 820px;
  margin: 0 auto;
}

.manuals-search-wrapper {
  position: relative;
  max-width: 500px;
  margin: 0 auto 2.5rem auto;
}

.manuals-search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
}

.manuals-search-input {
  width: 100%;
  padding: 12px 16px 12px 44px;
  border-radius: 10px;
  border: 1px solid #d2d2d7;
  font-size: 0.92rem;
  background-color: #ffffff;
  outline: none;
  box-sizing: border-box;
}

.manuals-autocomplete-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  right: 0;
  background-color: #ffffff;
  border: 1px solid #d2d2d7;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  z-index: 100;
  overflow: hidden;
  max-height: 320px;
  overflow-y: auto;
}

.autocomplete-suggestion {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  text-decoration: none;
  border-bottom: 1px solid #f5f5f7;
  transition: background-color 0.15s ease;
}

.autocomplete-suggestion:last-child {
  border-bottom: none;
}

.autocomplete-suggestion:hover {
  background-color: #f5f5f7;
}

.suggestion-title {
  font-size: 0.9rem;
  color: #1d1d1f;
}

.suggestion-title strong {
  color: #ab273b;
  font-weight: 700;
}

.suggestion-group {
  font-size: 0.75rem;
  color: #86868b;
  background-color: #e5e5ea;
  padding: 3px 8px;
  border-radius: 4px;
}

.manuals-tabs {
  display: flex;
  justify-content: center;
  gap: 2rem;
  border-bottom: 1px solid #d2d2d7;
  margin-bottom: 3rem;
}

.manuals-tab-btn {
  background: transparent;
  border: none;
  font-size: 0.95rem;
  color: #6e6e73;
  padding-bottom: 12px;
  cursor: pointer;
  position: relative;
  font-weight: 500;
}

.manuals-tab-btn.active {
  color: #1d1d1f;
  font-weight: 600;
}

.manuals-tab-btn.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background-color: #1d1d1f;
}

.manuals-columns-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2.5rem;
}

.manual-group__title {
  font-size: 1.05rem;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 1rem;
}

.manual-group__list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.manual-group__list li {
  margin-bottom: 0.65rem;
}

.manual-link {
  font-size: 0.88rem;
  color: #0066cc;
  text-decoration: none;
  line-height: 1.4;
  display: inline-block;
}

.manual-link:hover {
  text-decoration: underline;
}

.manual-link.disabled {
  color: #86868b;
  cursor: not-allowed;
}

.pdf-tag {
  font-size: 0.78rem;
  color: #86868b;
  margin-left: 3px;
}

.manuals-no-results {
  text-align: center;
  padding: 2rem;
  color: #86868b;
}

html[lang="en"] .lang-fr {
  display: none !important;
}

html[lang="fr"] .lang-en {
  display: none !important;
}

@media (max-width: 767px) {
  .manuals-legal-box { padding: 1.5rem; }
  .manuals-tabs { overflow-x: auto; justify-content: flex-start; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.manuals-tab-btn');
    const columns = document.querySelectorAll('.manual-group-column');
    const searchInput = document.getElementById('ManualsSearchInput');
    const dropdown = document.getElementById('ManualsAutocompleteDropdown');
    const noResults = document.getElementById('ManualsNoResults');
    const allItems = document.querySelectorAll('.manual-item');

    let currentTab = 'all';

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentTab = btn.getAttribute('data-tab');
        filterGrid();
        if (dropdown) dropdown.style.display = 'none';
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        filterGrid();
        renderAutocomplete(query);
      });

      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
          dropdown.style.display = 'none';
        }
      });
    }

    function renderAutocomplete(query) {
      if (!dropdown) return;

      if (query.length < 2) {
        dropdown.style.display = 'none';
        dropdown.innerHTML = '';
        return;
      }

      const matches = [];

      allItems.forEach(item => {
        const title = item.getAttribute('data-title');
        const url = item.getAttribute('data-url');
        const cat = item.getAttribute('data-category');
        const group = item.getAttribute('data-group-name');

        const matchesTab = (currentTab === 'all' || cat === currentTab);

        if (matchesTab && title.includes(query) && url && url !== '#') {
          matches.push({ title: item.querySelector('.manual-link').innerText, url, group });
        }
      });

      if (matches.length > 0) {
        dropdown.innerHTML = matches.slice(0, 6).map(m => `
          <a href="${m.url}" target="_blank" rel="noopener" class="autocomplete-suggestion">
            <span class="suggestion-title">${highlightQuery(m.title, query)}</span>
            <span class="suggestion-group">${m.group}</span>
          </a>
        `).join('');
        dropdown.style.display = 'block';
      } else {
        dropdown.style.display = 'none';
      }
    }

    function highlightQuery(text, query) {
      const reg = new RegExp(`(${query})`, 'gi');
      return text.replace(reg, '<strong>$1</strong>');
    }

    function filterGrid() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let hasGlobalVisible = false;

      columns.forEach(col => {
        let colHasVisibleItems = false;
        const colItems = col.querySelectorAll('.manual-item');

        colItems.forEach(item => {
          const itemCat = item.getAttribute('data-category');
          const itemTitle = item.getAttribute('data-title');

          const matchesTab = (currentTab === 'all' || itemCat === currentTab);
          const matchesSearch = query === '' || itemTitle.includes(query);

          if (matchesTab && matchesSearch) {
            item.style.display = 'list-item';
            colHasVisibleItems = true;
          } else {
            item.style.display = 'none';
          }
        });

        if (colHasVisibleItems) {
          col.style.display = 'block';
          hasGlobalVisible = true;
        } else {
          col.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = hasGlobalVisible ? 'none' : 'block';
      }
    }

    filterGrid();
  });
</script>

{% schema %}
{
  "name": "Manuals & Legal Hub",
  "tag": "section",
  "class": "section-manuals-library",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Documentation & Licensing"
    },
    {
      "type": "header",
      "content": "Legal Notice Box Settings"
    },
    {
      "type": "checkbox",
      "id": "show_legal_box",
      "label": "Show Legal Notice Box",
      "default": true
    },
    {
      "type": "text",
      "id": "legal_box_title",
      "label": "Legal Box Title",
      "default": "Proprietary Rights & Documentation Notice"
    },
    {
      "type": "richtext",
      "id": "legal_box_text",
      "label": "Legal Box Content",
      "default": "<p>All technical manuals, schematics, and operating guides provided herein are the exclusive intellectual property of Equipro Beauty. Unauthorized copying, reproduction, distribution, or reverse engineering of equipment components based on these documents is strictly prohibited under federal trademark and copyright laws.</p>"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search documentation by model or series..."
    }
  ],
  "blocks": [
    {
      "type": "pdf_document",
      "name": "PDF Document",
      "settings": [
        {
          "type": "text",
          "id": "group_title",
          "label": "Category / Subcategory Name",
          "default": "Facial Steamers"
        },
        {
          "type": "select",
          "id": "tab_category",
          "label": "Assign to Tab",
          "options": [
            { "value": "warranties", "label": "Warranties & Certificates" },
            { "value": "specifications", "label": "Technical Specs" },
            { "value": "assembly", "label": "Assembly & Operation" }
          ],
          "default": "specifications"
        },
        {
          "type": "text",
          "id": "document_title",
          "label": "Document Name",
          "default": "EI-501 Royal Specifications"
        },
        {
          "type": "url",
          "id": "pdf_url",
          "label": "PDF File URL (CDN Link)"
        },
        {
          "type": "select",
          "id": "language",
          "label": "Document Language Filter",
          "options": [
            { "value": "all", "label": "Show Always (Bilingual / Both)" },
            { "value": "en", "label": "English Only" },
            { "value": "fr", "label": "French Only" }
          ],
          "default": "all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manuals & Legal Hub",
      "blocks": [
        {
          "type": "pdf_document",
          "settings": {
            "group_title": "Facial Steamers",
            "tab_category": "specifications",
            "document_title": "EI-501 Royal Specifications (EN)",
            "pdf_url": "https://cdn.shopify.com/s/files/1/0785/1992/6957/files/Specifications_EI-501-Royal_EN_2023.pdf?v=1788196302",
            "language": "all"
          }
        }
      ]
    }
  ]
}
{% endschema %}