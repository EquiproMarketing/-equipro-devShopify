{{ 'section-manuals.css' | asset_url | stylesheet_tag }}

<div class="manuals-page page-width">
  <div class="manuals-page__nav-back">
    <a href="/pages/assistance" class="manuals-back-link">&larr; Back to Support Hub</a>
  </div>

  <div class="manuals-page__header">
    <h1 class="manuals-page__title">{{ section.settings.title | escape }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="manuals-page__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    <div class="manuals-search-wrapper">
      <svg class="manuals-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#86868b" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="ManualsSearchInput" 
        class="manuals-search-input" 
        placeholder="{{ section.settings.search_placeholder | escape }}"
        autocomplete="off"
      >
    </div>
  </div>

  {%- assign manual_blocks = section.blocks | where: 'type', 'manual_item' -%}
  {%- if manual_blocks.size > 0 -%}
    <div class="manuals-grid" id="ManualsGrid">
      {%- for block in manual_blocks -%}
        <div class="manual-card" data-manual-title="{{ block.settings.title | downcase }}" data-manual-category="{{ block.settings.category | downcase }}" {{ block.shopify_attributes }}>
          <div class="manual-card__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ab273b" stroke-width="1.8">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="manual-card__details">
            <span class="manual-card__badge">{{ block.settings.category | default: "General" }}</span>
            <h3 class="manual-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="manual-card__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
          <div class="manual-card__action">
            {%- if block.settings.pdf_url != blank -%}
              <a href="{{ block.settings.pdf_url }}" target="_blank" rel="noopener" class="manual-download-btn">
                <span>DOWNLOAD PDF</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            {%- else -%}
              <span class="manual-unavailable">Coming Soon</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div id="ManualsNoResults" class="manuals-no-results" style="display: none;">
      <p>No documentation found matching your search term.</p>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('ManualsSearchInput');
    const cards = document.querySelectorAll('.manual-card');
    const noResults = document.getElementById('ManualsNoResults');

    if (!searchInput) return;

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      let hasVisible = false;

      cards.forEach(card => {
        const title = card.getAttribute('data-manual-title') || '';
        const category = card.getAttribute('data-manual-category') || '';

        if (title.includes(query) || category.includes(query)) {
          card.style.display = 'flex';
          hasVisible = true;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = hasVisible ? 'none' : 'block';
      }
    });
  });
</script>

{% schema %}
{
  "name": "Manuals Library",
  "tag": "section",
  "class": "section-manuals-library",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Assembly & Setup Manuals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Download technical specifications, wiring diagrams, and user manuals for Equipro equipment."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search by model number or equipment name (e.g., EI-504, Vapozon)..."
    }
  ],
  "blocks": [
    {
      "type": "manual_item",
      "name": "PDF Manual",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Document / Model Title",
          "default": "Vapoderm Facial Steamer Model EI-500"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Equipment Category",
          "default": "Facial Steamers"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description / SKU Details",
          "default": "Includes assembly instructions, electrical diagram, and de-calcifying maintenance guide."
        },
        {
          "type": "url",
          "id": "pdf_url",
          "label": "PDF File URL (CDN Link)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manuals Library",
      "blocks": [
        {
          "type": "manual_item",
          "settings": {
            "title": "I-Lift Electric Treatment Bed #10800",
            "category": "Treatment Beds",
            "description": "Full assembly manual, hand remote control pairing guide, and load specifications."
          }
        },
        {
          "type": "manual_item",
          "settings": {
            "title": "Vapozon Facial Steamer #14000",
            "category": "Facial Steamers",
            "description": "Operating instructions, essential oil basket guide, and cleaning procedures."
          }
        },
        {
          "type": "manual_item",
          "settings": {
            "title": "Mag-Lamp LED Magnifying Light #11200",
            "category": "Magnifying Lamps",
            "description": "Clamp mounting instructions, lens care, and power supply specs."
          }
        }
      ]
    }
  ]
}
{% endschema %}