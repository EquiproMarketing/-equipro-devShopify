{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'product-technical-table.css' | asset_url | stylesheet_tag }}
{{ 'quote-modal.css' | asset_url | stylesheet_tag }}

<div class="product-page page-width">
  
  <!-- BACK BUTTON -->
  <div class="product-page__back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none"><path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round"/></svg>
      Back
    </a>
  </div>

  <!-- FILA 1: INFORMACIÓN DE TEXTO E IMÁGENES -->
  <div class="product-main-grid">
    
    <!-- Columna Izquierda: Títulos y Textos -->
    <div class="product-info-col">
      <h1 class="product-info__title">{{ product.title | default: "Professional Single Wax Heater" }}</h1>
      
      <div class="product-info__intro-highlight">
        <p>Precision-engineered for professional depilatory workflows, the Equipro Single Wax Heater delivers fast, uniform heat distribution in a durable compact metal housing designed for heavy daily salon use.</p>
      </div>

      <div class="product-info__description">
        <p>Purpose-built for estheticians and hair-removal specialists, this unit features a 3.625-inch reservoir compatible with standard Canadian and European wax formats. The dial-operated manual thermostat guarantees accurate temperature control across all warm or hot wax formulas...</p>
      </div>

      <h2 class="product-info__subtitle">Engineering for Safety and Professional Efficiency</h2>
      <div class="product-info__description">
        <p>Equipped with an integrated overheat protection thermostat and CSA/UL approved electrical components, Equipro wax warmers preserve product consistency while ensuring maximum safety for the esthetic station.</p>
      </div>

      <!-- BOTÓN COMPARAR PRODUCTOS (ABRE POPUP) -->
      <button class="product-compare-trigger-btn" id="OpenCompareModal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
        Compare with other models
      </button>
    </div>

    <!-- Columna Derecha: Galería de Imágenes + Botón Get a Quote Integrado -->
    <div class="product-gallery-col">
      <div class="product-gallery">
        <div class="product-gallery__main">
          {% if product.featured_image != blank %}
            <img id="MainProductImg" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}">
          {% else %}
            <div class="product-gallery__placeholder"></div>
          {% endif %}
        </div>
        
        <div class="product-gallery__thumbs">
          {% for image in product.images limit: 5 %}
            <img src="{{ image | image_url: width: 150 }}" class="thumb-img {% if forloop.first %}is-active{% endif %}" onclick="changeMainImg(this.src)">
          {% else %}
            <div class="thumb-placeholder"></div>
            <div class="thumb-placeholder"></div>
            <div class="thumb-placeholder"></div>
            <div class="thumb-placeholder"></div>
          {% endfor %}
        </div>

        <!-- Botón de Cotización ubicado dentro del bloque de imágenes -->
        <div class="product-gallery__quote-cta" style="margin-top: 16px;">
          <button 
            type="button" 
            class="button button--secondary button--full-width" 
            data-open-quote-modal
            data-product-title="{{ product.title | escape }}"
            style="border-color: #ab273b; color: #ab273b; width: 100%; font-weight: 700;"
          >
            Get a Quote / Solicitar Cotización
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Render del Snippet de Cotización -->
  {% render 'quote-modal' %}

  <!-- FILA 2: COMPRA + TABLA DE ESPECIFICACIONES -->
  <div class="product-secondary-grid" style="margin-top: 40px;">
    
    <!-- Columna Izquierda: Precio, Variantes, Carrito y Dropdowns -->
    <div class="product-purchase-col">
      <div class="product-price">From {{ product.price | default: 18500 | money }}</div>

      {% form 'product', product %}
        <div class="product-option">
          <label>Couleur:</label>
          <select name="options[Couleur]" class="product-select">
            <option>White</option>
          </select>
        </div>

        <div class="product-buy-row">
          <div class="product-quantity">
            <button type="button" onclick="adjustQty(-1)">−</button>
            <input type="number" id="QuantityInput" name="quantity" value="1" min="1">
            <button type="button" onclick="adjustQty(1)">+</button>
          </div>
          <button type="submit" class="product-add-cart-btn">ADD TO CART</button>
        </div>
      {% endform %}

      <!-- ACORDEÓN PROFESIONAL -->
      <div class="product-accordions">
        <h3 class="product-acc-title">Key Features for the Professional Station</h3>
        
        <details class="product-acc-item">
          <summary>Precise Temperature Regulation: <span>+</span></summary>
          <p>Manual thermostat dial maintains exact target viscosity without scorching delicate depilatory wax formulas.</p>
        </details>
        
        <details class="product-acc-item">
          <summary>Universal Reservoir Fit: <span>+</span></summary>
          <p>3.625" opening fits standard Canadian and European wax cans, plus the optional 42100 aluminum insert.</p>
        </details>
        
        <details class="product-acc-item">
          <summary>Commercial Sanitation: <span>+</span></summary>
          <p>Scratch-resistant enamel surface enables quick wiping with hospital-grade disinfectant between clients.</p>
        </details>
      </div>

      <!-- SECCIÓN SHIPPING -->
      <div class="product-shipping-block">
        <h4 class="product-shipping__title">Shipping</h4>
        <p>Standard delivery typically takes <strong>5–7 business days</strong>, while expedited shipping takes <strong>2–3 business days</strong>.</p>
        
        <button class="product-shipping-calc-btn" onclick="alert('Enter your postal code at checkout to calculate exact delivery dates.')">
          Calculate estimated delivery date
        </button>
      </div>
    </div>

    <!-- Columna Derecha: Tabla de Especificaciones Reales (SKU 41100) -->
    <div class="product-specs-col">
      <div class="tech-table-wrapper">
        <table class="tech-table">
          <thead>
            <tr>
              <th>TECHNICAL ASPECT</th>
              <th>SPECIFICATION DETAILS</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Manufacturer</td><td>Equipro Beauty</td></tr>
            <tr><td>Model SKU</td><td>41100</td></tr>
            <tr><td>Primary Materials</td><td>Heavy-duty metal housing with scratch-resistant white enamel coating</td></tr>
            <tr><td>Product Type</td><td>Professional Single Wax Heater</td></tr>
            <tr><td>Wax Compatibility</td><td>Designed for warm or hot depilatory wax</td></tr>
            <tr><td>Reservoir Diameter</td><td>3.625 in (Formats Canadien et Européen)</td></tr>
            <tr><td>Control Type</td><td>Precise dial-operated manual thermostat</td></tr>
            <tr><td>Heating Element</td><td>High-performance rapid heating technology</td></tr>
            <tr><td>Dimensions (L x W x H)</td><td>8.25 in x 7.00 in x 5.00 in</td></tr>
            <tr><td>Weight</td><td>7.0 lb / 3.2 kg</td></tr>
            <tr><td>Safety Features</td><td>On/Off indicator power switch and overheat protection thermostat</td></tr>
            <tr><td>Compatible Accessories</td><td>42100 Standard Aluminum Container (400 g / 14 oz capacity)</td></tr>
            <tr><td>Certifications</td><td>CSA & UL Approved components</td></tr>
            <tr><td>Warranty</td><td>2 Years Warranty</td></tr>
            <tr><td>Country of Origin</td><td>Made in Canada</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'quote-modal.js' | asset_url }}" defer="defer"></script>
<script>
  function changeMainImg(src) {
    document.getElementById('MainProductImg').src = src;
    document.querySelectorAll('.thumb-img').forEach(el => el.classList.remove('is-active'));
    if (event && event.target) {
      event.target.classList.add('is-active');
    }
  }

  function adjustQty(val) {
    const input = document.getElementById('QuantityInput');
    let current = parseInt(input.value) || 1;
    current += val;
    if (current < 1) current = 1;
    input.value = current;
  }
</script>

{% schema %}
{
  "name": "Main Product Page",
  "settings": [],
  "presets": [{ "name": "Main Product Page" }]
}
{% endschema %}