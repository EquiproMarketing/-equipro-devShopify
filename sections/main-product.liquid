{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'quote-modal.css' | asset_url | stylesheet_tag }}

<div class="product-page page-width" id="ProductMain-{{ section.id }}">
  <div class="product-master-grid">
    
    <!-- COLUMNA IZQUIERDA: Info, Formulario de Compra, Acordeón y Envíos -->
    <div class="product-left-col">
      <div class="product-page__back">
        <a href="javascript:history.back()" class="back-link">
          <svg width="8" height="12" viewBox="0 0 8 12" fill="none">
            <path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>{{ section.settings.back_text | default: "Back" }}</span>
        </a>
      </div>

      <h1 class="product-info__title">
        {{ section.settings.custom_title | default: product.title | default: "Round Air-lift Stool" }}
      </h1>
      
      {% assign intro_text = section.settings.intro_highlight %}
      {% if intro_text != blank %}
        <div class="product-info__intro-highlight">
          <p>{{ intro_text }}</p>
        </div>
      {% endif %}

      <div class="product-info__description">
        {% if section.settings.custom_description != blank %}
          {{ section.settings.custom_description }}
        {% elsif product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>The 31100 Air-lift stool is purpose-built for licensed professionals, including aestheticians, clinical spa technicians, and massage therapists.</p>
        {% endif %}
      </div>

      <!-- COMPRA -->
      <div class="product-buy-box">
        <div class="product-price">
          {{ product.price | default: 32000 | money }}
        </div>

        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="product-option">
                <label>{{ option.name }}:</label>
                <select name="options[{{ option.name | escape }}]" class="product-select">
                  <option value="">Select {{ option.name }}</option>
                  {% for value in option.values %}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                      {{ value }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endfor %}
          {% endunless %}

          <div class="product-buy-row">
            <div class="product-quantity">
              <button type="button" onclick="adjustQty(-1)">−</button>
              <input type="number" id="QuantityInput" name="quantity" value="1" min="1">
              <button type="button" onclick="adjustQty(1)">+</button>
            </div>

            <button type="submit" class="product-add-cart-btn" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}
                {{ section.settings.btn_label | default: "ADD TO CART" }}
              {% else %}
                OUT OF STOCK
              {% endif %}
            </button>
          </div>
        {% endform %}
      </div>

      <!-- ACORDEÓN MEJORADO Y EDITABLE -->
      {% assign faq_blocks = section.blocks | where: "type", "faq_item" %}
      {% if section.settings.accordion_heading != blank %}
        <h2 class="product-acc-title">{{ section.settings.accordion_heading }}</h2>
      {% endif %}

      <div class="product-acc-list">
        {% if faq_blocks.size > 0 %}
          {% for block in faq_blocks %}
            <details class="product-acc-item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <span class="accordion-icon">+</span>
              </summary>
              <div class="product-acc-content">
                {{ block.settings.answer }}
              </div>
            </details>
          {% endfor %}
        {% else %}
          <details class="product-acc-item">
            <summary>
              <span>Clinical esthetician:</span>
              <span class="accordion-icon">+</span>
            </summary>
            <div class="product-acc-content">
              <p>Engineered for high precision facial treatments and long sessions.</p>
            </div>
          </details>
        {% endif %}
      </div>

      <!-- SHIPPING -->
      {% if section.settings.show_shipping %}
        <div class="product-shipping-block">
          <h3 class="product-shipping__title">{{ section.settings.shipping_title | default: "Shipping" }}</h3>
          <div class="shipping-description">
            {{ section.settings.shipping_text | default: "<p>Standard delivery typically takes <strong>5–7 business days</strong></p>" }}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- COLUMNA DERECHA: Galería + Tabla (Sin espacios muertos) -->
    <div class="product-right-col">
      <div class="product-gallery">
        <div class="product-gallery__main">
          {% assign first_img_block = section.blocks | where: "type", "gallery_image" | first %}
          {% if first_img_block.settings.image != blank %}
            <img id="MainProductImg" src="{{ first_img_block.settings.image | image_url: width: 900 }}" alt="{{ first_img_block.settings.image.alt | escape }}">
          {% elsif product.featured_image != blank %}
            <img id="MainProductImg" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}">
          {% else %}
            <div class="thumb-img-placeholder"></div>
          {% endif %}
        </div>

        <div class="product-gallery__thumbs">
          {% assign img_blocks = section.blocks | where: "type", "gallery_image" %}
          {% if img_blocks.size > 0 %}
            {% for block in img_blocks limit: 4 %}
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 200 }}" 
                  class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                  onclick="changeMainImg(this.src)" 
                  {{ block.shopify_attributes }}
                >
              {% endif %}
            {% endfor %}
          {% elsif product.images.size > 0 %}
            {% for image in product.images limit: 4 %}
              <img 
                src="{{ image | image_url: width: 200 }}" 
                class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                onclick="changeMainImg(this.src)" 
              >
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- TABLA DE ESPECIFICACIONES -->
      {% assign spec_blocks = section.blocks | where: "type", "spec_row" %}
      {% if section.settings.show_tech_table %}
        <div class="tech-table-container">
          <table class="tech-table">
            <thead>
              <tr>
                <th>{{ section.settings.table_col1_header | default: "TECHNICAL ASPECT" }}</th>
                <th>{{ section.settings.table_col2_header | default: "SPECIFICATION DETAILS" }}</th>
              </tr>
            </thead>
            <tbody>
              {% if spec_blocks.size > 0 %}
                {% for block in spec_blocks %}
                  <tr {{ block.shopify_attributes }}>
                    <td class="tech-table__label">{{ block.settings.label }}</td>
                    <td class="tech-table__value">{{ block.settings.value }}</td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td class="tech-table__label">Manufacturer</td>
                  <td class="tech-table__value">Equipro Beauty</td>
                </tr>
                <tr>
                  <td class="tech-table__label">SKU / Model</td>
                  <td class="tech-table__value">{{ product.selected_or_first_available_variant.sku | default: "EI-502" }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

  </div>
</div>

{% render 'quote-modal' %}

<script>
  function changeMainImg(src) {
    const mainImg = document.getElementById('MainProductImg');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('.thumb-img').forEach(el => el.classList.remove('is-active'));
    if (window.event && window.event.target) {
      window.event.target.classList.add('is-active');
    }
  }

  function adjustQty(val) {
    const input = document.getElementById('QuantityInput');
    if (!input) return;
    let current = parseInt(input.value) || 1;
    current += val;
    if (current < 1) current = 1;
    input.value = current;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const accordions = document.querySelectorAll('.product-acc-item');
    accordions.forEach(acc => {
      acc.addEventListener('toggle', () => {
        const icon = acc.querySelector('.accordion-icon');
        if (icon) {
          icon.textContent = acc.open ? '−' : '+';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Link Text",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom Title Override"
    },
    {
      "type": "textarea",
      "id": "intro_highlight",
      "label": "Intro Highlight Text"
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Main Description Override"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "accordion_heading",
      "label": "Accordion Main Title",
      "default": "Key Features for the Professional Station"
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show Shipping Block",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping Title",
      "default": "Shipping"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping Description Text",
      "default": "<p>Standard delivery typically takes <strong>5–7 business days</strong></p>"
    },
    {
      "type": "checkbox",
      "id": "show_tech_table",
      "label": "Show Technical Table",
      "default": true
    },
    {
      "type": "text",
      "id": "table_col1_header",
      "label": "Left Column Header",
      "default": "TECHNICAL ASPECT"
    },
    {
      "type": "text",
      "id": "table_col2_header",
      "label": "Right Column Header",
      "default": "SPECIFICATION DETAILS"
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Title",
          "default": "Clinical esthetician:"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Description / Content",
          "default": "<p>Optimized positioning and comfort for long clinical sessions.</p>"
        }
      ]
    },
    {
      "type": "spec_row",
      "name": "Table Spec Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Technical Aspect (Red)",
          "default": "Manufacturer"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Specification Detail",
          "default": "Equipro Beauty"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Product"
    }
  ]
}
{% endschema %}