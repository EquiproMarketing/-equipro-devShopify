{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'quote-modal.css' | asset_url | stylesheet_tag }}

{% assign target_product = section.settings.featured_product | default: product %}

<div class="product-page page-width" id="ProductMain-{{ section.id }}">
  
  <!-- Grid 1: Textos e Imágenes -->
  <div class="product-main-grid">
    
    <!-- Columna Izquierda: Información Principal -->
    <div class="product-info-col">
      <div class="product-page__back">
        <a href="javascript:history.back()" class="back-link">
          <svg width="8" height="12" viewBox="0 0 8 12" fill="none">
            <path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>{{ section.settings.back_text | default: "Back" }}</span>
        </a>
      </div>

      <h1 class="product-info__title">
        {{ section.settings.custom_title | default: target_product.title | default: "Round Air-lift Stool" }}
      </h1>
      
      {% assign intro_text = section.settings.intro_highlight | default: target_product.metafields.custom.intro_highlight %}
      {% if intro_text != blank %}
        <div class="product-info__intro-highlight">
          <p>{{ intro_text }}</p>
        </div>
      {% endif %}

      <div class="product-info__description">
        {% if section.settings.custom_description != blank %}
          {{ section.settings.custom_description }}
        {% elsif target_product.description != blank %}
          {{ target_product.description }}
        {% else %}
          <p>The 31100 Air-lift stool is purpose-built for licensed professionals, including aestheticians, clinical spa technicians, and massage therapists.</p>
        {% endif %}
      </div>

      {% if section.settings.subtitle != blank %}
        <h2 class="product-info__subtitle">{{ section.settings.subtitle }}</h2>
      {% endif %}

      {% if section.settings.secondary_text != blank %}
        <div class="product-info__description">
          <p>{{ section.settings.secondary_text }}</p>
        </div>
      {% endif %}
    </div>

    <!-- Columna Derecha: Galería (Imagen grande a la izquierda, miniaturas a la derecha) -->
    <div class="product-gallery-col">
      <div class="product-gallery">
        <!-- Imagen Principal Grande -->
        <div class="product-gallery__main aspect-ratio-{{ section.settings.image_aspect_ratio }}">
          {% assign first_img_block = section.blocks | where: "type", "gallery_image" | first %}
          {% if first_img_block.settings.image != blank %}
            <img id="MainProductImg" src="{{ first_img_block.settings.image | image_url: width: 900 }}" alt="{{ first_img_block.settings.image.alt | escape }}">
          {% elsif target_product.featured_image != blank %}
            <img id="MainProductImg" src="{{ target_product.featured_image | image_url: width: 900 }}" alt="{{ target_product.title | escape }}">
          {% else %}
            <div class="product-gallery__placeholder"></div>
          {% endif %}
        </div>

        <!-- Miniaturas Verticales a la Derecha -->
        <div class="product-gallery__thumbs">
          {% assign img_blocks = section.blocks | where: "type", "gallery_image" %}
          {% if img_blocks.size > 0 %}
            {% for block in img_blocks limit: 4 %}
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 200 }}" 
                  class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                  onclick="changeMainImg(this.src)" 
                  {{ block.shopify_attributes }}
                >
              {% else %}
                <div class="thumb-img-placeholder {% if forloop.first %}is-active{% endif %}" onclick="changeMainImg('{{ target_product.featured_image | image_url: width: 900 }}')"></div>
              {% endif %}
            {% endfor %}
          {% elsif target_product.images.size > 0 %}
            {% for image in target_product.images limit: 4 %}
              <img 
                src="{{ image | image_url: width: 200 }}" 
                class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                onclick="changeMainImg(this.src)" 
              >
            {% endfor %}
          {% else %}
            {% for i in (1..4) %}
              <div class="thumb-img-placeholder {% if forloop.first %}is-active{% endif %}"></div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_compare_btn %}
        <div class="product-compare-wrapper" style="margin-top: 1.5rem; text-align: center;">
          <button class="product-compare-trigger-btn" id="OpenCompareModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
            <span>{{ section.settings.compare_btn_label | default: "Compare with other models" }}</span>
          </button>
        </div>
      {% endif %}
    </div>

  </div>

  <!-- Grid 2: Compra y Tabla -->
  <div class="product-secondary-grid">
    
    <!-- Columna Izquierda: Bloque de Compra, Acordeón y Shipping -->
    <div class="product-buy-col">
      <div class="product-price">
        {{ target_product.price | default: 320000 | money }}
      </div>

      {% form 'product', target_product %}
        <input type="hidden" name="id" value="{{ target_product.selected_or_first_available_variant.id }}">

        {% unless target_product.has_only_default_variant %}
          {% for option in target_product.options_with_values %}
            <div class="product-option">
              <label>{{ option.name }}:</label>
              <select name="options[{{ option.name | escape }}]" class="product-select">
                <option value="">Select {{ option.name }}</option>
                {% for value in option.values %}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                    {{ value }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        {% else %}
          <div class="product-option">
            <label>Color:</label>
            <select class="product-select">
              <option>Select Color</option>
              <option>White</option>
              <option>Black</option>
            </select>
          </div>
        {% endunless %}

        <div class="product-buy-row">
          <div class="product-quantity">
            <button type="button" onclick="adjustQty(-1)">−</button>
            <input type="number" id="QuantityInput" name="quantity" value="1" min="1">
            <button type="button" onclick="adjustQty(1)">+</button>
          </div>

          <button type="submit" class="product-add-cart-btn" {% unless target_product.available %}disabled{% endunless %}>
            {% if target_product.available %}
              {{ section.settings.btn_label | default: "ADD TO CART" }}
            {% else %}
              OUT OF STOCK
            {% endif %}
          </button>
        </div>
      {% endform %}

      <!-- Acordeón Key Features -->
      {% assign faq_blocks = section.blocks | where: "type", "faq_item" %}
      {% if section.settings.accordion_heading != blank %}
        <h2 class="product-acc-title">{{ section.settings.accordion_heading }}</h2>
      {% endif %}

      <div class="product-acc-list">
        {% if faq_blocks.size > 0 %}
          {% for block in faq_blocks %}
            <details class="product-acc-item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <span class="accordion-icon">+</span>
              </summary>
              <p>{{ block.settings.answer }}</p>
            </details>
          {% endfor %}
        {% else %}
          <details class="product-acc-item">
            <summary>
              <span>Clinical esthetician:</span>
              <span class="accordion-icon">+</span>
            </summary>
            <p>Engineered for high precision facial treatments and long sessions.</p>
          </details>
          <details class="product-acc-item">
            <summary>
              <span>Body treatment specialists and massage therapists:</span>
              <span class="accordion-icon">+</span>
            </summary>
            <p>Superior weight distribution and silent electric lift control.</p>
          </details>
          <details class="product-acc-item">
            <summary>
              <span>Hair removal and multi-service aesthetic clinics:</span>
              <span class="accordion-icon">+</span>
            </summary>
            <p>Ultra-resistant leatherette designed for seamless sanitation.</p>
          </details>
        {% endif %}
      </div>

      <!-- Bloque Shipping -->
      {% if section.settings.show_shipping %}
        <div class="product-shipping-block">
          <h3 class="product-shipping__title">{{ section.settings.shipping_title | default: "Shipping" }}</h3>
          <div class="shipping-description">
            {{ section.settings.shipping_text | default: "<p>Standard delivery typically takes <strong>5–7 business days</strong>, while expedited shipping <strong>takes 2–3 business days</strong></p>" }}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Columna Derecha: Tabla de Especificaciones Editables -->
    <div class="product-table-col">
      {% assign spec_blocks = section.blocks | where: "type", "spec_row" %}
      {% if section.settings.show_tech_table %}
        <div class="tech-table-container">
          <table class="tech-table">
            <thead>
              <tr>
                <th>{{ section.settings.table_col1_header | default: "TECHNICAL ASPECT" }}</th>
                <th>{{ section.settings.table_col2_header | default: "SPECIFICATION DETAILS" }}</th>
              </tr>
            </thead>
            <tbody>
              {% for block in spec_blocks %}
                <tr {{ block.shopify_attributes }}>
                  <td class="tech-table__label">{{ block.settings.label }}</td>
                  <td class="tech-table__value">{{ block.settings.value }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

  </div>

</div>

{% render 'quote-modal' %}

<script>
  function changeMainImg(src) {
    document.getElementById('MainProductImg').src = src;
    document.querySelectorAll('.thumb-img, .thumb-img-placeholder').forEach(el => el.classList.remove('is-active'));
    if (event && event.target) {
      event.target.classList.add('is-active');
    }
  }

  function adjustQty(val) {
    const input = document.getElementById('QuantityInput');
    let current = parseInt(input.value) || 1;
    current += val;
    if (current < 1) current = 1;
    input.value = current;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const accordions = document.querySelectorAll('.product-acc-item');
    accordions.forEach(acc => {
      acc.addEventListener('toggle', () => {
        const icon = acc.querySelector('.accordion-icon');
        if (icon) {
          icon.textContent = acc.open ? '−' : '+';
        }
      });
    });
  });
</script>

{% schema %}
