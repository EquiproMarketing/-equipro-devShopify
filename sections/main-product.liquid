{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

<div class="product-page page-width" id="ProductMain-{{ section.id }}">
  {% assign target_product = section.settings.featured_product | default: product %}

  <!-- 1. BACK LINK -->
  <div class="product-page__back product-mobile-order-back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none">
        <path d="M7 1L1 6L7 11" stroke="#1d1d1f" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>{{ section.settings.back_text | default: "Back" }}</span>
    </a>
  </div>

  <!-- PARTE 1: GRID PRINCIPAL (TOP) -->
  <div class="product-master-grid">
    
    <!-- COLUMNA IZQUIERDA -->
    <div class="product-left-col">

      <!-- TÍTULO DEL PRODUCTO -->
      <h1 class="product-info__title product-mobile-order-title">
        {{ section.settings.custom_title | default: target_product.title }}
      </h1>

      <!-- DESCRIPCIONES E HIGHLIGHTS -->
      <div class="product-mobile-order-descriptions">
        {% assign intro_text = section.settings.intro_highlight %}
        {% if intro_text != blank %}
          <div class="product-info__intro-highlight">
            <p>{{ intro_text }}</p>
          </div>
        {% endif %}

        <div class="product-info__description">
          {% if section.settings.custom_description != blank %}
            {{ section.settings.custom_description }}
          {% else %}
            {{ target_product.description }}
          {% endif %}
        </div>

        {% if section.settings.subtitle != blank %}
          <h2 class="product-info__subtitle">{{ section.settings.subtitle }}</h2>
        {% endif %}

        {% if section.settings.secondary_description != blank %}
          <div class="product-info__description">
            {{ section.settings.secondary_description }}
          </div>
        {% endif %}
      </div>

      <!-- CAJA DE COMPRA -->
      <div class="product-buy-box product-mobile-order-buybox">
        <div class="product-price">
          {{ target_product.price | money }}
        </div>

        {% form 'product', target_product %}
          <input type="hidden" name="id" value="{{ target_product.selected_or_first_available_variant.id }}">

          {% if section.settings.show_variant_selectors and target_product.has_only_default_variant == false %}
            <div class="product-options-container">
              {% for option in target_product.options_with_values %}
                {% assign option_name_downcase = option.name | downcase %}
                
                {% assign show_option = true %}
                {% if option_name_downcase contains 'color' and section.settings.show_color_option == false %}
                  {% assign show_option = false %}
                {% elsif option_name_downcase contains 'size' or option_name_downcase contains 'talla' %}
                  {% if section.settings.show_size_option == false %}
                    {% assign show_option = false %}
                  {% endif %}
                {% endif %}

                {% if show_option %}
                  <div class="product-option">
                    <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                    <select 
                      id="Option-{{ section.id }}-{{ forloop.index0 }}" 
                      name="options[{{ option.name | escape }}]" 
                      class="product-select"
                    >
                      {% for value in option.values %}
                        <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                          {{ value }}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          <div class="product-buy-row">
            <div class="product-quantity">
              <button type="button" onclick="adjustQty(-1)">−</button>
              <input type="number" id="QuantityInput" name="quantity" value="1" min="1">
              <button type="button" onclick="adjustQty(1)">+</button>
            </div>

            <button type="submit" class="product-add-cart-btn" {% unless target_product.available %}disabled{% endunless %}>
              {% if target_product.available %}
                {{ section.settings.btn_label | default: "ADD TO CART" }}
              {% else %}
                OUT OF STOCK
              {% endif %}
            </button>
          </div>
        {% endform %}
      </div>

    </div>

    <!-- COLUMNA DERECHA -->
    <div class="product-right-col product-mobile-order-gallery">
      <div class="product-gallery">
        
        <!-- IMAGEN PRINCIPAL -->
        <div class="product-gallery__main">
          {% assign first_img_block = section.blocks | where: "type", "gallery_image" | first %}
          {% if first_img_block.settings.image != blank %}
            <img id="MainProductImg" src="{{ first_img_block.settings.image | image_url: width: 1000 }}" alt="{{ first_img_block.settings.image.alt | escape }}">
          {% elsif target_product.featured_image != blank %}
            <img id="MainProductImg" src="{{ target_product.featured_image | image_url: width: 1000 }}" alt="{{ target_product.title | escape }}">
          {% else %}
            <div class="thumb-img-placeholder"></div>
          {% endif %}
        </div>

        <!-- MINIATURAS -->
        <div class="product-gallery__thumbs">
          {% assign img_blocks = section.blocks | where: "type", "gallery_image" %}
          {% if img_blocks.size > 0 %}
            {% for block in img_blocks limit: 4 %}
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 250 }}" 
                  class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                  onclick="changeMainImg(this.src)" 
                  {{ block.shopify_attributes }}
                >
              {% endif %}
            {% endfor %}
          {% elsif target_product.images.size > 0 %}
            {% for image in target_product.images limit: 4 %}
              <img 
                src="{{ image | image_url: width: 250 }}" 
                class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                onclick="changeMainImg(this.src)" 
              >
            {% endfor %}
          {% endif %}
        </div>

      </div>

      <!-- BOTÓN COMPARAR -->
      {% if section.settings.show_compare_btn %}
        <div class="product-compare-wrapper product-mobile-order-compare">
          <button class="product-compare-trigger-btn" id="OpenCompareModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
            <span>{{ section.settings.compare_btn_label | default: "Compare with other models" }}</span>
          </button>
        </div>
      {% endif %}
    </div>

  </div>

  <!-- PARTE 2: CARACTERÍSTICAS, TABLA TÉCNICA Y BLOQUE DE SHIPPING -->
  {% if section.settings.show_characteristics %}
    <div class="product-characteristics-grid product-master-grid">
      
      <!-- IZQUIERDA: ACORDEÓN Y BLOQUE SHIPPING -->
      <div class="product-characteristics-left">
        {% if section.settings.characteristics_title != blank %}
          <h3 class="product-acc-title">{{ section.settings.characteristics_title }}</h3>
        {% endif %}

        {% assign acc_blocks = section.blocks | where: "type", "accordion_item" %}
        {% if acc_blocks.size > 0 %}
          <div class="product-acc-list">
            {% for block in acc_blocks %}
              <details class="product-acc-item" {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.title }}</span>
                  <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1L6 6L11 1" stroke="#1d1d1f" stroke-width="1.5"/></svg>
                </summary>
                <div class="product-acc-content">
                  {{ block.settings.content }}
                </div>
              </details>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.show_shipping_block %}
          <div class="product-shipping-block">
            <h4 class="product-shipping__title">{{ section.settings.shipping_title | default: "Shipping & Delivery" }}</h4>
            <div class="shipping-description">
              {{ section.settings.shipping_content }}
            </div>
          </div>
        {% endif %}
      </div>

      <!-- DERECHA: TABLA DE ESPECIFICACIONES TÉCNICAS -->
      <div class="product-characteristics-right">
        {% if section.settings.custom_specs_html != blank %}
          <div class="equipro-specs-container tech-table-container">
            {{ section.settings.custom_specs_html }}
          </div>
        {% endif %}
      </div>

    </div>
  {% endif %}
</div>

<script>
  function changeMainImg(src) {
    const mainImg = document.getElementById('MainProductImg');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('#ProductMain-{{ section.id }} .thumb-img').forEach(el => el.classList.remove('is-active'));
    if (window.event && window.event.target) {
      window.event.target.classList.add('is-active');
    }
  }

  function adjustQty(val) {
    const input = document.getElementById('QuantityInput');
    if (!input) return;
    let current = parseInt(input.value) || 1;
    current += val;
    if (current < 1) current = 1;
    input.value = current;
  }
</script>

{% schema %}
{
  "name": "Main Product Top",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Link Text",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom Title Override"
    },
    {
      "type": "textarea",
      "id": "intro_highlight",
      "label": "Intro Highlight Line (Red Bar)"
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Main Description Override"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Red Subtitle (Middle)"
    },
    {
      "type": "richtext",
      "id": "secondary_description",
      "label": "Secondary Description Paragraph"
    },
    {
      "type": "header",
      "content": "Variant Options Display"
    },
    {
      "type": "checkbox",
      "id": "show_variant_selectors",
      "label": "Enable Variant Dropdowns",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_option",
      "label": "Show Color Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_option",
      "label": "Show Size/Talla Selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Product Target & Purchasing"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Link Specific Product"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Add to Cart Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "checkbox",
      "id": "show_compare_btn",
      "label": "Show Compare Button",
      "default": true
    },
    {
      "type": "text",
      "id": "compare_btn_label",
      "label": "Compare Button Text",
      "default": "Compare with other models"
    },
    {
      "type": "header",
      "content": "Characteristics & Specs Section"
    },
    {
      "type": "checkbox",
      "id": "show_characteristics",
      "label": "Show Lower Characteristics Section",
      "default": true
    },
    {
      "type": "text",
      "id": "characteristics_title",
      "label": "Characteristics Accordion Title",
      "default": "Characteristics"
    },
    {
      "type": "html",
      "id": "custom_specs_html",
      "label": "Technical Specifications HTML Table"
    },
    {
      "type": "header",
      "content": "Shipping Block"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_block",
      "label": "Show Shipping Block",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping Block Title",
      "default": "Shipping & Delivery"
    },
    {
      "type": "richtext",
      "id": "shipping_content",
      "label": "Shipping Block Content"
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    },
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Accordion Item Title",
          "default": "Features"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Accordion Item Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Product Top"
    }
  ]
}
{% endschema %}