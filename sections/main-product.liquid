{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'product-technical-table.css' | asset_url | stylesheet_tag }}

<div class="product-page page-width">
  
  <!-- BACK BUTTON  -->
  <div class="product-page__back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none"><path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round"/></svg>
      Back
    </a>
  </div>

  <!-- FILA 1: INFORMACIÓN DE TEXTO E IMÁGENES -->
  <div class="product-main-grid">
    <!-- Columna Izquierda: Títulos y Textos -->
    <div class="product-info-col">
      <h1 class="product-info__title">{{ product.title | default: "Ultra-Comfort Professional Treatment Chair" }}</h1>
      
      <div class="product-info__intro-highlight">
        <p>Precision-engineered for advanced clinical workflows, the Ultra-Comfort treatment chair bridges the gap between ergonomic practitioner support and exceptional client relaxation, backed by decades of North American manufacturing expertise.</p>
      </div>

      <div class="product-info__description">
        <p>Ultra-Comfort is purpose-built for licensed skincare specialists, including Estheticians, Clinical Spa Therapists, and Cosmetic Injectors. Its 15-degree tilt mechanism targets lower-back tension and postural strain during extended treatment sessions...</p>
      </div>

      <h2 class="product-info__subtitle">Engineering for Precision and Longevity</h2>
      <div class="product-info__description">
        <p>Long-term durability is central to the Equipro approach. To preserve the mechanical integrity and surface quality of Ultra-Comfort, routine cleaning with non-abrasive disinfectants is recommended...</p>
      </div>

      <!-- BOTÓN COMPARAR PRODUCTOS (ABRE POPUP) -->
      <button class="product-compare-trigger-btn" id="OpenCompareModal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
        Compare with other models
      </button>
    </div>

    <!-- Cargar Assets -->
    {{ 'quote-modal.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'quote-modal.js' | asset_url }}" defer="defer"></script>

    <!-- Botón de Disparo -->
    <button 
    type="button" 
    class="button button--secondary button--full-width" 
    data-open-quote-modal
    data-product-title="{{ product.title | escape }}"
    style="margin-top: 10px; border-color: #ab273b; color: #ab273b;"
    >
    Get a Quote / Solicitar Cotización
    </button>

    <!-- Render del Snippet -->
    {% render 'quote-modal' %}

    <!-- Columna Derecha: Galería de Imágenes -->
    <div class="product-gallery-col">
      <div class="product-gallery">
        <div class="product-gallery__main">
          {% if product.featured_image != blank %}
            <img id="MainProductImg" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title }}">
          {% else %}
            <div class="product-gallery__placeholder"></div>
          {% endif %}
        </div>
        
        <div class="product-gallery__thumbs">
          {% for image in product.images limit: 5 %}
            <img src="{{ image | image_url: width: 150 }}" class="thumb-img {% if forloop.first %}is-active{% endif %}" onclick="changeMainImg(this.src)">
          {% else %}
            <div class="thumb-placeholder"></div>
            <div class="thumb-placeholder"></div>
            <div class="thumb-placeholder"></div>
            <div class="thumb-placeholder"></div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <!-- FILA 2: COMPRA + TABLA DE ESPECIFICACIONES -->
  <div class="product-secondary-grid">
    <!-- Columna Izquierda: Precio, Variantes, Carrito y Dropdowns -->
    <div class="product-purchase-col">
      <div class="product-price">From {{ product.price | default: 435000 | money }}</div>

      {% form 'product', product %}
        <div class="product-option">
          <label>Couleur:</label>
          <select name="options[Couleur]" class="product-select">
            <option>Select Couleur</option>
            <option>White</option>
            <option>Black</option>
          </select>
        </div>

        <div class="product-option">
          <label>Taille:</label>
          <select name="options[Taille]" class="product-select">
            <option>Select Taille</option>
            <option>Standard</option>
          </select>
        </div>

        <div class="product-buy-row">
          <div class="product-quantity">
            <button type="button" onclick="adjustQty(-1)">−</button>
            <input type="number" id="QuantityInput" name="quantity" value="1" min="1">
            <button type="button" onclick="adjustQty(1)">+</button>
          </div>
          <button type="submit" class="product-add-cart-btn">ADD TO CART</button>
        </div>
      {% endform %}

      <!-- ACORDEÓN / DROPDOWN PROFESIONALES -->
      <div class="product-accordions">
        <h3 class="product-acc-title">Key Features for the Professional Station</h3>
        
        <details class="product-acc-item">
          <summary>Clinical Aesthetics & Specialized Facials: <span>+</span></summary>
          <p>Optimized positioning for facial protocols, microneedling, and LED light therapies.</p>
        </details>
        
        <details class="product-acc-item">
          <summary>Advanced Clinical Spa Treatments: <span>+</span></summary>
          <p>Full electric elevation ensures comfortable posture during body wraps and deep tissue sessions.</p>
        </details>
        
        <details class="product-acc-item">
          <summary>Hair Removal & Full-Body Services: <span>+</span></summary>
          <p>Seamless vinyl surface enables rapid sterilization between wax and laser applications.</p>
        </details>
      </div>

      <!-- SECCIÓN SHIPPING & CALCULADORA -->
      <div class="product-shipping-block">
        <h4 class="product-shipping__title">Shipping</h4>
        <p>Standard delivery typically takes <strong>5–7 business days</strong>, while expedited shipping takes <strong>2–3 business days</strong>.</p>
        
        <button class="product-shipping-calc-btn" onclick="alert('Enter your postal code at checkout to calculate exact delivery dates.')">
          Calculate estimated delivery date
        </button>
      </div>
    </div>

    <!-- Columna Derecha: Tabla de Especificaciones Inyectada -->
    <div class="product-specs-col">
      <div class="tech-table-wrapper">
        <table class="tech-table">
          <thead>
            <tr>
              <th>TECHNICAL ASPECT</th>
              <th>SPECIFICATION DETAILS</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Manufacturer</td><td>Equipro Beauty</td></tr>
            <tr><td>Model SKU</td><td>20501</td></tr>
            <tr><td>Primary Materials</td><td>Ultra-resistant vinyl upholstery, reinforced steel frame, premium electric actuators</td></tr>
            <tr><td>Dimensions (L x W x H)</td><td>72" L x 26" W x 20.5" / 36.5" H</td></tr>
            <tr><td>Weight</td><td>320 lb (145 kg)</td></tr>
            <tr><td>Adjustability</td><td>Full electric adjustment via pedal with proximity sensor: height, backrest, legrest, and tilt</td></tr>
            <tr><td>Height Range</td><td>20.5" to 36.5" (52 cm to 93 cm), lowers to 19" for accessibility</td></tr>
            <tr><td>Warranty</td><td>2 years</td></tr>
            <tr><td>Country of Origin</td><td>Canada</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function changeMainImg(src) {
    document.getElementById('MainProductImg').src = src;
    document.querySelectorAll('.thumb-img').forEach(el => el.classList.remove('is-active'));
    event.target.classList.add('is-active');
  }

  function adjustQty(val) {
    const input = document.getElementById('QuantityInput');
    let current = parseInt(input.value) || 1;
    current += val;
    if (current < 1) current = 1;
    input.value = current;
  }
</script>

{% schema %}
{
  "name": "Main Product Page",
  "settings": [],
  "presets": [{ "name": "Main Product Page" }]
}
{% endschema %}