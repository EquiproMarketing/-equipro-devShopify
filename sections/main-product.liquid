<div class="product-page page-width" id="ProductMain-{{ section.id }}">
  {% assign target_product = section.settings.featured_product | default: product %}

  <!-- 1. BACK LINK (A ANCHO COMPLETO ARRIBA DE TODO EL GRID) -->
  <div class="product-page__back product-mobile-order-back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none">
        <path d="M7 1L1 6L7 11" stroke="#1d1d1f" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>{{ section.settings.back_text | default: "Back" }}</span>
    </a>
  </div>

  <!-- PARTE 1: GRID PRINCIPAL (TOP) -->
  <div class="product-master-grid">
    
    <!-- COLUMNA IZQUIERDA -->
    <div class="product-left-col">

      <!-- TÍTULO DEL PRODUCTO -->
      <h1 class="product-info__title product-mobile-order-title">
        {{ section.settings.custom_title | default: target_product.title }}
      </h1>

      <!-- DESCRIPCIONES E HIGHLIGHTS -->
      <div class="product-mobile-order-descriptions">
        {% assign intro_text = section.settings.intro_highlight %}
        {% if intro_text != blank %}
          <div class="product-info__intro-highlight">
            <p>{{ intro_text }}</p>
          </div>
        {% endif %}

        <div class="product-info__description">
          {% if section.settings.custom_description != blank %}
            {{ section.settings.custom_description }}
          {% else %}
            {{ target_product.description }}
          {% endif %}
        </div>

        {% if section.settings.subtitle != blank %}
          <h2 class="product-info__subtitle">{{ section.settings.subtitle }}</h2>
        {% endif %}

        {% if section.settings.secondary_description != blank %}
          <div class="product-info__description">
            {{ section.settings.secondary_description }}
          </div>
        {% endif %}
      </div>

      <!-- CAJA DE COMPRA -->
      <div class="product-buy-box product-mobile-order-buybox">
        <div class="product-price">
          {{ target_product.price | money }}
        </div>

        {% form 'product', target_product %}
          <input type="hidden" name="id" value="{{ target_product.selected_or_first_available_variant.id }}">

          {% if section.settings.show_variant_selectors and target_product.has_only_default_variant == false %}
            <div class="product-options-container">
              {% for option in target_product.options_with_values %}
                {% assign option_name_downcase = option.name | downcase %}
                
                {% assign show_option = true %}
                {% if option_name_downcase contains 'color' and section.settings.show_color_option == false %}
                  {% assign show_option = false %}
                {% elsif option_name_downcase contains 'size' or option_name_downcase contains 'talla' %}
                  {% if section.settings.show_size_option == false %}
                    {% assign show_option = false %}
                  {% endif %}
                {% endif %}

                {% if show_option %}
                  <div class="product-option">
                    <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                    <select 
                      id="Option-{{ section.id }}-{{ forloop.index0 }}" 
                      name="options[{{ option.name | escape }}]" 
                      class="product-select"
                    >
                      {% for value in option.values %}
                        <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                          {{ value }}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          <div class="product-buy-row">
            <div class="product-quantity">
              <button type="button" onclick="adjustQty(-1)">−</button>
              <input type="number" id="QuantityInput" name="quantity" value="1" min="1">
              <button type="button" onclick="adjustQty(1)">+</button>
            </div>

            <button type="submit" class="product-add-cart-btn" {% unless target_product.available %}disabled{% endunless %}>
              {% if target_product.available %}
                {{ section.settings.btn_label | default: "ADD TO CART" }}
              {% else %}
                OUT OF STOCK
              {% endif %}
            </button>
          </div>
        {% endform %}
      </div>

    </div>

    <!-- COLUMNA DERECHA (GALERÍA DE IMÁGENES) -->
    <div class="product-right-col product-mobile-order-gallery">
      <div class="product-gallery">
        
        <!-- IMAGEN PRINCIPAL -->
        <div class="product-gallery__main">
          {% assign first_img_block = section.blocks | where: "type", "gallery_image" | first %}
          {% if first_img_block.settings.image != blank %}
            <img id="MainProductImg" src="{{ first_img_block.settings.image | image_url: width: 1000 }}" alt="{{ first_img_block.settings.image.alt | escape }}">
          {% elsif target_product.featured_image != blank %}
            <img id="MainProductImg" src="{{ target_product.featured_image | image_url: width: 1000 }}" alt="{{ target_product.title | escape }}">
          {% else %}
            <div class="thumb-img-placeholder"></div>
          {% endif %}
        </div>

        <!-- MINIATURAS (COLUMNA A LA DERECHA EN ESCRITORIO / FILA ABAJO EN MÓVIL) -->
        <div class="product-gallery__thumbs">
          {% assign img_blocks = section.blocks | where: "type", "gallery_image" %}
          {% if img_blocks.size > 0 %}
            {% for block in img_blocks limit: 4 %}
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 250 }}" 
                  class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                  onclick="changeMainImg(this.src)" 
                  {{ block.shopify_attributes }}
                >
              {% endif %}
            {% endfor %}
          {% elsif target_product.images.size > 0 %}
            {% for image in target_product.images limit: 4 %}
              <img 
                src="{{ image | image_url: width: 250 }}" 
                class="thumb-img {% if forloop.first %}is-active{% endif %}" 
                onclick="changeMainImg(this.src)" 
              >
            {% endfor %}
          {% endif %}
        </div>

      </div>

      <!-- BOTÓN COMPARAR -->
      {% if section.settings.show_compare_btn %}
        <div class="product-compare-wrapper product-mobile-order-compare">
          <button class="product-compare-trigger-btn" id="OpenCompareModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
            <span>{{ section.settings.compare_btn_label | default: "Compare with other models" }}</span>
          </button>
        </div>
      {% endif %}
    </div>

  </div>

  <!-- PARTE 2: CARACTERÍSTICAS, TABLA TÉCNICA Y BLOQUE DE SHIPPING -->
  {% if section.settings.show_characteristics %}
    <div class="product-characteristics-grid product-master-grid">
      
      <!-- IZQUIERDA: ACORDEÓN Y BLOQUE SHIPPING -->
      <div class="product-characteristics-left">
        {% if section.settings.characteristics_title != blank %}
          <h3 class="product-acc-title">{{ section.settings.characteristics_title }}</h3>
        {% endif %}

        {% assign acc_blocks = section.blocks | where: "type", "accordion_item" %}
        {% if acc_blocks.size > 0 %}
          <div class="product-acc-list">
            {% for block in acc_blocks %}
              <details class="product-acc-item" {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.title }}</span>
                  <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1L6 6L11 1" stroke="#1d1d1f" stroke-width="1.5"/></svg>
                </summary>
                <div class="product-acc-content">
                  {{ block.settings.content }}
                </div>
              </details>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.show_shipping_block %}
          <div class="product-shipping-block">
            <h4 class="product-shipping__title">{{ section.settings.shipping_title | default: "Shipping & Delivery" }}</h4>
            <div class="shipping-description">
              {{ section.settings.shipping_content }}
            </div>
          </div>
        {% endif %}
      </div>

      <!-- DERECHA: TABLA DE ESPECIFICACIONES TÉCNICAS -->
      <div class="product-characteristics-right">
        {% if section.settings.custom_specs_html != blank %}
          <div class="equipro-specs-container">
            {{ section.settings.custom_specs_html }}
          </div>
        {% endif %}
      </div>

    </div>
  {% endif %}
</div>

<style>
/* ==========================================================================
   MAIN PRODUCT TOP SECTION - DESKTOP ( >= 768px )
   ========================================================================== */
#ProductMain-{{ section.id }} {
  padding-top: 24px;
  padding-bottom: 40px;
}

#ProductMain-{{ section.id }} .product-page__back {
  margin-bottom: 20px;
  width: 100%;
}

#ProductMain-{{ section.id }} .product-page__back .back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #1d1d1f;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
}

#ProductMain-{{ section.id }} .product-master-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: start;
}

#ProductMain-{{ section.id }} .product-left-col {
  display: flex !important;
  flex-direction: column !important;
  gap: 18px;
}

#ProductMain-{{ section.id }} .product-info__title {
  font-size: 2.2rem;
  font-weight: 700;
  color: #ab273b;
  margin: 0;
  line-height: 1.15;
  letter-spacing: -0.015em;
}

#ProductMain-{{ section.id }} .product-info__intro-highlight {
  border-left: 3px solid #ab273b;
  padding-left: 16px;
  margin: 4px 0;
}

#ProductMain-{{ section.id }} .product-info__intro-highlight p,
#ProductMain-{{ section.id }} .product-info__intro-highlight strong {
  font-weight: 700;
  color: #333333;
  font-size: 0.92rem;
  line-height: 1.5;
  margin: 0;
}

#ProductMain-{{ section.id }} .product-info__description {
  font-size: 0.9rem;
  color: #515154;
  line-height: 1.6;
}

#ProductMain-{{ section.id }} .product-info__subtitle {
  font-size: 1.5rem;
  font-weight: 700;
  color: #ab273b;
  margin: 12px 0 0 0;
  line-height: 1.25;
}

#ProductMain-{{ section.id }} .product-buy-box {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 16px;
}

#ProductMain-{{ section.id }} .product-price {
  font-size: 1.25rem;
  font-weight: 500;
  color: #1d1d1f;
}

#ProductMain-{{ section.id }} .product-buy-row {
  display: flex;
  gap: 12px;
  align-items: center;
  max-width: 420px;
}

#ProductMain-{{ section.id }} .product-quantity {
  display: flex;
  align-items: center;
  border: 1px solid #d2d2d7;
  border-radius: 4px;
  background: #ffffff;
  height: 44px;
}

#ProductMain-{{ section.id }} .product-quantity button {
  background: none;
  border: none;
  padding: 0 14px;
  font-size: 1rem;
  cursor: pointer;
  color: #515154;
  height: 100%;
}

#ProductMain-{{ section.id }} .product-quantity input {
  width: 40px;
  border: none;
  text-align: center;
  font-size: 0.9rem;
  font-weight: 500;
  color: #1d1d1f;
}

#ProductMain-{{ section.id }} .product-add-cart-btn {
  flex: 1;
  height: 44px;
  background-color: #ab273b;
  color: #ffffff;
  border: none;
  padding: 0 20px;
  border-radius: 6px;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

#ProductMain-{{ section.id }} .product-add-cart-btn:hover {
  background-color: #8c1e2e;
}

#ProductMain-{{ section.id }} .product-options-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 4px;
}

#ProductMain-{{ section.id }} .product-option {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

#ProductMain-{{ section.id }} .product-option label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #1d1d1f;
}

#ProductMain-{{ section.id }} .product-select {
  width: 100%;
  height: 42px;
  padding: 0 14px;
  border-radius: 6px;
  border: 1px solid #d2d2d7;
  background-color: #ffffff;
  font-size: 0.88rem;
  color: #1d1d1f;
  outline: none;
  cursor: pointer;
}

/* GALERÍA EN ESCRITORIO (IMAGEN A LA IZQUIERDA, MINIATURAS A LA DERECHA) */
#ProductMain-{{ section.id }} .product-right-col {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

#ProductMain-{{ section.id }} .product-gallery {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

#ProductMain-{{ section.id }} .product-gallery__main {
  flex: 1;
  border-radius: 24px;
  overflow: hidden;
  background-color: #f5f5f7;
  min-height: 480px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#ProductMain-{{ section.id }} .product-gallery__main img {
  width: 100%;
  height: 100%;
  min-height: 480px;
  object-fit: contain;
  border-radius: 24px;
  display: block;
}

#ProductMain-{{ section.id }} .product-gallery__thumbs {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 76px;
}

#ProductMain-{{ section.id }} .product-gallery__thumbs .thumb-img,
#ProductMain-{{ section.id }} .product-gallery__thumbs .thumb-img-placeholder {
  width: 76px;
  height: 76px;
  border-radius: 12px;
  background-color: #f5f5f7;
  object-fit: cover;
  cursor: pointer;
  border: 1px solid #d2d2d7;
  transition: all 0.2s ease;
}

#ProductMain-{{ section.id }} .product-gallery__thumbs .thumb-img.is-active {
  border-color: #ab273b;
  box-shadow: 0 0 0 2px #ab273b;
}

#ProductMain-{{ section.id }} .product-compare-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 12px;
  padding-right: 92px; /* Compensación por el ancho de la columna de miniaturas */
  width: 100%;
}

#ProductMain-{{ section.id }} .product-compare-trigger-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: #ffffff;
  color: #ab273b;
  border: 1px solid #ab273b;
  padding: 8px 18px;
  border-radius: 980px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
}

/* CARACTERÍSTICAS Y BLOQUE SHIPPING */
#ProductMain-{{ section.id }} .product-characteristics-grid {
  margin-top: 30px;
  align-items: stretch;
}

#ProductMain-{{ section.id }} .product-characteristics-left {
  display: flex;
  flex-direction: column;
  height: 100%;
}

#ProductMain-{{ section.id }} .product-acc-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1d1d1f;
  margin: 0 0 16px 0;
}

#ProductMain-{{ section.id }} .product-acc-list {
  display: flex;
  flex-direction: column;
  border-top: 1px solid #e5e5e7;
  margin-bottom: 24px;
}

#ProductMain-{{ section.id }} .product-acc-item {
  border-bottom: 1px solid #e5e5e7;
  padding: 14px 0;
}

#ProductMain-{{ section.id }} .product-acc-item summary {
  font-weight: 600;
  font-size: 0.95rem;
  color: #1d1d1f;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

#ProductMain-{{ section.id }} .product-acc-content {
  padding-top: 10px;
  color: #515154;
  font-size: 0.88rem;
  line-height: 1.5;
}

#ProductMain-{{ section.id }} .product-shipping-block {
  margin-top: auto;
  background: #f5f5f7;
  border-radius: 12px;
  padding: 20px;
}

#ProductMain-{{ section.id }} .product-shipping__title {
  font-size: 0.98rem;
  font-weight: 700;
  color: #1d1d1f;
  margin: 0 0 6px 0;
}

#ProductMain-{{ section.id }} .shipping-description {
  font-size: 0.86rem;
  color: #515154;
  line-height: 1.45;
}

#ProductMain-{{ section.id }} .equipro-specs-container {
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #e5e5e7;
  background: #ffffff;
}

#ProductMain-{{ section.id }} .equipro-table {
  width: 100%;
  border-collapse: collapse;
}

#ProductMain-{{ section.id }} .equipro-table th {
  background-color: #ab273b;
  color: #ffffff;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 12px 16px;
  text-transform: uppercase;
}

#ProductMain-{{ section.id }} .equipro-table td {
  padding: 12px 16px;
  font-size: 0.82rem;
  color: #1d1d1f;
  border-bottom: 1px solid #e5e5e7;
}

/* ==========================================================================
   REORDENAMIENTO Y GALERÍA EN MÓVIL ( <= 767px )
   ========================================================================== */
@media screen and (max-width: 767px) {
  #ProductMain-{{ section.id }} .product-master-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  #ProductMain-{{ section.id }} .product-left-col,
  #ProductMain-{{ section.id }} .product-right-col {
    display: contents !important;
  }

  /* GALERÍA EN MÓVIL: IMAGEN ARRIBA Y MINIATURAS ABAJO EN FILA HORIZONTAL */
  #ProductMain-{{ section.id }} .product-gallery {
    flex-direction: column;
    width: 100%;
  }

  #ProductMain-{{ section.id }} .product-gallery__thumbs {
    flex-direction: row;
    justify-content: center;
    width: 100%;
  }

  #ProductMain-{{ section.id }} .product-gallery__thumbs .thumb-img,
  #ProductMain-{{ section.id }} .product-gallery__thumbs .thumb-img-placeholder {
    width: 76px;
    height: 76px;
  }

  /* REORDEN DE BLOQUES EN MÓVIL */
  #ProductMain-{{ section.id }} .product-mobile-order-gallery { order: 1; width: 100%; }
  #ProductMain-{{ section.id }} .product-mobile-order-title { order: 2; width: 100%; margin-top: 0.5rem; margin-bottom: 0.25rem; }
  #ProductMain-{{ section.id }} .product-mobile-order-buybox { order: 3; width: 100%; }
  #ProductMain-{{ section.id }} .product-mobile-order-descriptions { order: 4; width: 100%; margin-top: 0.5rem; }
  #ProductMain-{{ section.id }} .product-mobile-order-compare { order: 5; width: 100%; margin-top: 1.5rem; padding-right: 0; }
}
</style>

<script>
  function changeMainImg(src) {
    const mainImg = document.getElementById('MainProductImg');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('#ProductMain-{{ section.id }} .thumb-img').forEach(el => el.classList.remove('is-active'));
    if (window.event && window.event.target) {
      window.event.target.classList.add('is-active');
    }
  }

  function adjustQty(val) {
    const input = document.getElementById('QuantityInput');
    if (!input) return;
    let current = parseInt(input.value) || 1;
    current += val;
    if (current < 1) current = 1;
    input.value = current;
  }
</script>

{% schema %}
{
  "name": "Main Product Top",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Link Text",
      "default": "Back"
