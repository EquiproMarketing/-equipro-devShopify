      "label": "Custom Title Override"
    },
    {
      "type": "textarea",
      "id": "intro_highlight",
      "label": "Intro Highlight Line (Red Bar)"
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Main Description Override"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Red Subtitle (Middle)"
    },
    {
      "type": "richtext",
      "id": "secondary_description",
      "label": "Secondary Description Paragraph"
    },
    {
      "type": "header",
      "content": "Variant Options Display"
    },
    {
      "type": "checkbox",
      "id": "show_variant_selectors",
      "label": "Enable Variant Dropdowns",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_option",
      "label": "Show Color Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_option",
      "label": "Show Size/Talla Selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Product Target & Purchasing"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Link Specific Product"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Add to Cart Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "checkbox",
      "id": "show_compare_btn",
      "label": "Show Compare Button",
      "default": true
    },
    {
      "type": "text",
      "id": "compare_btn_label",
      "label": "Compare Button Text",
      "default": "Compare with other models"
    },
    {
      "type": "header",
      "content": "Characteristics & Specs Section"
    },
    {
      "type": "checkbox",
      "id": "show_characteristics",
      "label": "Show Lower Characteristics Section",
      "default": true
    },
    {
      "type": "text",
      "id": "characteristics_title",
      "label": "Characteristics Accordion Title",
      "default": "Characteristics"
    },
    {
      "type": "html",
      "id": "custom_specs_html",
      "label": "Technical Specifications HTML Table"
    },
    {
      "type": "header",
      "content": "Shipping Block"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_block",
      "label": "Show Shipping Block",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping Block Title",
      "default": "Shipping & Delivery"
    },
    {
      "type": "richtext",
      "id": "shipping_content",
      "label": "Shipping Block Content"
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    },
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Accordion Item Title",
          "default": "Features"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Accordion Item Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Product Top"
    }
  ]
}
{% endschema %}