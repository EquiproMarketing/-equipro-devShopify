{% doc %}
  Full catalog used only on /collections/all; curated profiles never filter this grid.
  @param {section} section - Existing catalog section labels and identity.
  @param {collection} collection - The visited all-products collection.
{% enddoc %}
{{ 'collection-products.css' | asset_url | stylesheet_tag }}
{{ 'find-your-setup.css' | asset_url | stylesheet_tag }}

<section class="collection-products page-width find-your-setup__catalog" data-full-catalog id="CollectionProducts-{{ section.id }}">
  <h2>{{ 'setup_filters.explore' | t }}</h2>
  <div class="collection-products__back">
    <a href="javascript:history.back()" class="back-link">
      <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 1L1 6L7 11" stroke="#a22938" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>{% if section.settings.back_text != blank %}{{ section.settings.back_text }}{% else %}{{ 'general.back' | t }}{% endif %}</span>
    </a>
  </div>

  {% paginate collection.products by 24 %}
  <div class="collection-products__grid">
    {% for product in collection.products %}
      <div class="custom-treatment-card">
        
        {% comment %} APPLE-STYLE ROUNDED IMAGE CONTAINER (4:5 ASPECT RATIO) {% endcomment %}
        <a href="{{ product.url }}" class="custom-treatment-card__image-container">
          {% if product.featured_image != blank %}
            <img 
              src="{{ product.featured_image | image_url: width: 600 }}" 
              alt="{{ product.featured_image.alt | escape }}" 
              class="custom-treatment-card__image custom-treatment-card__image--primary" 
              loading="lazy"
              width="240"
              height="300"
            >
            {% if product.images[1] != blank %}
              <img 
                src="{{ product.images[1] | image_url: width: 600 }}" 
                alt="{{ product.images[1].alt | escape }}" 
                class="custom-treatment-card__image custom-treatment-card__image--secondary" 
                loading="lazy"
                width="240"
                height="300"
              >
            {% endif %}
          {% else %}
            <div class="custom-treatment-card__placeholder"></div>
          {% endif %}
        </a>

        {% comment %} DYNAMIC COLOR SWATCHES FROM PRODUCT VARIANTS {% endcomment %}
        <div class="custom-treatment-card__swatches">
          {% assign color_option = nil %}
          {% for option in product.options_with_values %}
            {% assign normalized_option_name = option.name | downcase | strip %}
            {% if normalized_option_name == 'color' or normalized_option_name == 'colour' or normalized_option_name == 'couleur' %}
              {% assign color_option = option %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% if color_option != blank %}
            {% for value in color_option.values limit: 5 %}
              <span 
                class="custom-treatment-card__swatch-dot" 
                {% if value.swatch.color %}style="background-color: {{ value.swatch.color }};"{% elsif value.swatch.image %}style="background-image: url('{{ value.swatch.image | image_url: width: 80 }}');"{% endif %}
                title="{{ value.name | escape }}"
              ></span>
            {% endfor %}
          {% endif %}
        </div>

        {% comment %} CARD DETAILS AND TEXTS {% endcomment %}
        <div class="custom-treatment-card__content">
          <h3 class="custom-treatment-card__title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          
          <p class="custom-treatment-card__subtitle">
            {{ product.vendor | default: collection.title }}
          </p>

          {% if product.price_min > 0 %}
          <p class="custom-treatment-card__price">
            {% if product.price_varies %}
              {% assign formatted_lowest_price = product.price_min | money %}{{ 'products.product.from_lowest_price_html' | t: lowest_price: formatted_lowest_price }}
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </p>
          {% endif %}

          {% comment %} ACTION BUTTONS {% endcomment %}
          <div class="custom-treatment-card__actions">
            <a href="{{ product.url }}" class="custom-treatment-btn custom-treatment-btn--primary">
              {% if section.settings.btn_primary_text != blank %}{{ section.settings.btn_primary_text }}{% else %}{{ 'products.learn_more' | t }}{% endif %}
            </a>


          </div>
        </div>

      </div>
    {% else %}
      <p class="collection-products__empty">{{ 'collections.no_products' | t }}</p>
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}
    <nav class="collection-products__pagination" aria-label="{{ 'collections.pagination' | t }}">
      {{ paginate | default_pagination }}
    </nav>
  {% endif %}
  {% endpaginate %}
</section>

