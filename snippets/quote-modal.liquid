{% comment %}
  Snippet: snippets/quote-modal.liquid
  Dynamic B2B Quote Request Modal for Equipro Beauty
{% endcomment %}

{{ 'quote-modal.css' | asset_url | stylesheet_tag }}

<div id="QuoteModal" class="quote-modal" aria-hidden="true" role="dialog" aria-labelledby="QuoteModalTitle">
  <div class="quote-modal__overlay" data-close-quote-modal></div>
  <div class="quote-modal__content">
    <button type="button" class="quote-modal__close" data-close-quote-modal aria-label="Close modal">&times;</button>
    
    <div class="quote-modal__header">
      <h3 id="QuoteModalTitle" class="quote-modal__title">Request a B2B Quote</h3>
      <p class="quote-modal__subtitle">Please fill out the form below and our sales team will contact you shortly.</p>
    </div>

    {% form 'contact', id: 'QuoteForm', class: 'quote-modal__form' %}
      {% if form.posted_successfully? %}
        <div class="quote-modal__success">
          Thank you for your request! A representative will reach out to you soon.
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="quote-modal__error">
          Please check the highlighted fields and try submitting again.
        </div>
      {% endif %}

      <!-- Hidden inputs populated dynamically via JS -->
      <input type="hidden" id="QuoteProductTitle" name="contact[Requested_Product]" value="{{ product.title }}">
      <input type="hidden" id="QuoteProductVariant" name="contact[Variant]" value="{{ product.selected_or_first_available_variant.title }}">
      <input type="hidden" id="QuoteProductSKU" name="contact[SKU]" value="{{ product.selected_or_first_available_variant.sku }}">

      <!-- Visible product context -->
      <div class="quote-modal__product-preview">
        <span class="quote-modal__product-label">Product:</span>
        <strong id="QuoteProductDisplay">{{ product.title | default: "General Equipment Inquiry" }}</strong>
      </div>

      <div class="quote-modal__grid">
        <div class="quote-modal__field">
          <label for="QuoteName">Full Name *</label>
          <input type="text" id="QuoteName" name="contact[Name]" required placeholder="e.g. Dr. Jane Doe">
        </div>

        <div class="quote-modal__field">
          <label for="QuoteCompany">Company / Business Name *</label>
          <input type="text" id="QuoteCompany" name="contact[Company]" required placeholder="e.g. Montreal MedSpa Inc.">
        </div>
      </div>

      <div class="quote-modal__grid">
        <div class="quote-modal__field">
          <label for="QuoteEmail">Email Address *</label>
          <input type="email" id="QuoteEmail" name="contact[email]" required placeholder="contact@business.com">
        </div>

        <div class="quote-modal__field">
          <label for="QuotePhone">Phone Number *</label>
          <input type="tel" id="QuotePhone" name="contact[Phone]" required placeholder="+1 (514) 000-0000">
        </div>
      </div>

      <div class="quote-modal__field">
        <label for="QuoteQuantity">Estimated Units Needed</label>
        <input type="number" id="QuoteQuantity" name="contact[Quantity]" min="1" value="1">
      </div>

      <div class="quote-modal__field">
        <label for="QuoteMessage">Project Details / Special Requirements</label>
        <textarea id="QuoteMessage" name="contact[body]" rows="3" placeholder="Specify voltage, custom upholstery colors, or shipping requirements..."></textarea>
      </div>

      <button type="submit" class="quote-modal__submit button button--primary">Submit Request</button>
    {% endform %}
  </div>
</div>