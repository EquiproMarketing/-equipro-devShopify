{% doc %}
  Renders the reviewed family comparison pilot with live product identities.
  @param {product} target_product - Current product.
  @param {string} comparison_family - Reviewed family name.
{% enddoc %}
{{ 'equipro-comparison.css' | asset_url | stylesheet_tag }}
<script src="{{ 'equipro-comparison.js' | asset_url }}" defer></script>
<equipro-comparison data-family="{{ comparison_family }}" data-current="{{ target_product.id }}" data-source="{{ 'equipro-comparison-data.json' | asset_url }}">
  <button type="button" class="product-compare-trigger-btn" data-open aria-haspopup="dialog">{{ 'comparison.open' | t }}</button>
  <dialog aria-labelledby="ComparisonTitle-{{ target_product.id }}" aria-describedby="ComparisonHelp-{{ target_product.id }}">
    <div class="ec-header"><h2 id="ComparisonTitle-{{ target_product.id }}">{{ 'comparison.title' | t }}</h2><button type="button" data-close autofocus>{{ 'comparison.close' | t }}</button></div>
    <p id="ComparisonHelp-{{ target_product.id }}">{{ 'comparison.choose' | t }}</p>
    <div class="ec-selectors"></div>
    <label class="ec-differences"><input type="checkbox" data-differences> {{ 'comparison.differences' | t }}</label>
    <p data-status role="status" aria-live="polite"></p>
    <div class="ec-scroll" tabindex="0" role="region" aria-label="{{ 'comparison.specifications' | t }}"></div>
    <p class="ec-note">{{ 'comparison.note' | t }}</p><p class="ec-note">{{ 'comparison.source' | t }}</p>
  </dialog>
  <script type="application/json" data-labels>{"open":{{ 'comparison.open' | t | json }},"title":{{ 'comparison.title' | t | json }},"close":{{ 'comparison.close' | t | json }},"choose":{{ 'comparison.choose' | t | json }},"slot":{{ 'comparison.slot' | t | json }},"empty":{{ 'comparison.empty' | t | json }},"remove":{{ 'comparison.remove' | t | json }},"differences":{{ 'comparison.differences' | t | json }},"page":{{ 'comparison.page' | t | json }},"model":{{ 'comparison.model' | t | json }},"specifications":{{ 'comparison.specifications' | t | json }},"unknown":{{ 'comparison.unknown' | t | json }},"na":{{ 'comparison.na' | t | json }},"empty_state":{{ 'comparison.empty_state' | t | json }},"same":{{ 'comparison.same' | t | json }},"note":{{ 'comparison.note' | t | json }},"source":{{ 'comparison.source' | t | json }},"count":{{ 'comparison.count' | t | json }},"load_error":{{ 'comparison.load_error' | t | json }},"groups":{"fit_and_adjustment":{{ 'comparison.groups.fit_and_adjustment' | t | json }},"construction":{{ 'comparison.groups.construction' | t | json }},"coverage":{{ 'comparison.groups.coverage' | t | json }},"size_and_storage":{{ 'comparison.groups.size_and_storage' | t | json }},"fittings_and_mobility":{{ 'comparison.groups.fittings_and_mobility' | t | json }}},"labels":{"height":{{ 'comparison.labels.height' | t | json }},"mechanism":{{ 'comparison.labels.mechanism' | t | json }},"seat":{{ 'comparison.labels.seat' | t | json }},"seat_dimensions":{{ 'comparison.labels.seat_dimensions' | t | json }},"backrest":{{ 'comparison.labels.backrest' | t | json }},"base":{{ 'comparison.labels.base' | t | json }},"casters":{{ 'comparison.labels.casters' | t | json }},"upholstery":{{ 'comparison.labels.upholstery' | t | json }},"warranty":{{ 'comparison.labels.warranty' | t | json }},"dimensions":{{ 'comparison.labels.dimensions' | t | json }},"shelves":{{ 'comparison.labels.shelves' | t | json }},"shelf_dimensions":{{ 'comparison.labels.shelf_dimensions' | t | json }},"spacing":{{ 'comparison.labels.spacing' | t | json }},"drawers":{{ 'comparison.labels.drawers' | t | json }},"cabinet":{{ 'comparison.labels.cabinet' | t | json }},"holders":{{ 'comparison.labels.holders' | t | json }},"outlets":{{ 'comparison.labels.outlets' | t | json }}}}</script>
  <script type="application/json" data-products>[
    {%- assign handles = '31100-air-lift-round-stool|round-air-lift-stool-with-backrest-31200|skincare-equipment-stools-ergonomic-stool-with-backrest-31300|ergonomic-stool-with-adjustable-backrest-31301|round-air-lift-stool-ei-311|ei-312-round-air-lift-stool|home-skincare-equipment-accessories-tm-3-professional-service-table|51104-tm-3a|51103-tm-3-mini|ts-3-deluxe|51201-ts-2-with-drawer|51300-ta-2-standard|uphusvw9gfbqf087wzw6s53rzz7zn5|51000-ts-4' | split: '|' -%}
    {%- assign separator = '' -%}
    {%- for handle in handles -%}
      {%- assign candidate = all_products[handle] -%}
      {%- capture candidate_family -%}{%- render 'comparison-family', target_product: candidate -%}{%- endcapture -%}
      {%- if candidate != blank and candidate_family == comparison_family -%}
        {{ separator }}{"id":{{ candidate.id | append: '' | json }},"title":{{ candidate.title | json }},"url":{{ candidate.url | json }},"image":{% if candidate.featured_image %}{{ candidate.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}}
        {%- assign separator = ',' -%}
      {%- endif -%}
    {%- endfor -%}
  ]</script>
</equipro-comparison>
