    ,"14 × 23 in":{{ "comparison.values.v_000eec8ac4" | t | json }}
    ,"14 × 25 × 33.5 in":{{ "comparison.values.v_b529c3e5bd" | t | json }}
    ,"15 × 25.5 × 54.5 in":{{ "comparison.values.v_4662aec8ac" | t | json }}
    ,"2":{{ "comparison.values.v_da4b9237ba" | t | json }}
    ,"2 doors; interior: 13 × 21.5 × 11 in high":{{ "comparison.values.v_6abba8ce84" | t | json }}
    ,"2 years":{{ "comparison.values.v_a4a3cd6c43" | t | json }}
